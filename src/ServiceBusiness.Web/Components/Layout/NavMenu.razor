@using ServiceBusiness.Application
@using ServiceBusiness.Domain
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using ServiceBusiness.Web
@implements IDisposable
@inject OnboardingService OnboardingService
@inject ICurrentUserContext CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ServiceBusiness.Web.ApplicationModeService ApplicationMode

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@appMode.ProductName</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="if (event.target.closest('a.nav-link')) document.querySelector('.navbar-toggler').checked = false">
    <nav class="nav flex-column">
        @if (!isAuthenticated || IsPendingApprovalOnly)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </NavLink>
            </div>
        }

        @if (isAuthenticated && !IsPendingApprovalOnly)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="dashboard">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Dashboard
                </NavLink>
            </div>

            @if (isSystemAdmin)
            {
                <button class="nav-section-toggle px-3" type="button" @onclick="ToggleSystemAdministrator" @onclick:stopPropagation="true" aria-expanded="@systemAdministratorExpanded">
                    <span>@(systemAdministratorExpanded ? "v" : ">")</span> System Administrator
                </button>
                @if (systemAdministratorExpanded)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link nested" href="admin/delete-user">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Delete User
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link nested" href="admin/roles">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> User Roles
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link nested" href="admin/subscriptions">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Subscriptions
                        </NavLink>
                    </div>
                    @if (appMode.IsPoolMode)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="admin/catalog/poolequipment">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Pool Equipment
                            </NavLink>
                        </div>
                    }
                }
            }

            @if (ShowSettingsSection)
            {
                <button class="nav-section-toggle px-3" type="button" @onclick="ToggleSettings" @onclick:stopPropagation="true" aria-expanded="@settingsExpanded">
                    <span>@(settingsExpanded ? "v" : ">")</span> Settings
                </button>
                @if (settingsExpanded)
                {
                    @if (isSystemAdmin)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="settings">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> System Settings
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="admin/service-clients">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Service Clients
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="admin/clients">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Business Clients
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="admin/users">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Users
                            </NavLink>
                        </div>
                    }

                    @if (HasRole(CompanyRole.CompanyAdmin))
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="clients">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Business Clients
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="company/users">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Company Users
                            </NavLink>
                        </div>
                    }

                    @if (isSystemAdmin || HasRole(CompanyRole.CompanyAdmin))
                    {
                        @if (isSystemAdmin)
                        {
                            @if (appMode.IsPoolMode)
                            {
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link nested" href="poolequipment">
                                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Pool Configuration
                                    </NavLink>
                                </div>
                            }
                            <div class="nav-item px-3">
                                <NavLink class="nav-link nested" href="admin/catalog/materials">
                                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Materials
                                </NavLink>
                            </div>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link nested" href="admin/catalog/services">
                                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Services
                                </NavLink>
                            </div>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link nested" href="admin/catalog/servicepackages">
                                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Service Packages
                                </NavLink>
                            </div>
                        }
                        else
                        {
                            @if (appMode.IsPoolMode)
                            {
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link nested" href="poolequipment">
                                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Pool Configuration
                                    </NavLink>
                                </div>
                            }
                            <div class="nav-item px-3">
                                <NavLink class="nav-link nested" href="catalog/materials">
                                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Materials
                                </NavLink>
                            </div>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link nested" href="catalog/services">
                                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Services
                                </NavLink>
                            </div>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link nested" href="catalog/servicepackages">
                                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Service Packages
                                </NavLink>
                            </div>
                        }
                    }

                    @if (appMode.IsPoolMode && isIndependentHomeOwner)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="poolequipment">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Pool Configuration
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="settings/services">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Services
                            </NavLink>
                        </div>
                    }
                }
            }

            @if (ShowVisitSchedulingSection)
            {
                <button class="nav-section-toggle px-3" type="button" @onclick="ToggleVisitScheduling" @onclick:stopPropagation="true" aria-expanded="@visitSchedulingExpanded">
                    <span>@(visitSchedulingExpanded ? "v" : ">")</span> Visit Scheduling
                </button>
                @if (visitSchedulingExpanded)
                {
                    @if (isSystemAdmin)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="admin/visits">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Visits
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="admin/invoices">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Invoices
                            </NavLink>
                        </div>
                    }
                    @if (HasRole(CompanyRole.CompanyAdmin))
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="visits">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Visits
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="invoices">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Invoices
                            </NavLink>
                        </div>
                    }
                    @if (HasRole(CompanyRole.CompanyUser))
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="field">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Assigned Visits
                            </NavLink>
                        </div>
                    }
                    @if (HasRole(CompanyRole.CompanyClientUser))
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="invoices">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Invoices
                            </NavLink>
                        </div>
                    }
                }
            }

            <button class="nav-section-toggle px-3" type="button" @onclick="ToggleReports" @onclick:stopPropagation="true" aria-expanded="@reportsExpanded">
                <span>@(reportsExpanded ? "v" : ">")</span> Reports
            </button>
            @if (reportsExpanded)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link nested" href="reports">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Reports
                    </NavLink>
                </div>
            }

            @if (ShowLogsSection)
            {
                <button class="nav-section-toggle px-3" type="button" @onclick="ToggleLog" @onclick:stopPropagation="true" aria-expanded="@logExpanded">
                    <span>@(logExpanded ? "v" : ">")</span> Logs
                </button>
                @if (logExpanded)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link nested" href="@(isSystemAdmin ? "admin/email-log" : "logs/email")">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Email Log
                        </NavLink>
                    </div>
                    @if (isSystemAdmin)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="admin/payment-events">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Payment Events
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nested" href="admin/payment-api">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Payment API
                            </NavLink>
                        </div>
                    }
                }
            }
        }

        <button class="nav-section-toggle px-3" type="button" @onclick="ToggleHelp" @onclick:stopPropagation="true" aria-expanded="@helpExpanded">
            <span>@(helpExpanded ? "v" : ">")</span> Help
        </button>
        @if (helpExpanded)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link nested" href="help/getting-started">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Getting Started
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link nested" href="help/user-guide">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> User Guide
                </NavLink>
            </div>
        }

        @if (appMode.DevTest && !IsPendingApprovalOnly)
        {
            <button class="nav-section-toggle px-3" type="button" @onclick="ToggleTest" @onclick:stopPropagation="true" aria-expanded="@testExpanded">
                <span>@(testExpanded ? "v" : ">")</span> Test
            </button>
            @if (testExpanded)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link nested" href="test">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Test Page
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link nested" href="test/users">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Test Users
                    </NavLink>
                </div>
            }
        }
    </nav>
</div>

@code {
    private IReadOnlyList<CompanyAccess> allAccess = [];
    private IReadOnlyList<CompanyAccess> activeAccess = [];
    private bool isAuthenticated;
    private bool isSystemAdmin;
    private bool isIndependentHomeOwner;
    private bool settingsExpanded = true;
    private bool visitSchedulingExpanded = true;
    private bool systemAdministratorExpanded = true;
    private bool logExpanded = true;
    private bool reportsExpanded = true;
    private bool helpExpanded = true;
    private bool testExpanded;
    private ServiceBusiness.Web.ApplicationModeSnapshot appMode = ServiceBusiness.Web.ApplicationModeSnapshot.Pool;

    protected override async Task OnInitializedAsync()
    {
        appMode = await ApplicationMode.GetCurrentAsync();
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        await LoadMenuStateAsync(await AuthenticationStateProvider.GetAuthenticationStateAsync());
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        try
        {
            var authenticationState = await authenticationStateTask;
            await InvokeAsync(async () =>
            {
                await LoadMenuStateAsync(authenticationState);
                StateHasChanged();
            });
        }
        catch
        {
            await InvokeAsync(() =>
            {
                ResetMenuState();
                StateHasChanged();
            });
        }
    }

    private async Task LoadMenuStateAsync(AuthenticationState authenticationState)
    {
        ResetMenuState();
        isAuthenticated = authenticationState.User.Identity?.IsAuthenticated == true;
        if (!isAuthenticated)
        {
            return;
        }

        var userId = authenticationState.User.FindFirstValue(ServiceBusinessClaimTypes.AppUserId)
            ?? CurrentUser.UserId;
        var overview = await OnboardingService.GetAccessOverviewAsync(userId);
        isSystemAdmin = overview.User.IsSystemAdmin;
        allAccess = overview.Companies;
        activeAccess = overview.Companies
            .Where(c => c.Status == MembershipStatus.Active)
            .ToList();
        isIndependentHomeOwner = !isSystemAdmin && overview.Companies.Count == 0;
    }

    private void ResetMenuState()
    {
        allAccess = [];
        activeAccess = [];
        isAuthenticated = false;
        isSystemAdmin = false;
        isIndependentHomeOwner = false;
        systemAdministratorExpanded = true;
        settingsExpanded = true;
        visitSchedulingExpanded = true;
        logExpanded = true;
        reportsExpanded = true;
        helpExpanded = true;
        testExpanded = false;
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private bool HasRole(CompanyRole role) => activeAccess.Any(a => a.Role == role);

    private bool IsPendingApprovalOnly =>
        isAuthenticated &&
        !isSystemAdmin &&
        !isIndependentHomeOwner &&
        activeAccess.Count == 0 &&
        allAccess.Any(a => a.Status == MembershipStatus.Pending);

    private bool ShowSettingsSection =>
        isSystemAdmin ||
        HasRole(CompanyRole.CompanyAdmin) ||
        isIndependentHomeOwner;

    private bool ShowVisitSchedulingSection =>
        isSystemAdmin ||
        HasRole(CompanyRole.CompanyAdmin) ||
        HasRole(CompanyRole.CompanyUser) ||
        HasRole(CompanyRole.CompanyClientUser);

    private bool ShowLogsSection =>
        isSystemAdmin ||
        HasRole(CompanyRole.CompanyAdmin) ||
        HasRole(CompanyRole.CompanyClientUser) ||
        isIndependentHomeOwner;

    private void ToggleSettings() => settingsExpanded = !settingsExpanded;

    private void ToggleVisitScheduling() => visitSchedulingExpanded = !visitSchedulingExpanded;

    private void ToggleSystemAdministrator() => systemAdministratorExpanded = !systemAdministratorExpanded;

    private void ToggleLog() => logExpanded = !logExpanded;

    private void ToggleReports() => reportsExpanded = !reportsExpanded;

    private void ToggleHelp() => helpExpanded = !helpExpanded;

    private void ToggleTest() => testExpanded = !testExpanded;
}
