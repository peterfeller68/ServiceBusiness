@inherits LayoutComponentBase
@using ServiceBusiness.Application
@using ServiceBusiness.Domain
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using ServiceBusiness.Web
@implements IDisposable
@inject OnboardingService OnboardingService
@inject ICurrentUserContext CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ServiceBusiness.Web.ApplicationModeService ApplicationMode

<div class="page">
    <div class="sidebar">
        <NavMenu @rendermode="InteractiveServer" />
    </div>

    <main>
        <div class="top-row px-4">
            <span>@appMode.ProductName Azure-ready Blazor SaaS MVP</span>
            <div class="profile-chip">
                @if (currentUser is not null)
                {
                    <a class="profile-link" href="profile" title="Open account profile">
                        <span>@currentUser.DisplayName</span>
                        <small>@currentRoleLabel</small>
                    </a>
                }
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private ServiceBusiness.Domain.AppUser? currentUser;
    private string currentRoleLabel = "";
    private ServiceBusiness.Web.ApplicationModeSnapshot appMode = ServiceBusiness.Web.ApplicationModeSnapshot.Pool;

    protected override async Task OnInitializedAsync()
    {
        appMode = await ApplicationMode.GetCurrentAsync();
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        await LoadUserStateAsync(await AuthenticationStateProvider.GetAuthenticationStateAsync());
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        try
        {
            var authenticationState = await authenticationStateTask;
            await InvokeAsync(async () =>
            {
                await LoadUserStateAsync(authenticationState);
                StateHasChanged();
            });
        }
        catch
        {
            await InvokeAsync(() =>
            {
                ResetUserState();
                StateHasChanged();
            });
        }
    }

    private async Task LoadUserStateAsync(AuthenticationState authenticationState)
    {
        ResetUserState();
        if (authenticationState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var userId = authenticationState.User.FindFirstValue(ServiceBusinessClaimTypes.AppUserId)
            ?? CurrentUser.UserId;
        var overview = await OnboardingService.GetAccessOverviewAsync(userId);
        currentUser = overview.User;
        currentRoleLabel = GetRoleLabel(overview);
    }

    private void ResetUserState()
    {
        currentUser = null;
        currentRoleLabel = "";
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private static string GetRoleLabel(UserAccessOverview overview)
    {
        if (overview.User.IsSystemAdmin)
        {
            return "System Administrator";
        }

        var activeRoles = overview.Companies
            .Where(access => access.Status == MembershipStatus.Active)
            .Select(access => access.Role)
            .Distinct()
            .ToList();

        if (activeRoles.Count > 0)
        {
            return string.Join(", ", activeRoles.Select(GetRoleDisplayName));
        }

        if (overview.Companies.Any(access => access.Status == MembershipStatus.Pending))
        {
            return "Pending Approval";
        }

        return "Independent Home Owner";
    }

    private static string GetRoleDisplayName(CompanyRole role) => role switch
    {
        CompanyRole.CompanyAdmin => "Company Admin",
        CompanyRole.CompanyUser => "Company User",
        CompanyRole.CompanyClientUser => "Business Client",
        _ => role.ToString()
    };
}
