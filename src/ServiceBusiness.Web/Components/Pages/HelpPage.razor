@page "/help"

<PageTitle>Help</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Help</p>
        <h1>Service Business support</h1>
        <p class="lede">Find your next step based on the account and role you use to access the application.</p>
    </div>
</section>

<section class="section">
    <div class="data-list">
        <article class="row-card">
            <div>
                <strong>Getting started</strong>
                <p>Register as a business owner, business user, business client, or independent homeowner, then complete the Google sign-in or test-user sign-in flow.</p>
            </div>
        </article>
        <article class="row-card">
            <div>
                <strong>Access approvals</strong>
                <p>Business users and business clients remain pending until a business owner approves their access request.</p>
            </div>
        </article>
        <article class="row-card">
            <div>
                <strong>Profile and logout</strong>
                <p>Use the profile link in the top-right corner to update contact details or log out.</p>
            </div>
        </article>
    </div>
</section>
