@page "/help"
@page "/help/getting-started"
@page "/help/user-guide"
@page "/help/user-guide/{GuideSlug}"
@inject NavigationManager Navigation
@inject ServiceBusiness.Web.UserGuideContentService UserGuideContent

<PageTitle>Help</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Help</p>
        <h1>@article.Title</h1>
        <p class="lede">Browse current user documentation generated as part of the development cycle.</p>
    </div>
    <div class="page-actions">
        <a class="button" href="help/getting-started">Getting Started</a>
        <a class="button" href="help/user-guide">User Guide</a>
    </div>
</section>

<section class="section">
    <article class="user-guide-document">
        @article.Html
    </article>
</section>

@code {
    [Parameter]
    public string? GuideSlug { get; set; }

    private ServiceBusiness.Web.UserGuideArticle article = new(
        "Help",
        "index",
        new MarkupString("<p>Loading help...</p>"));

    protected override void OnParametersSet()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        var slug = relativePath.Equals("help/getting-started", StringComparison.OrdinalIgnoreCase)
            ? "getting-started"
            : relativePath.StartsWith("help/user-guide", StringComparison.OrdinalIgnoreCase)
                ? GuideSlug ?? "index"
                : "index";

        article = UserGuideContent.GetArticle(slug);
    }
}
