@page "/settings"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using ServiceBusiness.Domain
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ServiceBusiness.Application.ICurrentUserContext CurrentUser
@inject ServiceBusiness.Application.OnboardingService OnboardingService
@inject ServiceBusiness.Web.ApplicationModeService ApplicationMode
@inject IConfiguration Configuration

<PageTitle>Settings</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Settings</p>
        <h1>General settings</h1>
        <p class="lede">Role-specific configuration tools will appear here as the settings editors are expanded.</p>
    </div>
</section>

<section class="section">
    <div class="form-panel">
        <h2>Available Settings</h2>
        <p class="form-note">Use the Settings menu to open the areas currently available for your role.</p>
    </div>
</section>

@if (isSystemAdmin)
{
    <section class="section">
        <div class="form-panel">
            <h2>System Settings</h2>
            <p class="form-note">System settings are configured through appsettings.json or Azure App Service environment variables so each deployed Web App can run in its own mode while sharing the same storage account.</p>
            <div class="metric-grid">
                <div class="metric">
                    <span>SystemMode</span>
                    <strong>@configuredSettings.SystemMode</strong>
                </div>
                <div class="metric">
                    <span>DevTest</span>
                    <strong>@configuredSettings.DevTest</strong>
                </div>
                <div class="metric">
                    <span>Product</span>
                    <strong>@appMode.ProductName</strong>
                </div>
            </div>
            <div class="data-list">
                <article class="row-card">
                    <div>
                        <strong>Azure App Service settings</strong>
                        <p>Set SystemSettings__SystemMode to Pool or Landscape. Set SystemSettings__DevTest to true only when seeded test-user sign-in should be enabled.</p>
                    </div>
                </article>
            </div>
        </div>
    </section>
}

@code {
    private bool isSystemAdmin;
    private SystemSettings configuredSettings = new(SystemMode.Pool);
    private ServiceBusiness.Web.ApplicationModeSnapshot appMode = ServiceBusiness.Web.ApplicationModeSnapshot.Pool;

    protected override async Task OnInitializedAsync()
    {
        configuredSettings = SystemSettingsConfiguration.GetConfiguredDefaults(Configuration);
        appMode = await ApplicationMode.GetCurrentAsync();
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authenticationState.User.Identity?.IsAuthenticated == true)
        {
            var overview = await OnboardingService.GetAccessOverviewAsync(CurrentUser.UserId);
            isSystemAdmin = overview.User.IsSystemAdmin;
        }
    }
}
