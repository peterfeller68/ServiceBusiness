@page "/settings"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using ServiceBusiness.Domain
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ServiceBusiness.Application.ICurrentUserContext CurrentUser
@inject ServiceBusiness.Application.OnboardingService OnboardingService
@inject ServiceBusiness.Application.PlatformAdminService PlatformAdminService
@inject ServiceBusiness.Web.ApplicationModeService ApplicationMode

<PageTitle>System Settings</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Settings</p>
        <h1>System Settings</h1>
        <p class="lede">Manage persisted application settings used by onboarding and system behavior.</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice error">@errorMessage</div>
}

@if (!isSystemAdmin)
{
    <div class="notice error">System administrator access is required.</div>
}
else if (settingsForm is null)
{
    <p>Loading settings...</p>
}
else
{
    <EditForm Model="settingsForm" OnValidSubmit="SaveAsync" FormName="system-settings-form">
        <section class="form-panel">
            <h2>System Settings</h2>
            <div class="form-grid">
                <label>
                    System mode
                    <InputSelect class="form-control" @bind-Value="settingsForm.SystemMode">
                        <option value="@SystemMode.Pool">Pool</option>
                        <option value="@SystemMode.Landscape">Landscape</option>
                    </InputSelect>
                </label>
                <label>
                    Homeowner trial days
                    <InputNumber class="form-control" @bind-Value="settingsForm.HomeOwnerTrialDays" />
                </label>
                <label class="check-row">
                    <InputCheckbox @bind-Value="settingsForm.DevTest" />
                    <span>DevTest</span>
                </label>
            </div>
            <div class="metric-grid">
                <div class="metric">
                    <span>Product</span>
                    <strong>@appMode.ProductName</strong>
                </div>
                <div class="metric">
                    <span>Trial Days</span>
                    <strong>@settingsForm.HomeOwnerTrialDays</strong>
                </div>
            </div>
            <div class="form-actions">
                <button class="button primary" type="submit">Save Settings</button>
            </div>
        </section>
    </EditForm>
}

@code {
    private bool isSystemAdmin;
    private SettingsForm? settingsForm;
    private ServiceBusiness.Web.ApplicationModeSnapshot appMode = ServiceBusiness.Web.ApplicationModeSnapshot.Pool;
    private string? message;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        appMode = await ApplicationMode.GetCurrentAsync();
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authenticationState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var overview = await OnboardingService.GetAccessOverviewAsync(CurrentUser.UserId);
        isSystemAdmin = overview.User.IsSystemAdmin;
        if (isSystemAdmin)
        {
            var settings = await PlatformAdminService.GetSystemSettingsAsync();
            settingsForm = SettingsForm.FromSettings(settings);
        }
    }

    private async Task SaveAsync()
    {
        if (settingsForm is null)
        {
            return;
        }

        message = null;
        errorMessage = null;

        try
        {
            var saved = await PlatformAdminService.UpdateSystemSettingsAsync(new SystemSettings(
                settingsForm.SystemMode,
                settingsForm.DevTest,
                settingsForm.HomeOwnerTrialDays));
            settingsForm = SettingsForm.FromSettings(saved);
            appMode = ServiceBusiness.Web.ApplicationModeSnapshot.From(saved);
            message = "System settings saved.";
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed class SettingsForm
    {
        public SystemMode SystemMode { get; set; } = SystemMode.Pool;
        public bool DevTest { get; set; }
        public int HomeOwnerTrialDays { get; set; } = 14;

        public static SettingsForm FromSettings(SystemSettings settings) => new()
        {
            SystemMode = settings.SystemMode,
            DevTest = settings.DevTest,
            HomeOwnerTrialDays = settings.HomeOwnerTrialDays
        };
    }
}
