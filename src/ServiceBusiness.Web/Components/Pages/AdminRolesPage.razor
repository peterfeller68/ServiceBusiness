@page "/admin/roles"
@rendermode InteractiveServer
@using ServiceBusiness.Domain
@inject ServiceBusiness.Application.PlatformAdminService PlatformAdminService
@inject ServiceBusiness.Web.DemoCurrentUserContext DemoUser

<PageTitle>Roles</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">System Administrator</p>
        <h1>Roles</h1>
        <p class="lede">Manage built-in role metadata, approval requirements, and permissions.</p>
    </div>
    <a class="button" href="admin">Dashboard</a>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice error">@errorMessage</div>
}

@if (roleForms is null)
{
    <p>Loading roles...</p>
}
else
{
    <section class="section">
        <h2>Roles</h2>
        <div class="data-list">
            @foreach (var role in roleForms)
            {
                <article class="form-panel">
                    <EditForm Model="role" OnValidSubmit="() => SaveRoleAsync(role)" FormName="@($"admin-role-{role.Role}")">
                        <div class="role-form-grid">
                            <label>
                                Role
                                <input class="form-control" value="@role.Role" disabled />
                            </label>
                            <label>
                                Display name
                                <InputText class="form-control" @bind-Value="role.DisplayName" />
                            </label>
                            <label class="wide">
                                Description
                                <InputTextArea class="form-control" @bind-Value="role.Description" />
                            </label>
                            <label class="wide">
                                Permissions
                                <InputTextArea class="form-control permission-list" @bind-Value="role.PermissionsText" />
                            </label>
                            <label class="check-row">
                                <InputCheckbox @bind-Value="role.RequiresOwnerApproval" />
                                <span>Requires owner approval</span>
                            </label>
                        </div>
                        <div class="form-actions">
                            <button class="button primary" type="submit">Save Role</button>
                        </div>
                    </EditForm>
                </article>
            }
        </div>
    </section>
}

@code {
    private List<RoleForm>? roleForms;
    private string? message;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        DemoUser.UserId = "sys-admin";
        await LoadAsync();
    }

    private async Task SaveRoleAsync(RoleForm role)
    {
        message = null;
        errorMessage = null;

        try
        {
            await PlatformAdminService.UpdateRoleDefinitionAsync(new RoleDefinition(
                role.Role,
                role.DisplayName,
                role.Description,
                role.RequiresOwnerApproval,
                role.Permissions));
            message = $"{role.DisplayName} role was saved.";
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadAsync()
    {
        roleForms = (await PlatformAdminService.GetRoleDefinitionsAsync())
            .Select(RoleForm.FromRole)
            .ToList();
    }

    private sealed class RoleForm
    {
        public CompanyRole Role { get; init; }
        public string DisplayName { get; set; } = "";
        public string Description { get; set; } = "";
        public bool RequiresOwnerApproval { get; set; }
        public string PermissionsText { get; set; } = "";

        public IReadOnlyList<string> Permissions =>
            PermissionsText
                .Split(["\r\n", "\n", ","], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();

        public static RoleForm FromRole(RoleDefinition role) => new()
        {
            Role = role.Role,
            DisplayName = role.DisplayName,
            Description = role.Description,
            RequiresOwnerApproval = role.RequiresOwnerApproval,
            PermissionsText = string.Join(Environment.NewLine, role.Permissions ?? [])
        };
    }
}
