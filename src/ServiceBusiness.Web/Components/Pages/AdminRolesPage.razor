@page "/admin/roles"
@rendermode InteractiveServer
@using ServiceBusiness.Domain
@inject ServiceBusiness.Application.PlatformAdminService PlatformAdminService
@inject ServiceBusiness.Web.DemoCurrentUserContext DemoUser

<PageTitle>Roles</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">System Administrator</p>
        <h1>Roles</h1>
        <p class="lede">Manage built-in role metadata, approval requirements, and permissions.</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice error">@errorMessage</div>
}

@if (roleForms is null)
{
    <p>Loading roles...</p>
}
else
{
    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Roles</h2>
            <button class="icon-button" type="button" title="Toggle roles" @onclick="ToggleRoles">@(rolesExpanded ? "^" : "v")</button>
        </div>
        @if (rolesExpanded)
        {
            <div class="management-panel-body">
                @if (roleEditorExpanded && selectedRole is not null)
                {
                    <EditForm Model="selectedRole" OnValidSubmit="() => SaveRoleAsync(selectedRole)" FormName="@($"admin-role-{selectedRole.Role}")">
                        <div class="editor-panel">
                            <h3>Edit Role</h3>
                            <div class="role-form-grid">
                                <label>
                                    Role
                                    <input class="form-control" value="@selectedRole.Role" disabled />
                                </label>
                                <label>
                                    Display name
                                    <InputText class="form-control" @bind-Value="selectedRole.DisplayName" />
                                </label>
                                <label class="wide">
                                    Description
                                    <InputTextArea class="form-control" @bind-Value="selectedRole.Description" />
                                </label>
                                <label class="wide">
                                    Permissions
                                    <InputTextArea class="form-control permission-list" @bind-Value="selectedRole.PermissionsText" />
                                </label>
                                <label class="check-row">
                                    <InputCheckbox @bind-Value="selectedRole.RequiresOwnerApproval" />
                                    <span>Requires owner approval</span>
                                </label>
                            </div>
                            <div class="form-actions">
                                <button class="button primary" type="submit">Save Role</button>
                                <button class="button" type="button" @onclick="HideRoleEditor">Cancel</button>
                            </div>
                        </div>
                    </EditForm>
                }
                <div class="management-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Owner Approval</th>
                                <th>Permissions</th>
                                <th class="actions">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in roleForms)
                            {
                                <tr>
                                    <td>@role.Role</td>
                                    <td>@role.DisplayName</td>
                                    <td>@role.Description</td>
                                    <td>@(role.RequiresOwnerApproval ? "Yes" : "No")</td>
                                    <td>@role.Permissions.Count</td>
                                    <td class="actions">
                                        <button class="icon-button" type="button" title="Edit role" @onclick="() => EditRole(role)">Edit</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
}

@code {
    private List<RoleForm>? roleForms;
    private RoleForm? selectedRole;
    private bool rolesExpanded = true;
    private bool roleEditorExpanded;
    private string? message;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        DemoUser.UserId = "sys-admin";
        await LoadAsync();
    }

    private async Task SaveRoleAsync(RoleForm role)
    {
        message = null;
        errorMessage = null;

        try
        {
            await PlatformAdminService.UpdateRoleDefinitionAsync(new RoleDefinition(
                role.Role,
                role.DisplayName,
                role.Description,
                role.RequiresOwnerApproval,
                role.Permissions));
            message = $"{role.DisplayName} role was saved.";
            await LoadAsync();
            HideRoleEditor();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadAsync()
    {
        roleForms = (await PlatformAdminService.GetRoleDefinitionsAsync())
            .Select(RoleForm.FromRole)
            .ToList();
    }

    private void EditRole(RoleForm role)
    {
        selectedRole = role.Clone();
        roleEditorExpanded = true;
        rolesExpanded = true;
    }

    private void HideRoleEditor()
    {
        selectedRole = null;
        roleEditorExpanded = false;
    }

    private sealed class RoleForm
    {
        public CompanyRole Role { get; init; }
        public string DisplayName { get; set; } = "";
        public string Description { get; set; } = "";
        public bool RequiresOwnerApproval { get; set; }
        public string PermissionsText { get; set; } = "";

        public IReadOnlyList<string> Permissions =>
            PermissionsText
                .Split(["\r\n", "\n", ","], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();

        public static RoleForm FromRole(RoleDefinition role) => new()
        {
            Role = role.Role,
            DisplayName = role.DisplayName,
            Description = role.Description,
            RequiresOwnerApproval = role.RequiresOwnerApproval,
            PermissionsText = string.Join(Environment.NewLine, role.Permissions ?? [])
        };

        public RoleForm Clone() => new()
        {
            Role = Role,
            DisplayName = DisplayName,
            Description = Description,
            RequiresOwnerApproval = RequiresOwnerApproval,
            PermissionsText = PermissionsText
        };
    }

    private void ToggleRoles() => rolesExpanded = !rolesExpanded;
}
