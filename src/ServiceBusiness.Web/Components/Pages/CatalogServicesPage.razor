@page "/catalog/services"
@page "/admin/catalog/services"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using ServiceBusiness.Domain
@inject ServiceBusiness.Application.CompanyAdminService CompanyAdminService
@inject ServiceBusiness.Web.DemoCurrentUserContext DemoUser
@inject NavigationManager Navigation

<PageTitle>Services</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">@PageScope</p>
        <h1>Services</h1>
        <p class="lede">Create, edit, archive, and reactivate service categories and service items.</p>
    </div>
    <a class="button" href="catalog">Catalog Overview</a>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice error">@errorMessage</div>
}

@if (catalog is null)
{
    <p>Loading services...</p>
}
else
{
    <section class="section split">
        <EditForm Model="categoryForm" OnValidSubmit="SaveCategoryAsync" FormName="service-category-editor">
            <div class="form-panel">
                <h2>@(categoryForm.IsEditing ? "Edit Category" : "Create Category")</h2>
                <label>
                    Category ID
                    <InputText class="form-control" @bind-Value="categoryForm.Id" disabled="@categoryForm.IsEditing" />
                </label>
                <label>
                    Name
                    <InputText class="form-control" @bind-Value="categoryForm.Name" />
                </label>
                <label>
                    Description
                    <InputTextArea class="form-control" @bind-Value="categoryForm.Description" />
                </label>
                <label class="check-row">
                    <InputCheckbox @bind-Value="categoryForm.IsActive" />
                    <span>Active</span>
                </label>
                <div class="form-actions">
                    <button class="button primary" type="submit">Save Category</button>
                    <button class="button" type="button" @onclick="ResetCategoryForm">New Category</button>
                </div>
            </div>
        </EditForm>

        <EditForm Model="serviceForm" OnValidSubmit="SaveServiceAsync" FormName="service-item-editor">
            <div class="form-panel">
                <h2>@(serviceForm.IsEditing ? "Edit Service" : "Create Service")</h2>
                <div class="form-grid">
                    <label>
                        Service ID
                        <InputText class="form-control" @bind-Value="serviceForm.Id" disabled="@serviceForm.IsEditing" />
                    </label>
                    <label>
                        Category
                        <InputSelect class="form-control" @bind-Value="serviceForm.CategoryId">
                            <option value="">Uncategorized</option>
                            @foreach (var category in ServiceCategories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        Name
                        <InputText class="form-control" @bind-Value="serviceForm.Name" />
                    </label>
                    <label>
                        Duration minutes
                        <InputNumber class="form-control" @bind-Value="serviceForm.DefaultDurationMinutes" />
                    </label>
                    <label>
                        Default price
                        <InputNumber class="form-control" @bind-Value="serviceForm.DefaultPrice" />
                    </label>
                    <label class="wide">
                        Description
                        <InputTextArea class="form-control" @bind-Value="serviceForm.Description" />
                    </label>
                    <label class="check-row">
                        <InputCheckbox @bind-Value="serviceForm.IsTaxable" />
                        <span>Taxable</span>
                    </label>
                    <label class="check-row">
                        <InputCheckbox @bind-Value="serviceForm.IsActive" />
                        <span>Active</span>
                    </label>
                </div>
                <div class="form-actions">
                    <button class="button primary" type="submit">Save Service</button>
                    <button class="button" type="button" @onclick="ResetServiceForm">New Service</button>
                </div>
            </div>
        </EditForm>
    </section>

    <section class="section">
        <h2>Service Categories</h2>
        <div class="category-grid">
            @foreach (var group in catalog.ServiceGroups)
            {
                <article class="form-panel">
                    <div class="category-heading">
                        <div>
                            <strong>@group.Category.Name</strong>
                            <p>@group.Category.Description</p>
                        </div>
                        <div class="row-actions">
                            @if (group.Category.IsSystemManaged)
                            {
                                <span class="status-pill">Starter</span>
                            }
                            <span class="status-pill">@(group.Category.IsActive ? "Active" : "Archived")</span>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="button" type="button" @onclick="() => EditCategory(group.Category)">Edit Category</button>
                        @if (group.Category.IsSystemManaged)
                        {
                            <button class="button" type="button" @onclick="() => CopyCategoryAsync(group.Category)">Copy as Custom</button>
                        }
                        @if (group.Category.IsActive)
                        {
                            <button class="button danger" type="button" @onclick="() => SetCategoryActiveAsync(group.Category, false)">Archive Category</button>
                        }
                        else
                        {
                            <button class="button primary" type="button" @onclick="() => SetCategoryActiveAsync(group.Category, true)">Reactivate Category</button>
                        }
                    </div>

                    @if (group.Services.Count == 0)
                    {
                        <p class="form-note">No services in this category yet.</p>
                    }
                    else
                    {
                        <div class="data-list">
                            @foreach (var service in group.Services)
                            {
                                <article class="row-card compact">
                                    <div>
                                        <strong>@service.Name</strong>
                                        <p>@service.Description</p>
                                        <small>@service.DefaultDurationMinutes min &middot; @(service.IsTaxable ? "Taxable" : "Non-taxable") &middot; @(service.IsActive ? "Active" : "Archived")</small>
                                    </div>
                                    <div class="row-actions">
                                        <span class="price">@service.DefaultPrice.ToString("C")</span>
                                        <button class="button" type="button" @onclick="() => EditService(service)">Edit</button>
                                        @if (group.Category.IsSystemManaged)
                                        {
                                            <button class="button" type="button" @onclick="() => CopyServiceAsync(service)">Copy</button>
                                        }
                                        @if (service.IsActive)
                                        {
                                            <button class="button danger" type="button" @onclick="() => SetServiceActiveAsync(service, false)">Archive</button>
                                        }
                                        else
                                        {
                                            <button class="button primary" type="button" @onclick="() => SetServiceActiveAsync(service, true)">Reactivate</button>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    </section>
}

@code {
    private const string CompanyId = "clearwater";
    private CatalogOverview? catalog;
    private ServiceCategoryForm categoryForm = new();
    private ServiceForm serviceForm = new();
    private string? message;
    private string? errorMessage;
    private bool IsSystemAdminRoute => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("admin/", StringComparison.OrdinalIgnoreCase);
    private string PageScope => IsSystemAdminRoute ? "System Administrator" : "Company Admin";
    private IReadOnlyList<ServiceCategory> ServiceCategories => catalog?.ServiceGroups.Select(g => g.Category).ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        DemoUser.UserId = IsSystemAdminRoute ? "sys-admin" : "clearwater-owner-1";
        await LoadAsync();
    }

    private async Task SaveCategoryAsync()
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.UpsertServiceCategoryAsync(new ServiceCategory(
                categoryForm.Id,
                CompanyId,
                categoryForm.Name,
                categoryForm.Description,
                categoryForm.IsSystemManaged,
                categoryForm.IsActive));
            message = $"{categoryForm.Name} category was saved.";
            ResetCategoryForm();
        });
    }

    private async Task SaveServiceAsync()
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.UpsertServiceAsync(new ServiceOffering(
                serviceForm.Id,
                CompanyId,
                serviceForm.CategoryId,
                serviceForm.Name,
                serviceForm.Description,
                serviceForm.DefaultDurationMinutes,
                serviceForm.DefaultPrice,
                serviceForm.IsTaxable,
                serviceForm.IsActive));
            message = $"{serviceForm.Name} was saved.";
            ResetServiceForm();
        });
    }

    private async Task SetCategoryActiveAsync(ServiceCategory category, bool isActive)
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.SetServiceCategoryActiveAsync(CompanyId, category.Id, isActive);
            message = $"{category.Name} was {(isActive ? "reactivated" : "archived")}.";
        });
    }

    private async Task CopyCategoryAsync(ServiceCategory category)
    {
        await RunAsync(async () =>
        {
            var copy = await CompanyAdminService.CopyServiceCategoryAsync(CompanyId, category.Id);
            message = $"{category.Name} was copied to {copy.Name}.";
        });
    }

    private async Task SetServiceActiveAsync(ServiceOffering service, bool isActive)
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.SetServiceActiveAsync(CompanyId, service.Id, isActive);
            message = $"{service.Name} was {(isActive ? "reactivated" : "archived")}.";
        });
    }

    private async Task CopyServiceAsync(ServiceOffering service)
    {
        await RunAsync(async () =>
        {
            var copy = await CompanyAdminService.CopyServiceAsync(CompanyId, service.Id);
            message = $"{service.Name} was copied to {copy.Name}.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        message = null;
        errorMessage = null;

        try
        {
            await action();
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadAsync()
    {
        catalog = await CompanyAdminService.GetCatalogOverviewAsync(CompanyId);
    }

    private void EditCategory(ServiceCategory category)
    {
        categoryForm = ServiceCategoryForm.FromCategory(category);
    }

    private void EditService(ServiceOffering service)
    {
        serviceForm = ServiceForm.FromService(service);
    }

    private void ResetCategoryForm() => categoryForm = new();

    private void ResetServiceForm() => serviceForm = new();

    private sealed class ServiceCategoryForm
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsSystemManaged { get; set; }
        public bool IsActive { get; set; } = true;
        public bool IsEditing { get; set; }

        public static ServiceCategoryForm FromCategory(ServiceCategory category) => new()
        {
            Id = category.Id,
            Name = category.Name,
            Description = category.Description,
            IsSystemManaged = category.IsSystemManaged,
            IsActive = category.IsActive,
            IsEditing = true
        };
    }

    private sealed class ServiceForm
    {
        public string Id { get; set; } = "";
        public string? CategoryId { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public int DefaultDurationMinutes { get; set; } = 45;
        public decimal DefaultPrice { get; set; }
        public bool IsTaxable { get; set; } = true;
        public bool IsActive { get; set; } = true;
        public bool IsEditing { get; set; }

        public static ServiceForm FromService(ServiceOffering service) => new()
        {
            Id = service.Id,
            CategoryId = service.CategoryId,
            Name = service.Name,
            Description = service.Description,
            DefaultDurationMinutes = service.DefaultDurationMinutes,
            DefaultPrice = service.DefaultPrice,
            IsTaxable = service.IsTaxable,
            IsActive = service.IsActive,
            IsEditing = true
        };
    }
}
