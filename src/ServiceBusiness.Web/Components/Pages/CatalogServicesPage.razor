@page "/catalog/services"
@page "/admin/catalog/services"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using ServiceBusiness.Domain
@inject ServiceBusiness.Application.CompanyAdminService CompanyAdminService
@inject ServiceBusiness.Web.DemoCurrentUserContext DemoUser
@inject ServiceBusiness.Web.CurrentCompanyContext CurrentCompany
@inject NavigationManager Navigation

<PageTitle>Services</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">@PageScope</p>
        <h1>Services</h1>
        <p class="lede">Create, edit, archive, and reactivate service categories and service items.</p>
    </div>
    <a class="button" href="catalog">Catalog Overview</a>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice error">@errorMessage</div>
}

@if (catalog is null)
{
    <p>Loading services...</p>
}
else
{
    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Service Categories</h2>
            <div class="management-panel-actions">
                <button class="button primary" type="button" @onclick="ShowCreateCategory">Create</button>
                <button class="icon-button" type="button" title="Toggle service categories" @onclick="ToggleCategoryList">@(categoryListExpanded ? "^" : "v")</button>
            </div>
        </div>
        @if (categoryListExpanded)
        {
            <div class="management-panel-body">
                @if (categoryEditorExpanded)
                {
                    <EditForm Model="categoryForm" OnValidSubmit="SaveCategoryAsync" FormName="service-category-editor">
                        <div class="editor-panel">
                            <h3>@(categoryForm.IsEditing ? "Edit Category" : "Create Category")</h3>
                <label>
                    Category ID
                    <InputText class="form-control" @bind-Value="categoryForm.Id" disabled="@categoryForm.IsEditing" />
                </label>
                <label>
                    Name
                    <InputText class="form-control" @bind-Value="categoryForm.Name" />
                </label>
                <label>
                    Description
                    <InputTextArea class="form-control" @bind-Value="categoryForm.Description" />
                </label>
                <label class="check-row">
                    <InputCheckbox @bind-Value="categoryForm.IsActive" />
                    <span>Active</span>
                </label>
                <div class="form-actions">
                    <button class="button primary" type="submit">Save Category</button>
                                    <button class="button" type="button" @onclick="HideCategoryEditor">Cancel</button>
                </div>
                        </div>
                    </EditForm>
                }
                <div class="management-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Active</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th class="actions">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in catalog.ServiceGroups)
                            {
                                <tr>
                                    <td>@group.Category.Id</td>
                                    <td>@(group.Category.IsActive ? "Yes" : "No")</td>
                                    <td>@group.Category.Name</td>
                                    <td>@group.Category.Description</td>
                                    <td class="actions">
                                        <button class="icon-button" type="button" title="Edit category" @onclick="() => EditCategory(group.Category)">Edit</button>
                                        @if (group.Category.IsSystemManaged)
                                        {
                                            <button class="icon-button" type="button" title="Copy as custom category" @onclick="() => CopyCategoryAsync(group.Category)">Copy</button>
                                        }
                                        @if (group.Category.IsActive)
                                        {
                                            <button class="icon-button danger" type="button" title="Archive category" @onclick="() => SetCategoryActiveAsync(group.Category, false)">Del</button>
                                        }
                                        else
                                        {
                                            <button class="icon-button" type="button" title="Reactivate category" @onclick="() => SetCategoryActiveAsync(group.Category, true)">On</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>

    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Services</h2>
            <div class="management-panel-actions">
                <button class="button primary" type="button" @onclick="ShowCreateService">Create</button>
                <button class="icon-button" type="button" title="Toggle services" @onclick="ToggleServiceList">@(serviceListExpanded ? "^" : "v")</button>
            </div>
        </div>
        @if (serviceListExpanded)
        {
            <div class="management-panel-body">
                @if (serviceEditorExpanded)
                {
                    <EditForm Model="serviceForm" OnValidSubmit="SaveServiceAsync" FormName="service-item-editor">
                        <div class="editor-panel">
                            <h3>@(serviceForm.IsEditing ? "Edit Service" : "Create Service")</h3>
                <div class="form-grid">
                    <label>
                        Service ID
                        <InputText class="form-control" @bind-Value="serviceForm.Id" disabled="@serviceForm.IsEditing" />
                    </label>
                    <label>
                        Category
                        <InputSelect class="form-control" @bind-Value="serviceForm.CategoryId">
                            <option value="">Uncategorized</option>
                            @foreach (var category in ServiceCategories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        Name
                        <InputText class="form-control" @bind-Value="serviceForm.Name" />
                    </label>
                    <label>
                        Duration minutes
                        <InputNumber class="form-control" @bind-Value="serviceForm.DefaultDurationMinutes" />
                    </label>
                    <label>
                        Default price
                        <InputNumber class="form-control" @bind-Value="serviceForm.DefaultPrice" />
                    </label>
                    <label class="wide">
                        Description
                        <InputTextArea class="form-control" @bind-Value="serviceForm.Description" />
                    </label>
                    <label class="check-row">
                        <InputCheckbox @bind-Value="serviceForm.IsTaxable" />
                        <span>Taxable</span>
                    </label>
                    <label class="check-row">
                        <InputCheckbox @bind-Value="serviceForm.IsActive" />
                        <span>Active</span>
                    </label>
                </div>
                <div class="form-actions">
                    <button class="button primary" type="submit">Save Service</button>
                                    <button class="button" type="button" @onclick="HideServiceEditor">Cancel</button>
                </div>
                        </div>
                    </EditForm>
                }
                <div class="management-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Active</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th class="actions">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in catalog.ServiceGroups)
                            {
                                @foreach (var service in group.Services)
                                {
                                    <tr>
                                        <td>@service.Id</td>
                                        <td>@(service.IsActive ? "Yes" : "No")</td>
                                        <td>@service.Name</td>
                                        <td>@group.Category.Name</td>
                                        <td>@service.Description</td>
                                        <td class="actions">
                                            <button class="icon-button" type="button" title="Edit service" @onclick="() => EditService(service)">Edit</button>
                                            @if (group.Category.IsSystemManaged)
                                            {
                                                <button class="icon-button" type="button" title="Copy service" @onclick="() => CopyServiceAsync(service)">Copy</button>
                                            }
                                            @if (service.IsActive)
                                            {
                                                <button class="icon-button danger" type="button" title="Archive service" @onclick="() => SetServiceActiveAsync(service, false)">Del</button>
                                            }
                                            else
                                            {
                                                <button class="icon-button" type="button" title="Reactivate service" @onclick="() => SetServiceActiveAsync(service, true)">On</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
}

@code {
    private string companyId = "";
    private CatalogOverview? catalog;
    private ServiceCategoryForm categoryForm = new();
    private ServiceForm serviceForm = new();
    private bool categoryListExpanded = true;
    private bool serviceListExpanded = true;
    private bool categoryEditorExpanded;
    private bool serviceEditorExpanded;
    private string? message;
    private string? errorMessage;
    private bool IsSystemAdminRoute => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("admin/", StringComparison.OrdinalIgnoreCase);
    private string PageScope => IsSystemAdminRoute ? "System Administrator" : "Company Admin";
    private IReadOnlyList<ServiceCategory> ServiceCategories => catalog?.ServiceGroups.Select(g => g.Category).ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        if (IsSystemAdminRoute)
        {
            DemoUser.UserId = "sys-admin";
            companyId = "clearwater";
        }
        else
        {
            companyId = await CurrentCompany.GetRequiredCompanyIdAsync([CompanyRole.CompanyAdmin]);
        }

        await LoadAsync();
    }

    private async Task SaveCategoryAsync()
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.UpsertServiceCategoryAsync(new ServiceCategory(
                categoryForm.Id,
                companyId,
                categoryForm.Name,
                categoryForm.Description,
                categoryForm.IsSystemManaged,
                categoryForm.IsActive));
            message = $"{categoryForm.Name} category was saved.";
            ResetCategoryForm();
            categoryEditorExpanded = false;
        });
    }

    private async Task SaveServiceAsync()
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.UpsertServiceAsync(new ServiceOffering(
                serviceForm.Id,
                companyId,
                serviceForm.CategoryId,
                serviceForm.Name,
                serviceForm.Description,
                serviceForm.DefaultDurationMinutes,
                serviceForm.DefaultPrice,
                serviceForm.IsTaxable,
                serviceForm.IsActive));
            message = $"{serviceForm.Name} was saved.";
            ResetServiceForm();
            serviceEditorExpanded = false;
        });
    }

    private async Task SetCategoryActiveAsync(ServiceCategory category, bool isActive)
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.SetServiceCategoryActiveAsync(companyId, category.Id, isActive);
            message = $"{category.Name} was {(isActive ? "reactivated" : "archived")}.";
        });
    }

    private async Task CopyCategoryAsync(ServiceCategory category)
    {
        await RunAsync(async () =>
        {
            var copy = await CompanyAdminService.CopyServiceCategoryAsync(companyId, category.Id);
            message = $"{category.Name} was copied to {copy.Name}.";
        });
    }

    private async Task SetServiceActiveAsync(ServiceOffering service, bool isActive)
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.SetServiceActiveAsync(companyId, service.Id, isActive);
            message = $"{service.Name} was {(isActive ? "reactivated" : "archived")}.";
        });
    }

    private async Task CopyServiceAsync(ServiceOffering service)
    {
        await RunAsync(async () =>
        {
            var copy = await CompanyAdminService.CopyServiceAsync(companyId, service.Id);
            message = $"{service.Name} was copied to {copy.Name}.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        message = null;
        errorMessage = null;

        try
        {
            await action();
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadAsync()
    {
        catalog = await CompanyAdminService.GetCatalogOverviewAsync(companyId);
    }

    private void EditCategory(ServiceCategory category)
    {
        categoryForm = ServiceCategoryForm.FromCategory(category);
        categoryEditorExpanded = true;
        categoryListExpanded = true;
    }

    private void EditService(ServiceOffering service)
    {
        serviceForm = ServiceForm.FromService(service);
        serviceEditorExpanded = true;
        serviceListExpanded = true;
    }

    private void ResetCategoryForm() => categoryForm = new();

    private void ResetServiceForm() => serviceForm = new();

    private void ShowCreateCategory()
    {
        ResetCategoryForm();
        categoryEditorExpanded = true;
        categoryListExpanded = true;
    }

    private void ShowCreateService()
    {
        ResetServiceForm();
        serviceEditorExpanded = true;
        serviceListExpanded = true;
    }

    private void HideCategoryEditor()
    {
        ResetCategoryForm();
        categoryEditorExpanded = false;
    }

    private void HideServiceEditor()
    {
        ResetServiceForm();
        serviceEditorExpanded = false;
    }

    private void ToggleCategoryList() => categoryListExpanded = !categoryListExpanded;

    private void ToggleServiceList() => serviceListExpanded = !serviceListExpanded;

    private sealed class ServiceCategoryForm
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsSystemManaged { get; set; }
        public bool IsActive { get; set; } = true;
        public bool IsEditing { get; set; }

        public static ServiceCategoryForm FromCategory(ServiceCategory category) => new()
        {
            Id = category.Id,
            Name = category.Name,
            Description = category.Description,
            IsSystemManaged = category.IsSystemManaged,
            IsActive = category.IsActive,
            IsEditing = true
        };
    }

    private sealed class ServiceForm
    {
        public string Id { get; set; } = "";
        public string? CategoryId { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public int DefaultDurationMinutes { get; set; } = 45;
        public decimal DefaultPrice { get; set; }
        public bool IsTaxable { get; set; } = true;
        public bool IsActive { get; set; } = true;
        public bool IsEditing { get; set; }

        public static ServiceForm FromService(ServiceOffering service) => new()
        {
            Id = service.Id,
            CategoryId = service.CategoryId,
            Name = service.Name,
            Description = service.Description,
            DefaultDurationMinutes = service.DefaultDurationMinutes,
            DefaultPrice = service.DefaultPrice,
            IsTaxable = service.IsTaxable,
            IsActive = service.IsActive,
            IsEditing = true
        };
    }
}
