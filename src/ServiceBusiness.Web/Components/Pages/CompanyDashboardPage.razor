@page "/company"
@rendermode InteractiveServer
@using ServiceBusiness.Domain
@inject ServiceBusiness.Application.CompanyAdminService CompanyAdminService
@inject ServiceBusiness.Web.CurrentCompanyContext CurrentCompany
@inject ServiceBusiness.Web.ApplicationModeService ApplicationMode

<PageTitle>Company Dashboard</PageTitle>

@if (dashboard is null)
{
    <p>Loading dashboard...</p>
}
else
{
    <section class="dashboard-hero" style="background-image: linear-gradient(90deg, rgba(13, 30, 26, .68), rgba(13, 30, 26, .22)), url('@appMode.HeroImageUrl');">
        <div>
            <p class="eyebrow">@appMode.ProductCategory</p>
            <h1>@appMode.ProductName Dashboard</h1>
        </div>
    </section>

    <section class="page-header">
        <div>
            <p class="eyebrow">Company Admin</p>
            <h1>@dashboard.Company.Name</h1>
            <p class="lede">Company setup and approval work that needs attention.</p>
        </div>
        <div class="page-actions">
            <a class="button" href="settings/users">Users</a>
            <a class="button primary" href="schedule">Schedule</a>
        </div>
    </section>

    <div class="metric-grid">
        <a class="metric metric-link" href="clients">
            <span>Customers</span>
            <strong>@dashboard.CustomerCount</strong>
        </a>
        <a class="metric metric-link" href="settings/users">
            <span>Employees</span>
            <strong>@dashboard.EmployeeCount</strong>
        </a>
        @if (appMode.IsPoolMode)
        {
            <a class="metric metric-link" href="poolequipment">
                <span>Pool Equipment</span>
                <strong>@dashboard.EquipmentCount</strong>
            </a>
        }
        <a class="metric metric-link" href="settings/materials">
            <span>Materials</span>
            <strong>@dashboard.MaterialCount</strong>
        </a>
        <a class="metric metric-link" href="settings/services">
            <span>Services</span>
            <strong>@dashboard.ServiceCount</strong>
        </a>
    </div>

    <div class="metric-grid">
        <button class="metric metric-button" type="button" @onclick="() => ShowPendingPanel(CompanyRole.CompanyUser)">
            <span>Pending Employee Approvals</span>
            <strong>@dashboard.PendingEmployeeRequests</strong>
        </button>
        <button class="metric metric-button" type="button" @onclick="() => ShowPendingPanel(CompanyRole.CompanyClientUser)">
            <span>Pending Customer Approvals</span>
            <strong>@dashboard.PendingCustomerRequests</strong>
        </button>
    </div>

    @if (pendingPanelRole is not null)
    {
        <section class="management-panel">
            <div class="management-panel-header">
                <h2>@GetPendingPanelTitle()</h2>
                <div class="management-panel-actions">
                    <button class="icon-button" type="button" title="Close approvals" @onclick="ClosePendingPanel">x</button>
                </div>
            </div>
            <div class="management-panel-body">
                @if (PendingPanelRequests.Count == 0)
                {
                    <p class="empty-state">No pending approvals for this group.</p>
                }
                else
                {
                    <div class="management-table-wrap">
                        <table class="management-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Requested</th>
                                    <th class="actions">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in PendingPanelRequests)
                                {
                                    <tr>
                                        <td>@request.User.DisplayName</td>
                                        <td>@request.User.Email</td>
                                        <td>@request.Role.DisplayName</td>
                                        <td>@request.Membership.RequestedUtc.LocalDateTime.ToShortDateString()</td>
                                        <td class="actions">
                                            <label class="switch-control" title="Approve access request">
                                                <input type="checkbox" @onchange="args => DecideAsync(request, IsChecked(args) ? MembershipStatus.Active : MembershipStatus.Rejected)" />
                                                <span></span>
                                            </label>
                                            <button class="icon-button danger icon-only" type="button" title="Reject request" aria-label="Reject request" @onclick="() => DecideAsync(request, MembershipStatus.Rejected)">
                                                <span class="action-icon delete-icon" aria-hidden="true"></span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="notice success">@message</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="notice error">@errorMessage</div>
    }

    <section class="section">
        <div>
            <h2>Workspace</h2>
            <p>Use the tiles above to manage company setup and approval work.</p>
        </div>
    </section>
}

@code {
    private CompanyDashboard? dashboard;
    private ServiceBusiness.Web.ApplicationModeSnapshot appMode = ServiceBusiness.Web.ApplicationModeSnapshot.Pool;
    private CompanyRole? pendingPanelRole;
    private string? message;
    private string? errorMessage;
    private string companyId = "";

    private IReadOnlyList<AccessRequest> PendingPanelRequests =>
        dashboard?.PendingAccessRequests
            .Where(r => r.Membership.Role == pendingPanelRole)
            .ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        appMode = await ApplicationMode.GetCurrentAsync();
        companyId = await CurrentCompany.GetRequiredCompanyIdAsync([CompanyRole.CompanyAdmin]);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        dashboard = await CompanyAdminService.GetDashboardAsync(companyId, DateOnly.FromDateTime(DateTime.Today));
    }

    private void ShowPendingPanel(CompanyRole role)
    {
        pendingPanelRole = pendingPanelRole == role ? null : role;
        message = null;
        errorMessage = null;
    }

    private void ClosePendingPanel()
    {
        pendingPanelRole = null;
    }

    private async Task DecideAsync(AccessRequest request, MembershipStatus decision)
    {
        message = null;
        errorMessage = null;

        try
        {
            await CompanyAdminService.DecideAccessRequestAsync(
                request.Company.Id,
                request.User.Id,
                request.Membership.Role,
                decision);
            message = $"{request.User.DisplayName} was {decision.ToString().ToLowerInvariant()} for {request.Company.Name}.";
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private string GetPendingPanelTitle() => pendingPanelRole switch
    {
        CompanyRole.CompanyUser => "Pending Employee Approvals",
        CompanyRole.CompanyClientUser => "Pending Customer Approvals",
        _ => "Pending Approvals"
    };

    private static bool IsChecked(ChangeEventArgs args) => args.Value is bool value && value;
}
