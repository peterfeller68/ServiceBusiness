@page "/catalog/materials"
@page "/admin/catalog/materials"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using ServiceBusiness.Domain
@inject ServiceBusiness.Application.CompanyAdminService CompanyAdminService
@inject ServiceBusiness.Web.DemoCurrentUserContext DemoUser
@inject ServiceBusiness.Web.CurrentCompanyContext CurrentCompany
@inject NavigationManager Navigation

<PageTitle>Materials</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">@PageScope</p>
        <h1>Materials</h1>
        <p class="lede">Create, edit, archive, and reactivate material categories and material items.</p>
    </div>
    <a class="button" href="catalog">Catalog Overview</a>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice error">@errorMessage</div>
}

@if (catalog is null)
{
    <p>Loading materials...</p>
}
else
{
    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Material Categories</h2>
            <div class="management-panel-actions">
                <button class="button primary" type="button" @onclick="ShowCreateCategory">Create</button>
                <button class="icon-button" type="button" title="Toggle material categories" @onclick="ToggleCategoryList">@(categoryListExpanded ? "^" : "v")</button>
            </div>
        </div>
        @if (categoryListExpanded)
        {
            <div class="management-panel-body">
                @if (categoryEditorExpanded)
                {
                    <EditForm Model="categoryForm" OnValidSubmit="SaveCategoryAsync" FormName="material-category-editor">
                        <div class="editor-panel">
                            <h3>@(categoryForm.IsEditing ? "Edit Category" : "Create Category")</h3>
                <label>
                    Category ID
                    <InputText class="form-control" @bind-Value="categoryForm.Id" disabled="@categoryForm.IsEditing" />
                </label>
                <label>
                    Name
                    <InputText class="form-control" @bind-Value="categoryForm.Name" />
                </label>
                <label>
                    Description
                    <InputTextArea class="form-control" @bind-Value="categoryForm.Description" />
                </label>
                <label class="check-row">
                    <InputCheckbox @bind-Value="categoryForm.IsActive" />
                    <span>Active</span>
                </label>
                <div class="form-actions">
                    <button class="button primary" type="submit">Save Category</button>
                                    <button class="button" type="button" @onclick="HideCategoryEditor">Cancel</button>
                </div>
                        </div>
                    </EditForm>
                }
                <div class="management-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Active</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th class="actions">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in catalog.MaterialGroups)
                            {
                                <tr>
                                    <td>@group.Category.Id</td>
                                    <td>@(group.Category.IsActive ? "Yes" : "No")</td>
                                    <td>@group.Category.Name</td>
                                    <td>@group.Category.Description</td>
                                    <td class="actions">
                                        <button class="icon-button" type="button" title="Edit category" @onclick="() => EditCategory(group.Category)">Edit</button>
                                        @if (group.Category.IsSystemManaged)
                                        {
                                            <button class="icon-button" type="button" title="Copy as custom category" @onclick="() => CopyCategoryAsync(group.Category)">Copy</button>
                                        }
                                        @if (group.Category.IsActive)
                                        {
                                            <button class="icon-button danger" type="button" title="Archive category" @onclick="() => SetCategoryActiveAsync(group.Category, false)">Del</button>
                                        }
                                        else
                                        {
                                            <button class="icon-button" type="button" title="Reactivate category" @onclick="() => SetCategoryActiveAsync(group.Category, true)">On</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>

    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Materials</h2>
            <div class="management-panel-actions">
                <button class="button primary" type="button" @onclick="ShowCreateMaterial">Create</button>
                <button class="icon-button" type="button" title="Toggle materials" @onclick="ToggleMaterialList">@(materialListExpanded ? "^" : "v")</button>
            </div>
        </div>
        @if (materialListExpanded)
        {
            <div class="management-panel-body">
                @if (materialEditorExpanded)
                {
                    <EditForm Model="materialForm" OnValidSubmit="SaveMaterialAsync" FormName="material-item-editor">
                        <div class="editor-panel">
                            <h3>@(materialForm.IsEditing ? "Edit Material" : "Create Material")</h3>
                <div class="form-grid">
                    <label>
                        Material ID
                        <InputText class="form-control" @bind-Value="materialForm.Id" disabled="@materialForm.IsEditing" />
                    </label>
                    <label>
                        Category
                        <InputSelect class="form-control" @bind-Value="materialForm.CategoryId">
                            <option value="">Uncategorized</option>
                            @foreach (var category in MaterialCategories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        Name
                        <InputText class="form-control" @bind-Value="materialForm.Name" />
                    </label>
                    <label>
                        Unit
                        <InputText class="form-control" @bind-Value="materialForm.UnitOfMeasure" />
                    </label>
                    <label>
                        Unit cost
                        <InputNumber class="form-control" @bind-Value="materialForm.DefaultUnitCost" />
                    </label>
                    <label>
                        Billable price
                        <InputNumber class="form-control" @bind-Value="materialForm.DefaultBillableUnitPrice" />
                    </label>
                    <label class="check-row">
                        <InputCheckbox @bind-Value="materialForm.IsTaxable" />
                        <span>Taxable</span>
                    </label>
                    <label class="check-row">
                        <InputCheckbox @bind-Value="materialForm.IsActive" />
                        <span>Active</span>
                    </label>
                </div>
                <div class="form-actions">
                    <button class="button primary" type="submit">Save Material</button>
                                    <button class="button" type="button" @onclick="HideMaterialEditor">Cancel</button>
                </div>
                        </div>
                    </EditForm>
                }
                <div class="management-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Active</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Unit</th>
                                <th>Price</th>
                                <th class="actions">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in catalog.MaterialGroups)
                            {
                                @foreach (var material in group.Materials)
                                {
                                    <tr>
                                        <td>@material.Id</td>
                                        <td>@(material.IsActive ? "Yes" : "No")</td>
                                        <td>@material.Name</td>
                                        <td>@group.Category.Name</td>
                                        <td>@material.UnitOfMeasure</td>
                                        <td>@material.DefaultBillableUnitPrice.ToString("C")</td>
                                        <td class="actions">
                                            <button class="icon-button" type="button" title="Edit material" @onclick="() => EditMaterial(material)">Edit</button>
                                            @if (group.Category.IsSystemManaged)
                                            {
                                                <button class="icon-button" type="button" title="Copy material" @onclick="() => CopyMaterialAsync(material)">Copy</button>
                                            }
                                            @if (material.IsActive)
                                            {
                                                <button class="icon-button danger" type="button" title="Archive material" @onclick="() => SetMaterialActiveAsync(material, false)">Del</button>
                                            }
                                            else
                                            {
                                                <button class="icon-button" type="button" title="Reactivate material" @onclick="() => SetMaterialActiveAsync(material, true)">On</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
}

@code {
    private string companyId = "";
    private CatalogOverview? catalog;
    private MaterialCategoryForm categoryForm = new();
    private MaterialForm materialForm = new();
    private bool categoryListExpanded = true;
    private bool materialListExpanded = true;
    private bool categoryEditorExpanded;
    private bool materialEditorExpanded;
    private string? message;
    private string? errorMessage;
    private bool IsSystemAdminRoute => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("admin/", StringComparison.OrdinalIgnoreCase);
    private string PageScope => IsSystemAdminRoute ? "System Administrator" : "Company Admin";
    private IReadOnlyList<MaterialCategory> MaterialCategories => catalog?.MaterialGroups.Select(g => g.Category).ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        if (IsSystemAdminRoute)
        {
            DemoUser.UserId = "sys-admin";
            companyId = "clearwater";
        }
        else
        {
            companyId = await CurrentCompany.GetRequiredCompanyIdAsync([CompanyRole.CompanyAdmin]);
        }

        await LoadAsync();
    }

    private async Task SaveCategoryAsync()
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.UpsertMaterialCategoryAsync(new MaterialCategory(
                categoryForm.Id,
                companyId,
                categoryForm.Name,
                categoryForm.Description,
                categoryForm.IsSystemManaged,
                categoryForm.IsActive));
            message = $"{categoryForm.Name} category was saved.";
            ResetCategoryForm();
            categoryEditorExpanded = false;
        });
    }

    private async Task SaveMaterialAsync()
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.UpsertMaterialAsync(new Material(
                materialForm.Id,
                companyId,
                materialForm.CategoryId,
                materialForm.Name,
                materialForm.UnitOfMeasure,
                materialForm.DefaultUnitCost,
                materialForm.DefaultBillableUnitPrice,
                materialForm.IsTaxable,
                materialForm.IsActive));
            message = $"{materialForm.Name} was saved.";
            ResetMaterialForm();
            materialEditorExpanded = false;
        });
    }

    private async Task SetCategoryActiveAsync(MaterialCategory category, bool isActive)
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.SetMaterialCategoryActiveAsync(companyId, category.Id, isActive);
            message = $"{category.Name} was {(isActive ? "reactivated" : "archived")}.";
        });
    }

    private async Task CopyCategoryAsync(MaterialCategory category)
    {
        await RunAsync(async () =>
        {
            var copy = await CompanyAdminService.CopyMaterialCategoryAsync(companyId, category.Id);
            message = $"{category.Name} was copied to {copy.Name}.";
        });
    }

    private async Task SetMaterialActiveAsync(Material material, bool isActive)
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.SetMaterialActiveAsync(companyId, material.Id, isActive);
            message = $"{material.Name} was {(isActive ? "reactivated" : "archived")}.";
        });
    }

    private async Task CopyMaterialAsync(Material material)
    {
        await RunAsync(async () =>
        {
            var copy = await CompanyAdminService.CopyMaterialAsync(companyId, material.Id);
            message = $"{material.Name} was copied to {copy.Name}.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        message = null;
        errorMessage = null;

        try
        {
            await action();
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadAsync()
    {
        catalog = await CompanyAdminService.GetCatalogOverviewAsync(companyId);
    }

    private void EditCategory(MaterialCategory category)
    {
        categoryForm = MaterialCategoryForm.FromCategory(category);
        categoryEditorExpanded = true;
        categoryListExpanded = true;
    }

    private void EditMaterial(Material material)
    {
        materialForm = MaterialForm.FromMaterial(material);
        materialEditorExpanded = true;
        materialListExpanded = true;
    }

    private void ResetCategoryForm() => categoryForm = new();

    private void ResetMaterialForm() => materialForm = new();

    private void ShowCreateCategory()
    {
        ResetCategoryForm();
        categoryEditorExpanded = true;
        categoryListExpanded = true;
    }

    private void ShowCreateMaterial()
    {
        ResetMaterialForm();
        materialEditorExpanded = true;
        materialListExpanded = true;
    }

    private void HideCategoryEditor()
    {
        ResetCategoryForm();
        categoryEditorExpanded = false;
    }

    private void HideMaterialEditor()
    {
        ResetMaterialForm();
        materialEditorExpanded = false;
    }

    private void ToggleCategoryList() => categoryListExpanded = !categoryListExpanded;

    private void ToggleMaterialList() => materialListExpanded = !materialListExpanded;

    private sealed class MaterialCategoryForm
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsSystemManaged { get; set; }
        public bool IsActive { get; set; } = true;
        public bool IsEditing { get; set; }

        public static MaterialCategoryForm FromCategory(MaterialCategory category) => new()
        {
            Id = category.Id,
            Name = category.Name,
            Description = category.Description,
            IsSystemManaged = category.IsSystemManaged,
            IsActive = category.IsActive,
            IsEditing = true
        };
    }

    private sealed class MaterialForm
    {
        public string Id { get; set; } = "";
        public string? CategoryId { get; set; }
        public string Name { get; set; } = "";
        public string UnitOfMeasure { get; set; } = "";
        public decimal DefaultUnitCost { get; set; }
        public decimal DefaultBillableUnitPrice { get; set; }
        public bool IsTaxable { get; set; } = true;
        public bool IsActive { get; set; } = true;
        public bool IsEditing { get; set; }

        public static MaterialForm FromMaterial(Material material) => new()
        {
            Id = material.Id,
            CategoryId = material.CategoryId,
            Name = material.Name,
            UnitOfMeasure = material.UnitOfMeasure,
            DefaultUnitCost = material.DefaultUnitCost,
            DefaultBillableUnitPrice = material.DefaultBillableUnitPrice,
            IsTaxable = material.IsTaxable,
            IsActive = material.IsActive,
            IsEditing = true
        };
    }
}
