@page "/catalog/materials"
@page "/settings/materials"
@page "/admin/catalog/materials"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using System.Text
@using ServiceBusiness.Domain
@inject ServiceBusiness.Application.CompanyAdminService CompanyAdminService
@inject ServiceBusiness.Web.DemoCurrentUserContext DemoUser
@inject ServiceBusiness.Web.CurrentCompanyContext CurrentCompany
@inject NavigationManager Navigation

<PageTitle>Materials</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">@PageScope</p>
        <h1>Materials</h1>
        <p class="lede">Create, edit, archive, and reactivate material categories and material items.</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice error">@errorMessage</div>
}

@if (catalog is null)
{
    <p>Loading materials...</p>
}
else
{
    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Seed Materials</h2>
        </div>
        <div class="management-panel-body">
            <div class="form-grid">
                <label class="wide">
                    Materials CSV
                    <InputFile OnChange="OnSeedFileSelected" accept=".csv,text/csv" />
                </label>
            </div>
            <div class="form-actions">
                <button class="button primary" type="button" @onclick="SeedMaterialsAsync" disabled="@(seedFile is null)">Seed Table</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(seedFileName))
            {
                <p class="form-note">@seedFileName selected.</p>
            }
        </div>
    </section>

    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Material Categories</h2>
            <div class="management-panel-actions">
                <button class="button primary" type="button" @onclick="ShowCreateCategory">Create</button>
                <button class="icon-button" type="button" title="Toggle material categories" @onclick="ToggleCategoryList">@(categoryListExpanded ? "^" : "v")</button>
            </div>
        </div>
        @if (categoryListExpanded)
        {
            <div class="management-panel-body">
                @if (categoryEditorExpanded)
                {
                    <EditForm Model="categoryForm" OnValidSubmit="SaveCategoryAsync" FormName="material-category-editor">
                        <div class="editor-panel">
                            <h3>@(categoryForm.IsEditing ? "Edit Category" : "Create Category")</h3>
                <label>
                    Name
                    <InputText class="form-control" @bind-Value="categoryForm.Name" />
                </label>
                <label>
                    Description
                    <InputTextArea class="form-control" @bind-Value="categoryForm.Description" />
                </label>
                <label class="switch-control" title="Toggle active state">
                    <input type="checkbox" checked="@categoryForm.IsActive" @onchange="args => categoryForm.IsActive = GetChecked(args)" />
                    <span></span>
                    <small>Active</small>
                </label>
                <div class="form-actions">
                    <button class="button primary" type="submit">Save Category</button>
                                    <button class="button" type="button" @onclick="HideCategoryEditor">Cancel</button>
                </div>
                        </div>
                    </EditForm>
                }
                <div class="form-grid">
                    <label class="wide">
                        Filter categories
                        <input class="form-control" @bind="categoryFilter" @bind:event="oninput" placeholder="Filter by active state, category, or description" />
                    </label>
                </div>
                <div class="management-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th><button class="table-sort-button" type="button" @onclick="() => SortCategories(CategorySortColumn.Active)">Active @GetCategorySortIndicator(CategorySortColumn.Active)</button></th>
                                <th><button class="table-sort-button" type="button" @onclick="() => SortCategories(CategorySortColumn.Category)">Category @GetCategorySortIndicator(CategorySortColumn.Category)</button></th>
                                <th><button class="table-sort-button" type="button" @onclick="() => SortCategories(CategorySortColumn.Description)">Description @GetCategorySortIndicator(CategorySortColumn.Description)</button></th>
                                <th class="actions">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in FilteredCategoryGroups)
                            {
                                <tr>
                                    <td>
                                        <label class="switch-control" title="Toggle active state">
                                            <input type="checkbox" checked="@group.Category.IsActive" @onchange="args => ToggleCategoryActiveAsync(group.Category, args)" />
                                            <span></span>
                                        </label>
                                    </td>
                                    <td>@group.Category.Name</td>
                                    <td>@group.Category.Description</td>
                                    <td class="actions">
                                        <button class="icon-button icon-only" type="button" title="Edit category" aria-label="Edit category" @onclick="() => EditCategory(group.Category)">
                                            <span class="action-icon edit-icon" aria-hidden="true"></span>
                                        </button>
                                        @if (group.Category.IsSystemManaged)
                                        {
                                            <button class="icon-button icon-only" type="button" title="Copy as custom category" aria-label="Copy as custom category" @onclick="() => CopyCategoryAsync(group.Category)">
                                                <span class="action-icon copy-icon" aria-hidden="true"></span>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>

    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Materials</h2>
            <div class="management-panel-actions">
                <button class="button primary" type="button" @onclick="ShowCreateMaterial">Create</button>
                <button class="icon-button" type="button" title="Toggle materials" @onclick="ToggleMaterialList">@(materialListExpanded ? "^" : "v")</button>
            </div>
        </div>
        @if (materialListExpanded)
        {
            <div class="management-panel-body">
                @if (materialEditorExpanded)
                {
                    <EditForm Model="materialForm" OnValidSubmit="SaveMaterialAsync" FormName="material-item-editor">
                        <div class="editor-panel">
                            <h3>@(materialForm.IsEditing ? "Edit Material" : "Create Material")</h3>
                <div class="form-grid">
                    <label>
                        Category
                        <InputSelect class="form-control" @bind-Value="materialForm.CategoryId">
                            <option value="">Uncategorized</option>
                            @foreach (var category in MaterialCategories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        Brand
                        <InputText class="form-control" @bind-Value="materialForm.Brand" />
                    </label>
                    <label>
                        Name
                        <InputText class="form-control" @bind-Value="materialForm.Name" />
                    </label>
                    <label>
                        Model No
                        <InputText class="form-control" @bind-Value="materialForm.ModelNo" />
                    </label>
                    <label>
                        Unit
                        <InputText class="form-control" @bind-Value="materialForm.UnitOfMeasure" />
                    </label>
                    <label>
                        Unit cost
                        <InputNumber class="form-control" @bind-Value="materialForm.DefaultUnitCost" />
                    </label>
                    <label>
                        Billable price
                        <InputNumber class="form-control" @bind-Value="materialForm.DefaultBillableUnitPrice" />
                    </label>
                    <label class="switch-control" title="Toggle taxable state">
                        <input type="checkbox" checked="@materialForm.IsTaxable" @onchange="args => materialForm.IsTaxable = GetChecked(args)" />
                        <span></span>
                        <small>Taxable</small>
                    </label>
                    <label class="switch-control" title="Toggle active state">
                        <input type="checkbox" checked="@materialForm.IsActive" @onchange="args => materialForm.IsActive = GetChecked(args)" />
                        <span></span>
                        <small>Active</small>
                    </label>
                </div>
                <div class="form-actions">
                    <button class="button primary" type="submit">Save Material</button>
                                    <button class="button" type="button" @onclick="HideMaterialEditor">Cancel</button>
                </div>
                        </div>
                    </EditForm>
                }
                <div class="form-grid">
                    <label class="wide">
                        Filter materials
                        <input class="form-control" @bind="materialFilter" @bind:event="oninput" placeholder="Filter by active state, brand, name, category, model, unit, or price" />
                    </label>
                </div>
                <div class="management-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th><button class="table-sort-button" type="button" @onclick="() => SortMaterials(MaterialSortColumn.Active)">Active @GetMaterialSortIndicator(MaterialSortColumn.Active)</button></th>
                                <th><button class="table-sort-button" type="button" @onclick="() => SortMaterials(MaterialSortColumn.Brand)">Brand @GetMaterialSortIndicator(MaterialSortColumn.Brand)</button></th>
                                <th><button class="table-sort-button" type="button" @onclick="() => SortMaterials(MaterialSortColumn.Name)">Name @GetMaterialSortIndicator(MaterialSortColumn.Name)</button></th>
                                <th><button class="table-sort-button" type="button" @onclick="() => SortMaterials(MaterialSortColumn.Category)">Category @GetMaterialSortIndicator(MaterialSortColumn.Category)</button></th>
                                <th><button class="table-sort-button" type="button" @onclick="() => SortMaterials(MaterialSortColumn.ModelNo)">Model No @GetMaterialSortIndicator(MaterialSortColumn.ModelNo)</button></th>
                                <th><button class="table-sort-button" type="button" @onclick="() => SortMaterials(MaterialSortColumn.Unit)">Unit @GetMaterialSortIndicator(MaterialSortColumn.Unit)</button></th>
                                <th><button class="table-sort-button" type="button" @onclick="() => SortMaterials(MaterialSortColumn.Price)">Price @GetMaterialSortIndicator(MaterialSortColumn.Price)</button></th>
                                <th class="actions">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in FilteredMaterialRows)
                            {
                                    <tr>
                                        <td>
                                            <label class="switch-control" title="Toggle active state">
                                                <input type="checkbox" checked="@row.Material.IsActive" @onchange="args => ToggleMaterialActiveAsync(row.Material, args)" />
                                                <span></span>
                                            </label>
                                        </td>
                                        <td>@row.Material.Brand</td>
                                        <td>@row.Material.Name</td>
                                        <td>@row.Category.Name</td>
                                        <td>@row.Material.ModelNo</td>
                                        <td>@row.Material.UnitOfMeasure</td>
                                        <td>@row.Material.DefaultBillableUnitPrice.ToString("C")</td>
                                        <td class="actions">
                                            <button class="icon-button icon-only" type="button" title="Edit material" aria-label="Edit material" @onclick="() => EditMaterial(row.Material)">
                                                <span class="action-icon edit-icon" aria-hidden="true"></span>
                                            </button>
                                            @if (row.Category.IsSystemManaged)
                                            {
                                                <button class="icon-button icon-only" type="button" title="Copy material" aria-label="Copy material" @onclick="() => CopyMaterialAsync(row.Material)">
                                                    <span class="action-icon copy-icon" aria-hidden="true"></span>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
}

@code {
    private string companyId = "";
    private CatalogOverview? catalog;
    private MaterialCategoryForm categoryForm = new();
    private MaterialForm materialForm = new();
    private bool categoryListExpanded = true;
    private bool materialListExpanded = true;
    private bool categoryEditorExpanded;
    private bool materialEditorExpanded;
    private IBrowserFile? seedFile;
    private string? seedFileName;
    private string categoryFilter = "";
    private string materialFilter = "";
    private CategorySortColumn categorySortColumn = CategorySortColumn.Category;
    private MaterialSortColumn materialSortColumn = MaterialSortColumn.Name;
    private bool categorySortDescending;
    private bool materialSortDescending;
    private string? message;
    private string? errorMessage;
    private bool IsSystemAdminRoute => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("admin/", StringComparison.OrdinalIgnoreCase);
    private string PageScope => IsSystemAdminRoute ? "System Administrator" : "Company Admin";
    private IReadOnlyList<MaterialCategory> MaterialCategories => catalog?.MaterialGroups.Select(g => g.Category).ToList() ?? [];
    private IReadOnlyList<MaterialCategoryGroup> FilteredCategoryGroups => GetFilteredCategoryGroups();
    private IReadOnlyList<MaterialGridRow> FilteredMaterialRows => GetFilteredMaterialRows();

    protected override async Task OnInitializedAsync()
    {
        if (IsSystemAdminRoute)
        {
            DemoUser.UserId = "sys-admin";
            companyId = "global";
        }
        else
        {
            companyId = await CurrentCompany.GetRequiredCompanyIdAsync([CompanyRole.CompanyAdmin]);
        }

        await LoadAsync();
    }

    private async Task SaveCategoryAsync()
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.UpsertMaterialCategoryAsync(new MaterialCategory(
                GetCategoryRowKey(),
                companyId,
                categoryForm.Name,
                categoryForm.Description,
                categoryForm.IsSystemManaged,
                categoryForm.IsActive));
            message = $"{categoryForm.Name} category was saved.";
            ResetCategoryForm();
            categoryEditorExpanded = false;
        });
    }

    private async Task SaveMaterialAsync()
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.UpsertMaterialAsync(new Material(
                GetMaterialRowKey(),
                companyId,
                materialForm.CategoryId,
                materialForm.Name,
                materialForm.UnitOfMeasure,
                materialForm.DefaultUnitCost,
                materialForm.DefaultBillableUnitPrice,
                materialForm.IsTaxable,
                materialForm.IsActive,
                materialForm.Brand,
                materialForm.ModelNo));
            message = $"{materialForm.Name} was saved.";
            ResetMaterialForm();
            materialEditorExpanded = false;
        });
    }

    private void OnSeedFileSelected(InputFileChangeEventArgs args)
    {
        seedFile = args.File;
        seedFileName = seedFile.Name;
        message = null;
        errorMessage = null;
    }

    private async Task SeedMaterialsAsync()
    {
        if (seedFile is null)
        {
            errorMessage = "Choose a CSV file before seeding materials.";
            return;
        }

        await RunAsync(async () =>
        {
            var rows = await ReadSeedRowsAsync(seedFile);
            var result = await CompanyAdminService.SeedMaterialsAsync(companyId, rows);
            message = $"Seeded {result.CategoriesSeeded} material categories and {result.MaterialsSeeded} materials.";
            seedFile = null;
            seedFileName = null;
        });
    }

    private async Task SetCategoryActiveAsync(MaterialCategory category, bool isActive)
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.SetMaterialCategoryActiveAsync(companyId, category.Id, isActive);
            message = $"{category.Name} was {(isActive ? "reactivated" : "archived")}.";
        });
    }

    private Task ToggleCategoryActiveAsync(MaterialCategory category, ChangeEventArgs args) =>
        SetCategoryActiveAsync(category, GetChecked(args));

    private async Task CopyCategoryAsync(MaterialCategory category)
    {
        await RunAsync(async () =>
        {
            var copy = await CompanyAdminService.CopyMaterialCategoryAsync(companyId, category.Id);
            message = $"{category.Name} was copied to {copy.Name}.";
        });
    }

    private async Task SetMaterialActiveAsync(Material material, bool isActive)
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.SetMaterialActiveAsync(companyId, material.Id, isActive);
            message = $"{material.Name} was {(isActive ? "reactivated" : "archived")}.";
        });
    }

    private Task ToggleMaterialActiveAsync(Material material, ChangeEventArgs args) =>
        SetMaterialActiveAsync(material, GetChecked(args));

    private async Task CopyMaterialAsync(Material material)
    {
        await RunAsync(async () =>
        {
            var copy = await CompanyAdminService.CopyMaterialAsync(companyId, material.Id);
            message = $"{material.Name} was copied to {copy.Name}.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        message = null;
        errorMessage = null;

        try
        {
            await action();
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadAsync()
    {
        catalog = await CompanyAdminService.GetCatalogOverviewAsync(companyId);
    }

    private void EditCategory(MaterialCategory category)
    {
        categoryForm = MaterialCategoryForm.FromCategory(category);
        categoryEditorExpanded = true;
        categoryListExpanded = true;
    }

    private void EditMaterial(Material material)
    {
        materialForm = MaterialForm.FromMaterial(material);
        materialEditorExpanded = true;
        materialListExpanded = true;
    }

    private void ResetCategoryForm() => categoryForm = new();

    private void ResetMaterialForm() => materialForm = new();

    private void ShowCreateCategory()
    {
        ResetCategoryForm();
        categoryEditorExpanded = true;
        categoryListExpanded = true;
    }

    private void ShowCreateMaterial()
    {
        ResetMaterialForm();
        materialEditorExpanded = true;
        materialListExpanded = true;
    }

    private void HideCategoryEditor()
    {
        ResetCategoryForm();
        categoryEditorExpanded = false;
    }

    private void HideMaterialEditor()
    {
        ResetMaterialForm();
        materialEditorExpanded = false;
    }

    private void ToggleCategoryList() => categoryListExpanded = !categoryListExpanded;

    private void ToggleMaterialList() => materialListExpanded = !materialListExpanded;

    private void SortCategories(CategorySortColumn column)
    {
        if (categorySortColumn == column)
        {
            categorySortDescending = !categorySortDescending;
        }
        else
        {
            categorySortColumn = column;
            categorySortDescending = false;
        }
    }

    private void SortMaterials(MaterialSortColumn column)
    {
        if (materialSortColumn == column)
        {
            materialSortDescending = !materialSortDescending;
        }
        else
        {
            materialSortColumn = column;
            materialSortDescending = false;
        }
    }

    private string GetCategorySortIndicator(CategorySortColumn column) =>
        categorySortColumn == column ? (categorySortDescending ? "v" : "^") : "";

    private string GetMaterialSortIndicator(MaterialSortColumn column) =>
        materialSortColumn == column ? (materialSortDescending ? "v" : "^") : "";

    private IReadOnlyList<MaterialCategoryGroup> GetFilteredCategoryGroups()
    {
        var groups = catalog?.MaterialGroups ?? [];
        var filtered = groups.Where(group => MatchesCategoryFilter(group.Category));
        filtered = categorySortColumn switch
        {
            CategorySortColumn.Active => ApplyCategorySort(filtered, group => group.Category.IsActive ? "1" : "0"),
            CategorySortColumn.Category => ApplyCategorySort(filtered, group => group.Category.Name),
            CategorySortColumn.Description => ApplyCategorySort(filtered, group => group.Category.Description),
            _ => filtered
        };

        return filtered.ToList();
    }

    private IReadOnlyList<MaterialGridRow> GetFilteredMaterialRows()
    {
        var rows = (catalog?.MaterialGroups ?? [])
            .SelectMany(group => group.Materials.Select(material => new MaterialGridRow(group.Category, material)))
            .Where(MatchesMaterialFilter);

        rows = materialSortColumn switch
        {
            MaterialSortColumn.Active => ApplyMaterialSort(rows, row => row.Material.IsActive ? "1" : "0"),
            MaterialSortColumn.Brand => ApplyMaterialSort(rows, row => row.Material.Brand),
            MaterialSortColumn.Name => ApplyMaterialSort(rows, row => row.Material.Name),
            MaterialSortColumn.Category => ApplyMaterialSort(rows, row => row.Category.Name),
            MaterialSortColumn.ModelNo => ApplyMaterialSort(rows, row => row.Material.ModelNo),
            MaterialSortColumn.Unit => ApplyMaterialSort(rows, row => row.Material.UnitOfMeasure),
            MaterialSortColumn.Price => materialSortDescending
                ? rows.OrderByDescending(row => row.Material.DefaultBillableUnitPrice)
                : rows.OrderBy(row => row.Material.DefaultBillableUnitPrice),
            _ => rows
        };

        return rows.ToList();
    }

    private IEnumerable<MaterialCategoryGroup> ApplyCategorySort(
        IEnumerable<MaterialCategoryGroup> groups,
        Func<MaterialCategoryGroup, string> keySelector) =>
        categorySortDescending
            ? groups.OrderByDescending(keySelector, StringComparer.OrdinalIgnoreCase)
            : groups.OrderBy(keySelector, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<MaterialGridRow> ApplyMaterialSort(
        IEnumerable<MaterialGridRow> rows,
        Func<MaterialGridRow, string> keySelector) =>
        materialSortDescending
            ? rows.OrderByDescending(keySelector, StringComparer.OrdinalIgnoreCase)
            : rows.OrderBy(keySelector, StringComparer.OrdinalIgnoreCase);

    private bool MatchesCategoryFilter(MaterialCategory category)
    {
        if (string.IsNullOrWhiteSpace(categoryFilter))
        {
            return true;
        }

        return ContainsFilter(category.IsActive ? "active" : "inactive", categoryFilter) ||
            ContainsFilter(category.Name, categoryFilter) ||
            ContainsFilter(category.Description, categoryFilter);
    }

    private bool MatchesMaterialFilter(MaterialGridRow row)
    {
        if (string.IsNullOrWhiteSpace(materialFilter))
        {
            return true;
        }

        return ContainsFilter(row.Material.IsActive ? "active" : "inactive", materialFilter) ||
            ContainsFilter(row.Material.Brand, materialFilter) ||
            ContainsFilter(row.Material.Name, materialFilter) ||
            ContainsFilter(row.Category.Name, materialFilter) ||
            ContainsFilter(row.Material.ModelNo, materialFilter) ||
            ContainsFilter(row.Material.UnitOfMeasure, materialFilter) ||
            ContainsFilter(row.Material.DefaultBillableUnitPrice.ToString("C"), materialFilter);
    }

    private static bool ContainsFilter(string? value, string filter) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase);

    private string GetCategoryRowKey() =>
        categoryForm.IsEditing
            ? categoryForm.Id
            : categoryForm.Name;

    private string GetMaterialRowKey()
    {
        if (materialForm.IsEditing)
        {
            return materialForm.Id;
        }

        return string.IsNullOrWhiteSpace(materialForm.ModelNo)
            ? $"{materialForm.Brand} {materialForm.Name}"
            : $"{materialForm.Brand} {materialForm.Name} {materialForm.ModelNo}";
    }

    private static bool GetChecked(ChangeEventArgs args) =>
        args.Value is bool value && value;

    private sealed record MaterialGridRow(MaterialCategory Category, Material Material);

    private enum CategorySortColumn
    {
        Active,
        Category,
        Description
    }

    private enum MaterialSortColumn
    {
        Active,
        Brand,
        Name,
        Category,
        ModelNo,
        Unit,
        Price
    }

    private sealed class MaterialCategoryForm
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsSystemManaged { get; set; }
        public bool IsActive { get; set; } = true;
        public bool IsEditing { get; set; }

        public static MaterialCategoryForm FromCategory(MaterialCategory category) => new()
        {
            Id = category.Id,
            Name = category.Name,
            Description = category.Description,
            IsSystemManaged = category.IsSystemManaged,
            IsActive = category.IsActive,
            IsEditing = true
        };
    }

    private sealed class MaterialForm
    {
        public string Id { get; set; } = "";
        public string? CategoryId { get; set; }
        public string Brand { get; set; } = "";
        public string Name { get; set; } = "";
        public string ModelNo { get; set; } = "";
        public string UnitOfMeasure { get; set; } = "";
        public decimal DefaultUnitCost { get; set; }
        public decimal DefaultBillableUnitPrice { get; set; }
        public bool IsTaxable { get; set; } = true;
        public bool IsActive { get; set; } = true;
        public bool IsEditing { get; set; }

        public static MaterialForm FromMaterial(Material material) => new()
        {
            Id = material.Id,
            CategoryId = material.CategoryId,
            Brand = material.Brand,
            Name = material.Name,
            ModelNo = material.ModelNo,
            UnitOfMeasure = material.UnitOfMeasure,
            DefaultUnitCost = material.DefaultUnitCost,
            DefaultBillableUnitPrice = material.DefaultBillableUnitPrice,
            IsTaxable = material.IsTaxable,
            IsActive = material.IsActive,
            IsEditing = true
        };
    }

    private static async Task<IReadOnlyList<MaterialSeedRow>> ReadSeedRowsAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024);
        using var reader = new StreamReader(stream);
        var text = await reader.ReadToEndAsync();
        var records = ParseCsv(text);

        if (records.Count == 0)
        {
            return [];
        }

        var header = records[0];
        if (header.Count < 4 ||
            !string.Equals(header[0], "Brand", StringComparison.OrdinalIgnoreCase) ||
            !string.Equals(header[1], "Category", StringComparison.OrdinalIgnoreCase) ||
            !string.Equals(header[2], "Name", StringComparison.OrdinalIgnoreCase) ||
            !string.Equals(header[3], "Model No", StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException("Seed CSV must include Brand, Category, Name, and Model No columns.");
        }

        return records
            .Skip(1)
            .Where(record => record.Any(value => !string.IsNullOrWhiteSpace(value)))
            .Select(record => new MaterialSeedRow(
                GetCsvValue(record, 0),
                GetCsvValue(record, 1),
                GetCsvValue(record, 2),
                GetCsvValue(record, 3)))
            .ToList();
    }

    private static string GetCsvValue(IReadOnlyList<string> record, int index) =>
        index < record.Count ? record[index] : "";

    private static IReadOnlyList<IReadOnlyList<string>> ParseCsv(string text)
    {
        var records = new List<IReadOnlyList<string>>();
        var fields = new List<string>();
        var field = new StringBuilder();
        var inQuotes = false;

        for (var i = 0; i < text.Length; i++)
        {
            var ch = text[i];
            if (ch == '"')
            {
                if (inQuotes && i + 1 < text.Length && text[i + 1] == '"')
                {
                    field.Append('"');
                    i++;
                }
                else
                {
                    inQuotes = !inQuotes;
                }
            }
            else if (ch == ',' && !inQuotes)
            {
                fields.Add(field.ToString().Trim());
                field.Clear();
            }
            else if ((ch == '\r' || ch == '\n') && !inQuotes)
            {
                if (ch == '\r' && i + 1 < text.Length && text[i + 1] == '\n')
                {
                    i++;
                }

                fields.Add(field.ToString().Trim());
                field.Clear();
                records.Add(fields.ToList());
                fields.Clear();
            }
            else
            {
                field.Append(ch);
            }
        }

        if (field.Length > 0 || fields.Count > 0)
        {
            fields.Add(field.ToString().Trim());
            records.Add(fields.ToList());
        }

        return records;
    }
}
