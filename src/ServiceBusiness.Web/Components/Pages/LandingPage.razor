@page "/"
@inject ServiceBusiness.Web.ApplicationModeService ApplicationMode

<PageTitle>@appMode.ProductName</PageTitle>

<section class="landing-hero" style="background-image: linear-gradient(90deg, rgba(13, 30, 26, .78), rgba(13, 30, 26, .34), rgba(13, 30, 26, .08)), url('@appMode.HeroImageUrl');">
    <div class="landing-copy">
        <p class="eyebrow">@appMode.ProductCategory</p>
        <h1>@appMode.ProductName</h1>
        <p>Manage clients, recurring service, field visits, completion notes, and client access from one tenant-aware workspace.</p>
        <div class="landing-actions">
            <a class="button primary" href="signin">Sign In</a>
            <a class="button light" href="register">Register</a>
        </div>
    </div>
</section>

@code {
    private ServiceBusiness.Web.ApplicationModeSnapshot appMode = ServiceBusiness.Web.ApplicationModeSnapshot.Pool;

    protected override async Task OnInitializedAsync()
    {
        appMode = await ApplicationMode.GetCurrentAsync();
    }
}

<section class="landing-band">
    <div>
        <h2>Built for service businesses</h2>
        <p>Owners approve staff and client access, crews see their daily work, and homeowners get a simple service history view.</p>
    </div>
    <div class="landing-feature-grid">
        <article>
            <strong>Business owners</strong>
            <span>Configure companies, services, clients, users, and schedules.</span>
        </article>
        <article>
            <strong>Business users</strong>
            <span>Work from an assigned daily route and complete visits in the field.</span>
        </article>
        <article>
            <strong>Business clients</strong>
            <span>Access upcoming work, completed service history, and account updates.</span>
        </article>
    </div>
</section>
