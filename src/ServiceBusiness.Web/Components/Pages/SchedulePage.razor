@page "/schedule"
@rendermode InteractiveServer
@using ServiceBusiness.Domain
@inject ServiceBusiness.Application.CompanyAdminService CompanyAdminService
@inject ServiceBusiness.Web.CurrentCompanyContext CurrentCompany

<PageTitle>Schedule</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Company Admin</p>
        <h1>Schedule</h1>
        <p class="lede">Visits for @selectedDate.ToLongDateString().</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice">@message</div>
}

@if (visits is null || clients is null)
{
    <p>Loading schedule...</p>
}
else
{
    <div class="data-list">
        @foreach (var visit in visits)
        {
            var client = clients.First(c => c.Id == visit.CompanyClientId);
            <article class="row-card">
                <div>
                    <strong>@client.DisplayName</strong>
                    <p>@visit.ServiceWindowStart.ToShortTimeString() - @visit.ServiceWindowEnd.ToShortTimeString() · @client.ServiceAddress</p>
                    <small>@visit.Notes</small>
                </div>
                <div class="row-actions">
                    <span class="status-pill">@visit.Status</span>
                    @if (string.IsNullOrWhiteSpace(visit.AssignedUserId) && defaultAssignee is not null)
                    {
                        <button class="button" @onclick="() => AssignVisit(visit.Id)">Assign to @defaultAssignee.User.DisplayName</button>
                    }
                </div>
            </article>
        }
    </div>
}

@code {
    private DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private IReadOnlyList<ServiceVisit>? visits;
    private IReadOnlyList<CompanyClient>? clients;
    private CompanyUserManagementRow? defaultAssignee;
    private string companyId = "";
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        companyId = await CurrentCompany.GetRequiredCompanyIdAsync([CompanyRole.CompanyAdmin]);
        await LoadAsync();
    }

    private async Task AssignVisit(string visitId)
    {
        if (defaultAssignee is null)
        {
            message = "No active company user is available for assignment.";
            return;
        }

        await CompanyAdminService.AssignVisitAsync(companyId, visitId, defaultAssignee.User.Id);
        message = $"Visit assigned to {defaultAssignee.User.DisplayName}.";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        visits = await CompanyAdminService.GetScheduleAsync(companyId, selectedDate);
        clients = await CompanyAdminService.GetClientsAsync(companyId);
        var usersOverview = await CompanyAdminService.GetCompanyUserManagementOverviewAsync(companyId);
        defaultAssignee = usersOverview.Users
            .Where(row =>
                row.Membership.Role == CompanyRole.CompanyUser &&
                row.Membership.Status == MembershipStatus.Active)
            .OrderBy(row => row.User.DisplayName)
            .FirstOrDefault();
    }
}
