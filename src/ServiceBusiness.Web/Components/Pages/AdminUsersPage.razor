@page "/admin/users"
@rendermode InteractiveServer
@using ServiceBusiness.Domain
@inject ServiceBusiness.Application.ICurrentUserContext CurrentUser
@inject ServiceBusiness.Application.PlatformAdminService PlatformAdminService
@inject ServiceBusiness.Web.DemoCurrentUserContext DemoUser
@inject ServiceBusiness.Web.ApplicationModeService ApplicationMode

<PageTitle>Users</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">System Administrator</p>
        <h1>Users</h1>
        <p class="lede">Manage registered users, system-admin access, status, and company memberships.</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice error">@errorMessage</div>
}

@if (userOverview is null)
{
    <p>Loading users...</p>
}
else
{
    <div class="metric-grid">
        <div class="metric">
            <span>Users</span>
            <strong>@FilteredUserRows.Count</strong>
        </div>
        <div class="metric">
            <span>Active</span>
            <strong>@FilteredUserRows.Count(row => row.User.Status == UserStatus.Active)</strong>
        </div>
        <div class="metric">
            <span>System Admins</span>
            <strong>@FilteredUserRows.Count(row => row.User.IsSystemAdmin)</strong>
        </div>
        <div class="metric">
            <span>Pending Access</span>
            <strong>@FilteredUserRows.Sum(row => row.PendingMembershipCount)</strong>
        </div>
        <div class="metric">
            <span>Disabled</span>
            <strong>@FilteredUserRows.Count(row => row.User.Status == UserStatus.Disabled)</strong>
        </div>
    </div>

    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Users</h2>
            <div class="management-panel-actions">
                <button class="icon-button" type="button" title="Toggle users" @onclick="ToggleUsers">@(usersExpanded ? "^" : "v")</button>
            </div>
        </div>
        @if (usersExpanded)
        {
            <div class="management-panel-body">
                @if (userEditorExpanded)
                {
                    <EditForm Model="userForm" OnValidSubmit="SaveUserAsync" FormName="user-editor">
                        <div class="editor-panel">
                            <h3>Edit User</h3>
                            <div class="form-grid">
                                <label>
                                    Display name
                                    <InputText class="form-control" @bind-Value="userForm.DisplayName" />
                                </label>
                                <label>
                                    Login email
                                    <InputText class="form-control" @bind-Value="userForm.Email" />
                                </label>
                                <label>
                                    Notification email
                                    <InputText class="form-control" @bind-Value="userForm.NotificationEmail" />
                                </label>
                                <label>
                                    Phone
                                    <InputText class="form-control" @bind-Value="userForm.Phone" />
                                </label>
                                <label class="check-row">
                                    <InputCheckbox @bind-Value="userForm.IsTestUser" />
                                    <span>Test user</span>
                                </label>
                                <label class="check-row">
                                    <InputCheckbox @bind-Value="userForm.EmailNotificationsEnabled" />
                                    <span>Email notifications</span>
                                </label>
                                @if (userForm.HasHomeOwnerSubscription)
                                {
                                    <label>
                                        Trial end date
                                        <InputDate class="form-control" @bind-Value="userForm.TrialEndsAt" />
                                    </label>
                                }
                            </div>
                            <div class="form-actions">
                                <button class="button primary" type="submit">Save User</button>
                                <button class="button" type="button" @onclick="HideUserEditor">Cancel</button>
                            </div>
                        </div>
                    </EditForm>
                }
                <div class="management-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Flags</th>
                                <th>Company</th>
                                <th>Subscription</th>
                                <th>Trial Ends</th>
                                <th>User Type</th>
                                <th>Approved</th>
                                <th>Sys Admin</th>
                                <th class="actions">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in FilteredUserRows)
                            {
                                var primaryAccess = GetPrimaryAccess(row);
                                var userTypeKey = primaryAccess is null ? "" : RoleEditKey(row, primaryAccess);
                                var isCurrentUser = IsCurrentUser(row.User);
                                <tr>
                                    <td>
                                        <label class="switch-control" title="Toggle active state">
                                            <input type="checkbox" checked="@(row.User.Status == UserStatus.Active)" disabled="@isCurrentUser" @onchange="args => SetUserStatusAsync(row.User, GetChecked(args) ? UserStatus.Active : UserStatus.Disabled)" />
                                            <span></span>
                                        </label>
                                    </td>
                                    <td>@row.User.DisplayName</td>
                                    <td>@row.User.Email</td>
                                    <td>@GetUserFlags(row.User)</td>
                                    <td>@GetCompanyAccessLabel(row)</td>
                                    <td>@GetSubscriptionLabel(row)</td>
                                    <td>@GetTrialEndLabel(row)</td>
                                    <td>
                                        @if (primaryAccess is null)
                                        {
                                            <span>-</span>
                                        }
                                        else
                                        {
                                            <select class="form-control compact-select" @bind="roleEdits[userTypeKey]" disabled="@isCurrentUser">
                                                @foreach (var role in userOverview.Roles)
                                                {
                                                    <option value="@role.Role">@role.DisplayName</option>
                                                }
                                            </select>
                                        }
                                    </td>
                                    <td>
                                        @if (primaryAccess is null)
                                        {
                                            <span>-</span>
                                        }
                                        else
                                        {
                                            <label class="switch-control" title="Toggle approval state">
                                                <input type="checkbox" checked="@(primaryAccess.Status == MembershipStatus.Active)" disabled="@isCurrentUser" @onchange="args => SetPrimaryAccessApprovalAsync(row, GetChecked(args))" />
                                                <span></span>
                                            </label>
                                        }
                                    </td>
                                    <td>
                                        <label class="switch-control" title="Toggle system admin access">
                                            <input type="checkbox" checked="@row.User.IsSystemAdmin" disabled="@isCurrentUser" @onchange="args => SetSystemAdminAsync(row.User, GetChecked(args))" />
                                            <span></span>
                                        </label>
                                    </td>
                                    <td class="actions">
                                        @if (primaryAccess is not null)
                                        {
                                            <button class="icon-button icon-only" type="button" title="Update user type" aria-label="Update user type" disabled="@isCurrentUser" @onclick="() => UpdatePrimaryAccessRoleAsync(row, primaryAccess)">
                                                <span class="action-icon edit-icon" aria-hidden="true"></span>
                                            </button>
                                        }
                                        @if (!isCurrentUser)
                                        {
                                            <button class="icon-button icon-only" type="button" title="Edit user" aria-label="Edit user" @onclick="() => EditUser(row.User)">
                                                <span class="action-icon edit-icon" aria-hidden="true"></span>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                    </div>
        }
    </section>
}

@code {
    private PlatformUserManagementOverview? userOverview;
    private UserForm userForm = new();
    private IReadOnlyList<CompanyType> companyTypes = [];
    private readonly Dictionary<string, CompanyRole> roleEdits = [];
    private bool usersExpanded = true;
    private bool userEditorExpanded;
    private string? message;
    private string? errorMessage;
    private string currentUserId = "";
    private ServiceBusiness.Web.ApplicationModeSnapshot appMode = ServiceBusiness.Web.ApplicationModeSnapshot.Pool;
    private IReadOnlyList<UserManagementRow> FilteredUserRows => userOverview?.Users.Where(UserMatchesMode).ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        DemoUser.UserId = "sys-admin";
        currentUserId = CurrentUser.UserId;
        appMode = await ApplicationMode.GetCurrentAsync();
        await LoadAsync();
    }

    private async Task SetSystemAdminAsync(AppUser user, bool isSystemAdmin)
    {
        await RunUserActionAsync(async () =>
        {
            await PlatformAdminService.SetSystemAdminAsync(user.Id, isSystemAdmin);
            message = isSystemAdmin
                ? $"{user.DisplayName} is now a system admin."
                : $"{user.DisplayName} is no longer a system admin.";
        });
    }

    private async Task SaveUserAsync()
    {
        await RunUserActionAsync(async () =>
        {
            await PlatformAdminService.UpdateUserAsync(
                userForm.UserId,
                userForm.DisplayName,
                userForm.Email,
                userForm.NotificationEmail,
                userForm.Phone,
                userForm.IsTestUser,
                userForm.EmailNotificationsEnabled);

            if (userForm.HasHomeOwnerSubscription)
            {
                await PlatformAdminService.UpdateHomeOwnerSubscriptionTrialEndAsync(
                    userForm.UserId,
                    userForm.TrialEndsAt is null
                        ? null
                        : new DateTimeOffset(userForm.TrialEndsAt.Value.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero));
            }

            message = $"{userForm.DisplayName} was saved.";
            ResetUserForm();
            userEditorExpanded = false;
        });
    }

    private async Task SetUserStatusAsync(AppUser user, UserStatus status)
    {
        await RunUserActionAsync(async () =>
        {
            await PlatformAdminService.SetUserStatusAsync(user.Id, status);
            message = $"{user.DisplayName} is now {status.ToString().ToLowerInvariant()}.";
        });
    }

    private async Task RunUserActionAsync(Func<Task> action)
    {
        message = null;
        errorMessage = null;

        try
        {
            await action();
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadAsync()
    {
        userOverview = await PlatformAdminService.GetUserManagementOverviewAsync();
        companyTypes = await PlatformAdminService.GetCompanyTypesAsync();
        roleEdits.Clear();
        foreach (var row in userOverview.Users)
        {
            var primaryAccess = GetPrimaryAccess(row);
            if (primaryAccess is not null)
            {
                roleEdits[RoleEditKey(row, primaryAccess)] = primaryAccess.Role;
            }
        }
    }

    private void EditUser(AppUser user)
    {
        var row = userOverview?.Users.FirstOrDefault(row => string.Equals(row.User.Id, user.Id, StringComparison.OrdinalIgnoreCase));
        userForm = UserForm.FromUser(user, row?.HomeOwnerSubscription);
        userEditorExpanded = true;
        usersExpanded = true;
    }

    private void ResetUserForm()
    {
        userForm = new UserForm();
    }

    private async Task SetPrimaryAccessApprovalAsync(UserManagementRow row, bool isApproved)
    {
        var access = GetPrimaryAccess(row);
        if (access is null)
        {
            return;
        }

        await RunUserActionAsync(async () =>
        {
            await PlatformAdminService.SetCompanyMembershipApprovalAsync(
                access.Company.Id,
                row.User.Id,
                access.Role,
                isApproved);
            message = $"{row.User.DisplayName} approval was updated.";
        });
    }

    private async Task UpdatePrimaryAccessRoleAsync(UserManagementRow row, CompanyAccess access)
    {
        await RunUserActionAsync(async () =>
        {
            var newRole = roleEdits[RoleEditKey(row, access)];
            await PlatformAdminService.UpdateCompanyMembershipRoleAsync(
                access.Company.Id,
                row.User.Id,
                access.Role,
                newRole);
            message = $"{row.User.DisplayName} user type was updated to {GetRoleDisplayName(newRole)}.";
        });
    }

    private void HideUserEditor()
    {
        ResetUserForm();
        userEditorExpanded = false;
    }

    private void ToggleUsers() => usersExpanded = !usersExpanded;

    private static string GetUserFlags(AppUser user)
    {
        var flags = new List<string>();
        if (user.IsSystemAdmin)
        {
            flags.Add("System Admin");
        }

        if (user.IsTestUser)
        {
            flags.Add("Test User");
        }

        return flags.Count == 0 ? "-" : string.Join(", ", flags);
    }

    private CompanyAccess? GetPrimaryAccess(UserManagementRow row) =>
        row.CompanyAccess
            .Where(access => access.Status != MembershipStatus.Removed && CompanyMatchesMode(access.Company))
            .OrderByDescending(access => access.Status == MembershipStatus.Active)
            .ThenByDescending(access => access.Status == MembershipStatus.Pending)
            .ThenBy(access => access.Company.Name)
            .FirstOrDefault();

    private string GetCompanyAccessLabel(UserManagementRow row)
    {
        var activeAccess = row.CompanyAccess
            .Where(access => access.Status != MembershipStatus.Removed && CompanyMatchesMode(access.Company))
            .Select(access => $"{access.Company.Name}: {access.Role}");
        return string.Join(", ", activeAccess.DefaultIfEmpty("-"));
    }

    private static string GetSubscriptionLabel(UserManagementRow row)
    {
        if (row.HomeOwnerSubscription is null)
        {
            return "-";
        }

        var plan = row.HomeOwnerSubscriptionPlan?.Name ?? row.HomeOwnerSubscription.PlanId;
        return $"{plan}: {row.HomeOwnerSubscription.Status}";
    }

    private static string GetTrialEndLabel(UserManagementRow row) =>
        row.HomeOwnerSubscription?.TrialEndsAt?.LocalDateTime.ToString("d") ?? "-";

    private bool UserMatchesMode(UserManagementRow row)
    {
        if (row.User.IsSystemAdmin || row.CompanyAccess.Count == 0)
        {
            return true;
        }

        return row.CompanyAccess.Any(access => access.Status != MembershipStatus.Removed && CompanyMatchesMode(access.Company));
    }

    private bool CompanyMatchesMode(Company company)
    {
        var type = companyTypes.FirstOrDefault(t => string.Equals(t.Id, company.CompanyTypeId, StringComparison.OrdinalIgnoreCase));
        var searchable = type is null
            ? company.CompanyTypeId
            : $"{company.CompanyTypeId} {type.Name} {type.Description}";
        return appMode.IsPoolMode
            ? searchable.Contains("pool", StringComparison.OrdinalIgnoreCase)
            : ContainsAny(searchable, "landscape", "landscaping", "lawn", "yard", "tree");
    }

    private static bool ContainsAny(string value, params string[] terms) =>
        terms.Any(term => value.Contains(term, StringComparison.OrdinalIgnoreCase));

    private static bool GetChecked(ChangeEventArgs args) => args.Value is bool value && value;

    private bool IsCurrentUser(AppUser user) =>
        string.Equals(user.Id, currentUserId, StringComparison.OrdinalIgnoreCase);

    private static string RoleEditKey(UserManagementRow row, CompanyAccess access) =>
        $"{row.User.Id}|{access.Company.Id}|{access.Role}";

    private string GetRoleDisplayName(CompanyRole role) =>
        userOverview?.Roles.FirstOrDefault(r => r.Role == role)?.DisplayName ?? role.ToString();

    private sealed class UserForm
    {
        public string UserId { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string Email { get; set; } = "";
        public string? NotificationEmail { get; set; }
        public string? Phone { get; set; }
        public bool IsTestUser { get; set; }
        public bool EmailNotificationsEnabled { get; set; } = true;
        public bool IsEditing { get; set; }
        public bool HasHomeOwnerSubscription { get; set; }
        public DateOnly? TrialEndsAt { get; set; }

        public static UserForm FromUser(AppUser user, HomeOwnerSubscription? subscription = null) => new()
        {
            UserId = user.Id,
            DisplayName = user.DisplayName,
            Email = user.Email,
            NotificationEmail = user.NotificationEmail,
            Phone = user.Phone,
            IsTestUser = user.IsTestUser,
            EmailNotificationsEnabled = user.EmailNotificationsEnabled ?? true,
            IsEditing = true,
            HasHomeOwnerSubscription = subscription is not null,
            TrialEndsAt = subscription?.TrialEndsAt is null
                ? null
                : DateOnly.FromDateTime(subscription.TrialEndsAt.Value.UtcDateTime)
        };
    }
}
