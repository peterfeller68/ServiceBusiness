@page "/signin"
@rendermode InteractiveServer
@inject IConfiguration Configuration
@inject ServiceBusiness.Application.IServiceBusinessStore Store
@inject NavigationManager Navigation

<PageTitle>Sign In</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Sign in</p>
        <h1>Access your workspace</h1>
        <p class="lede">Use Google for real accounts, or choose a seeded test user for local development.</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice error">@errorMessage</div>
}

<EditForm Model="form" OnValidSubmit="SignInAsync" FormName="signin">
    <div class="auth-panel">
        <a class="button primary auth-button" href="auth/google?returnUrl=/dashboard">Sign in with Google</a>
        @if (devTest)
        {
            <div class="auth-divider">Test users</div>
            <label>
                Test user id or email
                <InputText class="form-control" @bind-Value="form.UserIdentifier" placeholder="pool1clean1-owner-1" />
            </label>
        }
        <div class="form-actions">
            @if (devTest)
            {
                <button class="button" type="submit">Skip Google Auth</button>
            }
            <a class="button" href="register">Register</a>
        </div>
        @if (devTest)
        {
            <p class="form-note">Seeded test users can skip Gmail authentication. Demo accounts include demo-owner-1, owner-1@demo.example, and homeowner-1@independent.com.</p>
        }
    </div>
</EditForm>

@code {
    private readonly SignInForm form = new();
    private string? errorMessage;
    private bool devTest;

    protected override async Task OnInitializedAsync()
    {
        devTest = await SystemSettingsConfiguration.IsDevTestEnabledAsync(Configuration, Store);
    }

    private async Task SignInAsync()
    {
        if (!devTest)
        {
            errorMessage = "Test mode is not enabled. Use Google sign-in.";
            return;
        }

        if (string.IsNullOrWhiteSpace(form.UserIdentifier))
        {
            errorMessage = "Enter a seeded test user id or email, or use Google sign-in.";
            return;
        }

        var userIdentifier = Uri.EscapeDataString(form.UserIdentifier);
        Navigation.NavigateTo($"auth/test-signin?email={userIdentifier}&returnUrl=/dashboard", forceLoad: true);
        await Task.CompletedTask;
    }

    private sealed class SignInForm
    {
        public string UserIdentifier { get; set; } = "";
    }
}
