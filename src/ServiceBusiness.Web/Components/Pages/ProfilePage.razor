@page "/profile"
@rendermode InteractiveServer
@using ServiceBusiness.Application
@using ServiceBusiness.Domain
@inject UserProfileService ProfileService
@inject OnboardingService OnboardingService
@inject IndependentHomeOwnerService HomeOwnerService
@inject SubscriptionService SubscriptionService
@inject IConfiguration Configuration

<PageTitle>Profile</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Account Profile</p>
        <h1>@(form?.DisplayName ?? "Profile")</h1>
        <p class="lede">Manage contact details used for notifications and account display.</p>
    </div>
    <a class="button" href="auth/signout" data-enhance-nav="false">Logout</a>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice error">@errorMessage</div>
}

@if (form is null)
{
    <p>Loading profile...</p>
}
else
{
    <section class="section split">
        <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="profile-form">
            <div class="form-panel">
                <h2>Profile Details</h2>
                <label>
                    Display name
                    <InputText class="form-control" @bind-Value="form.DisplayName" />
                </label>
                <label>
                    Login email
                    <input class="form-control" value="@form.Email" disabled />
                </label>
                <label>
                    Notification email
                    <InputText class="form-control" @bind-Value="form.NotificationEmail" />
                </label>
                <label class="check-row">
                    <InputCheckbox @bind-Value="form.EmailNotificationsEnabled" />
                    Email notifications
                </label>
                <label>
                    Phone
                    <InputText class="form-control" @bind-Value="form.Phone" />
                </label>
                @if (isIndependentHomeOwner)
                {
                    <label class="wide">
                        Address
                        <InputText class="form-control" @bind-Value="form.HomeAddress" />
                    </label>
                    <label class="wide">
                        Access notes
                        <InputTextArea class="form-control" @bind-Value="form.AccessNotes" />
                    </label>
                    <label class="wide">
                        General Notes
                        <InputTextArea class="form-control" @bind-Value="form.GeneralNotes" />
                    </label>
                }
                <div class="form-actions">
                    <button class="button primary" type="submit">Save Profile</button>
                </div>
            </div>
        </EditForm>

        <aside class="callout profile-summary">
            @if (!string.IsNullOrWhiteSpace(form.ProfileImageUrl))
            {
                <img src="@form.ProfileImageUrl" alt="" />
            }
            <strong>@form.DisplayName</strong>
            <p>@form.Email</p>
            <small>@form.Status</small>
            @if (isIndependentHomeOwner && homeOwnerSubscription is not null)
            {
                <hr />
                <strong>@(homeOwnerPlan?.Name ?? homeOwnerSubscription.PlanId)</strong>
                <p>@homeOwnerSubscription.Status</p>
                <small>@GetSubscriptionSummary()</small>
                @if (CanStartCheckout)
                {
                    <a class="button primary" href="billing/homeowner/checkout" data-enhance-nav="false">Start Checkout</a>
                }
                else if (CanManageBilling)
                {
                    <a class="button" href="billing/homeowner/portal" data-enhance-nav="false">Manage Billing</a>
                }
                else
                {
                    <small>Stripe checkout is not configured for this plan.</small>
                }
            }
        </aside>
    </section>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "billing")]
    public string? BillingStatus { get; set; }

    private ProfileForm? form;
    private bool isIndependentHomeOwner;
    private HomeOwnerSubscription? homeOwnerSubscription;
    private SubscriptionPlan? homeOwnerPlan;
    private IReadOnlyList<SubscriptionPlan> homeOwnerPlans = [];
    private string? message;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (string.Equals(BillingStatus, "checkout-returned", StringComparison.OrdinalIgnoreCase))
        {
            message = "Checkout returned. Subscription access updates after Stripe confirms the payment event.";
        }
        else if (string.Equals(BillingStatus, "checkout-canceled", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Checkout was canceled. You can start checkout again when you are ready.";
        }
        else if (string.Equals(BillingStatus, "checkout-unavailable", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Stripe checkout is not available for this subscription yet.";
        }
        else if (string.Equals(BillingStatus, "portal-unavailable", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Stripe billing management is not available for this subscription yet.";
        }

        var user = await ProfileService.GetCurrentProfileAsync();
        form = ProfileForm.FromUser(user);
        var overview = await OnboardingService.GetAccessOverviewAsync(user.Id);
        isIndependentHomeOwner = !overview.User.IsSystemAdmin && overview.Companies.Count == 0;
        if (isIndependentHomeOwner)
        {
            var profile = await HomeOwnerService.GetProfileAsync();
            form.HomeAddress = profile.HomeAddress;
            form.AccessNotes = profile.AccessNotes;
            form.GeneralNotes = profile.GeneralNotes;
            homeOwnerPlans = await SubscriptionService.GetAvailableHomeOwnerPlansAsync();
            homeOwnerSubscription = await SubscriptionService.GetCurrentHomeOwnerSubscriptionAsync();
            homeOwnerPlan = homeOwnerSubscription is null
                ? null
                : homeOwnerPlans.FirstOrDefault(plan => string.Equals(plan.Id, homeOwnerSubscription.PlanId, StringComparison.OrdinalIgnoreCase));
        }
    }

    private async Task SaveAsync()
    {
        if (form is null)
        {
            return;
        }

        message = null;
        errorMessage = null;

        try
        {
            if (isIndependentHomeOwner && string.IsNullOrWhiteSpace(form.HomeAddress))
            {
                throw new InvalidOperationException("Home address is required.");
            }

            var updated = await ProfileService.UpdateCurrentProfileAsync(
                form.DisplayName,
                form.NotificationEmail,
                form.Phone,
                form.EmailNotificationsEnabled);

            if (isIndependentHomeOwner)
            {
                await HomeOwnerService.UpdateGeneralSettingsAsync(
                    form.DisplayName,
                    form.Phone,
                    form.HomeAddress,
                    form.AccessNotes,
                    form.GeneralNotes);
            }

            form = ProfileForm.FromUser(updated);
            if (isIndependentHomeOwner)
            {
                var profile = await HomeOwnerService.GetProfileAsync();
                form.HomeAddress = profile.HomeAddress;
                form.AccessNotes = profile.AccessNotes;
                form.GeneralNotes = profile.GeneralNotes;
                homeOwnerSubscription = await SubscriptionService.GetCurrentHomeOwnerSubscriptionAsync();
                homeOwnerPlan = homeOwnerSubscription is null
                    ? null
                    : homeOwnerPlans.FirstOrDefault(plan => string.Equals(plan.Id, homeOwnerSubscription.PlanId, StringComparison.OrdinalIgnoreCase));
            }

            message = "Profile saved.";
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private string GetSubscriptionSummary()
    {
        if (homeOwnerSubscription is null)
        {
            return "No subscription";
        }

        var entitlement = SubscriptionService.HasActiveEntitlement(homeOwnerSubscription) ? "Access active" : "Access pending";
        if (homeOwnerSubscription.TrialEndsAt is not null)
        {
            return $"{entitlement}; trial ends {homeOwnerSubscription.TrialEndsAt.Value.LocalDateTime:d}";
        }

        return entitlement;
    }

    private bool CanStartCheckout =>
        homeOwnerSubscription is not null &&
        string.IsNullOrWhiteSpace(homeOwnerSubscription.ProviderCustomerId) &&
        HasConfiguredPrice(homeOwnerPlan);

    private bool CanManageBilling =>
        homeOwnerSubscription is not null &&
        !string.IsNullOrWhiteSpace(homeOwnerSubscription.ProviderCustomerId);

    private bool HasConfiguredPrice(SubscriptionPlan? plan)
    {
        if (plan is null)
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(plan.ProviderPriceId))
        {
            return true;
        }

        return plan.BillingInterval == SubscriptionBillingInterval.Annual
            ? !string.IsNullOrWhiteSpace(Configuration["Payment:Stripe:HomeOwnerAnnualPriceId"] ?? Configuration["Stripe:HomeOwnerAnnualPriceId"])
            : !string.IsNullOrWhiteSpace(Configuration["Payment:Stripe:HomeOwnerMonthlyPriceId"] ?? Configuration["Stripe:HomeOwnerMonthlyPriceId"]);
    }

    private sealed class ProfileForm
    {
        public string Email { get; init; } = "";
        public string DisplayName { get; set; } = "";
        public string? NotificationEmail { get; set; }
        public bool EmailNotificationsEnabled { get; set; } = true;
        public string? Phone { get; set; }
        public string HomeAddress { get; set; } = "";
        public string AccessNotes { get; set; } = "";
        public string GeneralNotes { get; set; } = "";
        public string? ProfileImageUrl { get; init; }
        public UserStatus Status { get; init; }

        public static ProfileForm FromUser(AppUser user) => new()
        {
            Email = user.Email,
            DisplayName = user.DisplayName,
            NotificationEmail = user.NotificationEmail,
            EmailNotificationsEnabled = user.EmailNotificationsEnabled ?? true,
            Phone = user.Phone,
            ProfileImageUrl = user.ProfileImageUrl,
            Status = user.Status
        };
    }
}
