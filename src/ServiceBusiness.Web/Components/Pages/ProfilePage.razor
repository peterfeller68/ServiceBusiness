@page "/profile"
@rendermode InteractiveServer
@using ServiceBusiness.Application
@using ServiceBusiness.Domain
@inject UserProfileService ProfileService
@inject OnboardingService OnboardingService
@inject IndependentHomeOwnerService HomeOwnerService

<PageTitle>Profile</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Account Profile</p>
        <h1>@(form?.DisplayName ?? "Profile")</h1>
        <p class="lede">Manage contact details used for notifications and account display.</p>
    </div>
    <a class="button" href="auth/signout" data-enhance-nav="false">Logout</a>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice error">@errorMessage</div>
}

@if (form is null)
{
    <p>Loading profile...</p>
}
else
{
    <section class="section split">
        <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="profile-form">
            <div class="form-panel">
                <h2>Profile Details</h2>
                <label>
                    Display name
                    <InputText class="form-control" @bind-Value="form.DisplayName" />
                </label>
                <label>
                    Login email
                    <input class="form-control" value="@form.Email" disabled />
                </label>
                <label>
                    Notification email
                    <InputText class="form-control" @bind-Value="form.NotificationEmail" />
                </label>
                <label class="check-row">
                    <InputCheckbox @bind-Value="form.EmailNotificationsEnabled" />
                    Email notifications
                </label>
                <label>
                    Phone
                    <InputText class="form-control" @bind-Value="form.Phone" />
                </label>
                @if (isIndependentHomeOwner)
                {
                    <label class="wide">
                        Address
                        <InputText class="form-control" @bind-Value="form.HomeAddress" />
                    </label>
                    <label class="wide">
                        Access notes
                        <InputTextArea class="form-control" @bind-Value="form.AccessNotes" />
                    </label>
                    <label class="wide">
                        General Notes
                        <InputTextArea class="form-control" @bind-Value="form.GeneralNotes" />
                    </label>
                }
                <div class="form-actions">
                    <button class="button primary" type="submit">Save Profile</button>
                </div>
            </div>
        </EditForm>

        <aside class="callout profile-summary">
            @if (!string.IsNullOrWhiteSpace(form.ProfileImageUrl))
            {
                <img src="@form.ProfileImageUrl" alt="" />
            }
            <strong>@form.DisplayName</strong>
            <p>@form.Email</p>
            <small>@form.Status</small>
        </aside>
    </section>
}

@code {
    private ProfileForm? form;
    private bool isIndependentHomeOwner;
    private string? message;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var user = await ProfileService.GetCurrentProfileAsync();
        form = ProfileForm.FromUser(user);
        var overview = await OnboardingService.GetAccessOverviewAsync(user.Id);
        isIndependentHomeOwner = !overview.User.IsSystemAdmin && overview.Companies.Count == 0;
        if (isIndependentHomeOwner)
        {
            var profile = await HomeOwnerService.GetProfileAsync();
            form.HomeAddress = profile.HomeAddress;
            form.AccessNotes = profile.AccessNotes;
            form.GeneralNotes = profile.GeneralNotes;
        }
    }

    private async Task SaveAsync()
    {
        if (form is null)
        {
            return;
        }

        message = null;
        errorMessage = null;

        try
        {
            if (isIndependentHomeOwner && string.IsNullOrWhiteSpace(form.HomeAddress))
            {
                throw new InvalidOperationException("Home address is required.");
            }

            var updated = await ProfileService.UpdateCurrentProfileAsync(
                form.DisplayName,
                form.NotificationEmail,
                form.Phone,
                form.EmailNotificationsEnabled);

            if (isIndependentHomeOwner)
            {
                await HomeOwnerService.UpdateGeneralSettingsAsync(
                    form.DisplayName,
                    form.Phone,
                    form.HomeAddress,
                    form.AccessNotes,
                    form.GeneralNotes);
            }

            form = ProfileForm.FromUser(updated);
            if (isIndependentHomeOwner)
            {
                var profile = await HomeOwnerService.GetProfileAsync();
                form.HomeAddress = profile.HomeAddress;
                form.AccessNotes = profile.AccessNotes;
                form.GeneralNotes = profile.GeneralNotes;
            }

            message = "Profile saved.";
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed class ProfileForm
    {
        public string Email { get; init; } = "";
        public string DisplayName { get; set; } = "";
        public string? NotificationEmail { get; set; }
        public bool EmailNotificationsEnabled { get; set; } = true;
        public string? Phone { get; set; }
        public string HomeAddress { get; set; } = "";
        public string AccessNotes { get; set; } = "";
        public string GeneralNotes { get; set; } = "";
        public string? ProfileImageUrl { get; init; }
        public UserStatus Status { get; init; }

        public static ProfileForm FromUser(AppUser user) => new()
        {
            Email = user.Email,
            DisplayName = user.DisplayName,
            NotificationEmail = user.NotificationEmail,
            EmailNotificationsEnabled = user.EmailNotificationsEnabled ?? true,
            Phone = user.Phone,
            ProfileImageUrl = user.ProfileImageUrl,
            Status = user.Status
        };
    }
}
