@page "/catalog"
@rendermode InteractiveServer
@using ServiceBusiness.Domain
@inject ServiceBusiness.Application.CompanyAdminService CompanyAdminService
@inject ServiceBusiness.Web.DemoCurrentUserContext DemoUser

<PageTitle>Catalog</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Company Admin</p>
        <h1>Services and materials</h1>
        <p class="lede">Manage company-scoped catalog items grouped by category.</p>
    </div>
</section>

@if (catalog is null)
{
    <p>Loading catalog...</p>
}
else
{
    <section class="section">
        <h2>Services</h2>
        <div class="category-grid">
            @foreach (var group in catalog.ServiceGroups)
            {
                <article class="form-panel">
                    <div class="category-heading">
                        <div>
                            <strong>@group.Category.Name</strong>
                            <p>@group.Category.Description</p>
                        </div>
                        @if (group.Category.IsSystemManaged)
                        {
                            <span class="status-pill">Starter</span>
                        }
                    </div>

                    @if (group.Services.Count == 0)
                    {
                        <p class="form-note">No services in this category yet.</p>
                    }
                    else
                    {
                        <div class="data-list">
                            @foreach (var service in group.Services)
                            {
                                <article class="row-card compact">
                                    <div>
                                        <strong>@service.Name</strong>
                                        <p>@service.Description</p>
                                    </div>
                                    <span class="price">@service.DefaultPrice.ToString("C")</span>
                                </article>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    </section>

    <section class="section">
        <h2>Materials</h2>
        <div class="category-grid">
            @foreach (var group in catalog.MaterialGroups)
            {
                <article class="form-panel">
                    <div class="category-heading">
                        <div>
                            <strong>@group.Category.Name</strong>
                            <p>@group.Category.Description</p>
                        </div>
                        @if (group.Category.IsSystemManaged)
                        {
                            <span class="status-pill">Starter</span>
                        }
                    </div>

                    @if (group.Materials.Count == 0)
                    {
                        <p class="form-note">No materials in this category yet.</p>
                    }
                    else
                    {
                        <div class="data-list">
                            @foreach (var material in group.Materials)
                            {
                                <article class="row-card compact">
                                    <div>
                                        <strong>@material.Name</strong>
                                        <p>@material.UnitOfMeasure - Cost @material.DefaultUnitCost.ToString("C")</p>
                                    </div>
                                    <span class="price">@material.DefaultBillableUnitPrice.ToString("C")</span>
                                </article>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    </section>
}

@code {
    private CatalogOverview? catalog;

    protected override async Task OnInitializedAsync()
    {
        DemoUser.UserId = "clearwater-owner-1";
        catalog = await CompanyAdminService.GetCatalogOverviewAsync("clearwater");
    }
}
