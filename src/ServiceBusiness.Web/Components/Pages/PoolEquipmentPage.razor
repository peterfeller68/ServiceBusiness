    private void SortCategories(CategorySortColumn column)
    {
        if (categorySortColumn == column)
        {
            categorySortDescending = !categorySortDescending;
        }
        else
        {
            categorySortColumn = column;
            categorySortDescending = false;
        }
    }

    private void SortEquipment(EquipmentSortColumn column)
    {
        if (equipmentSortColumn == column)
        {
            equipmentSortDescending = !equipmentSortDescending;
        }
        else
        {
            equipmentSortColumn = column;
            equipmentSortDescending = false;
        }
    }

    private string GetCategorySortIndicator(CategorySortColumn column) =>
