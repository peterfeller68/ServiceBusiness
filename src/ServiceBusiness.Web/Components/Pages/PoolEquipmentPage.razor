    private IReadOnlyList<PoolEquipmentCategoryGroup> GetFilteredCategoryGroups()
    {
        var groups = overview?.CategoryGroups ?? [];
        var filtered = groups.Where(group => MatchesCategoryFilter(group.Category));
        filtered = categorySortColumn switch
        {
            CategorySortColumn.Active => ApplyCategorySort(filtered, group => group.Category.IsActive ? "1" : "0"),
            CategorySortColumn.Category => ApplyCategorySort(filtered, group => group.Category.Name),
            CategorySortColumn.Description => ApplyCategorySort(filtered, group => group.Category.Description),
            _ => filtered
        };

        return filtered.ToList();
    }

    private IReadOnlyList<EquipmentGridRow> GetFilteredEquipmentRows()
    {
        var rows = (overview?.CategoryGroups ?? [])
            .SelectMany(group => group.Items.Select(item => new EquipmentGridRow(group.Category, item)))
            .Where(MatchesEquipmentFilter);

        rows = equipmentSortColumn switch
        {
            EquipmentSortColumn.Active => ApplyEquipmentSort(rows, row => row.Item.IsActive ? "1" : "0"),
            EquipmentSortColumn.Manufacturer => ApplyEquipmentSort(rows, row => row.Item.Manufacturer),
            EquipmentSortColumn.Name => ApplyEquipmentSort(rows, row => row.Item.Name),
            EquipmentSortColumn.Category => ApplyEquipmentSort(rows, row => row.Category.Name),
            EquipmentSortColumn.ModelNo => ApplyEquipmentSort(rows, row => row.Item.ModelNo),
            EquipmentSortColumn.Description => ApplyEquipmentSort(rows, row => row.Item.Description),
            _ => rows
        };

        return rows.ToList();
    }

    private IEnumerable<PoolEquipmentCategoryGroup> ApplyCategorySort(
        IEnumerable<PoolEquipmentCategoryGroup> groups,
        Func<PoolEquipmentCategoryGroup, string> keySelector) =>
        categorySortDescending
            ? groups.OrderByDescending(keySelector, StringComparer.OrdinalIgnoreCase)
            : groups.OrderBy(keySelector, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<EquipmentGridRow> ApplyEquipmentSort(
        IEnumerable<EquipmentGridRow> rows,
        Func<EquipmentGridRow, string> keySelector) =>
        equipmentSortDescending
            ? rows.OrderByDescending(keySelector, StringComparer.OrdinalIgnoreCase)
            : rows.OrderBy(keySelector, StringComparer.OrdinalIgnoreCase);

    private bool MatchesCategoryFilter(PoolEquipmentCategory category)
    {
        if (string.IsNullOrWhiteSpace(categoryFilter))
        {
            return true;
        }

        return ContainsFilter(category.IsActive ? "active" : "inactive", categoryFilter) ||
            ContainsFilter(category.Name, categoryFilter) ||
            ContainsFilter(category.Description, categoryFilter);
    }

    private bool MatchesEquipmentFilter(EquipmentGridRow row)
    {
        if (string.IsNullOrWhiteSpace(equipmentFilter))
        {
            return true;
        }

        return ContainsFilter(row.Item.IsActive ? "active" : "inactive", equipmentFilter) ||
            ContainsFilter(row.Item.Manufacturer, equipmentFilter) ||
            ContainsFilter(row.Item.Name, equipmentFilter) ||
            ContainsFilter(row.Category.Name, equipmentFilter) ||
            ContainsFilter(row.Item.ModelNo, equipmentFilter) ||
            ContainsFilter(row.Item.Description, equipmentFilter);
    }

    private bool MatchesGlobalEquipmentFilter(EquipmentGridRow row)
    {
        if (string.IsNullOrWhiteSpace(globalEquipmentFilter))
        {
            return true;
        }

        return ContainsFilter(row.Item.Manufacturer, globalEquipmentFilter) ||
            ContainsFilter(row.Item.Name, globalEquipmentFilter) ||
            ContainsFilter(row.Category.Name, globalEquipmentFilter) ||
            ContainsFilter(row.Item.ModelNo, globalEquipmentFilter) ||
            ContainsFilter(row.Item.Description, globalEquipmentFilter);
    }

    private static bool ContainsFilter(string? value, string filter) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase);

    private string GetCategoryRowKey() =>
        categoryForm.IsEditing
            ? categoryForm.Id
            : categoryForm.Name;

    private string GetItemRowKey()
    {
        if (itemForm.IsEditing)
        {
            return itemForm.Id;
        }

        return string.IsNullOrWhiteSpace(itemForm.ModelNo)
            ? itemForm.Name
            : $"{itemForm.Name} {itemForm.ModelNo}";
    }

