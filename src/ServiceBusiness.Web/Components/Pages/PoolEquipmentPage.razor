@page "/admin/catalog/poolequipment"
@page "/catalog/poolequipment"
@page "/poolequipment"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using System.Text
@using ServiceBusiness.Domain
@inject ServiceBusiness.Application.CompanyAdminService CompanyAdminService
@inject ServiceBusiness.Application.IndependentHomeOwnerService HomeOwnerService
@inject ServiceBusiness.Application.ICurrentUserContext CurrentUser
@inject ServiceBusiness.Web.DemoCurrentUserContext DemoUser
@inject ServiceBusiness.Web.CurrentCompanyContext CurrentCompany
@inject ServiceBusiness.Web.ApplicationModeService ApplicationMode
@inject NavigationManager Navigation

<PageTitle>Pool Equipment</PageTitle>

@if (appMode.IsPoolMode)
{
    <section class="page-header">
        <div>
            <p class="eyebrow">@PageScope</p>
            <h1>Pool Equipment</h1>
            <p class="lede">Create, edit, archive, and reactivate equipment categories and equipment items.</p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="notice success">@message</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="notice error">@errorMessage</div>
    }

    @if (overview is null)
    {
        <p>Loading pool equipment...</p>
    }
    else
    {
        @if (IsSystemAdminRoute)
        {
            <section class="management-panel">
                <div class="management-panel-header">
                    <h2>Seed Equipment</h2>
                </div>
                <div class="management-panel-body">
                    <div class="form-grid">
                        <label class="wide">
                            Equipment CSV
                            <InputFile OnChange="OnSeedFileSelected" accept=".csv,text/csv" />
                        </label>
                    </div>
                    <div class="form-actions">
                        <button class="button primary" type="button" @onclick="SeedEquipmentAsync" disabled="@(seedFile is null)">Seed Table</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(seedFileName))
                    {
                        <p class="form-note">@seedFileName selected.</p>
                    }
                </div>
            </section>
        }

        @if (!IsHomeOwnerRoute)
        {
        <section class="management-panel">
            <div class="management-panel-header">
                <h2>Equipment Categories</h2>
                <div class="management-panel-actions">
                    <button class="button primary" type="button" @onclick="ShowCreateCategory">Create</button>
                    <button class="icon-button" type="button" title="Toggle equipment categories" @onclick="ToggleCategoryList">@(categoryListExpanded ? "^" : "v")</button>
                </div>
            </div>
            @if (categoryListExpanded)
            {
                <div class="management-panel-body">
                    @if (categoryEditorExpanded)
                    {
                        <EditForm Model="categoryForm" OnValidSubmit="SaveCategoryAsync" FormName="equipment-category-editor">
                            <div class="editor-panel">
                                <h3>@(categoryForm.IsEditing ? "Edit Category" : "Create Category")</h3>
                    <div class="form-grid">
                        <label>
                            Category
                            <InputText class="form-control" @bind-Value="categoryForm.Name" />
                        </label>
                        <label>
                            Scope
                            <input class="form-control" value="@ScopeLabel" disabled />
                        </label>
                        <label class="wide">
                            Description
                            <InputTextArea class="form-control" @bind-Value="categoryForm.Description" />
                        </label>
                        <label class="switch-control" title="Toggle active state">
                            <input type="checkbox" checked="@categoryForm.IsActive" @onchange="args => categoryForm.IsActive = GetChecked(args)" />
                            <span></span>
                            <small>Active</small>
                        </label>
                    </div>
                    <div class="form-actions">
                        <button class="button primary" type="submit">Save Category</button>
                                        <button class="button" type="button" @onclick="HideCategoryEditor">Cancel</button>
                    </div>
                            </div>
                        </EditForm>
                    }
                    <div class="form-grid">
                        <label class="wide">
                            Filter categories
                            <input class="form-control" @bind="categoryFilter" @bind:event="oninput" placeholder="Filter by active state, category, or description" />
                        </label>
                    </div>
                    <div class="management-table-wrap">
                        <table class="management-table">
                            <thead>
                                <tr>
                                    <th><button class="table-sort-button" type="button" @onclick="() => SortCategories(CategorySortColumn.Active)">Active @GetCategorySortIndicator(CategorySortColumn.Active)</button></th>
                                    <th><button class="table-sort-button" type="button" @onclick="() => SortCategories(CategorySortColumn.Category)">Category @GetCategorySortIndicator(CategorySortColumn.Category)</button></th>
                                    <th><button class="table-sort-button" type="button" @onclick="() => SortCategories(CategorySortColumn.Description)">Description @GetCategorySortIndicator(CategorySortColumn.Description)</button></th>
                                    <th class="actions">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in FilteredCategoryGroups)
                                {
                                    <tr>
                                        <td>
                                            <label class="switch-control" title="Toggle active state">
                                                <input type="checkbox" checked="@group.Category.IsActive" @onchange="args => ToggleCategoryActiveAsync(group.Category, args)" />
                                                <span></span>
                                            </label>
                                        </td>
                                        <td>@group.Category.Name</td>
                                        <td>@group.Category.Description</td>
                                        <td class="actions">
                                            <button class="icon-button icon-only" type="button" title="Edit category" aria-label="Edit category" @onclick="() => EditCategory(group.Category)">
                                                <span class="action-icon edit-icon" aria-hidden="true"></span>
                                            </button>
                                            @if (group.Category.IsSystemManaged)
                                            {
                                                <button class="icon-button icon-only" type="button" title="Copy category" aria-label="Copy category" @onclick="() => CopyCategoryAsync(group.Category)">
                                                    <span class="action-icon copy-icon" aria-hidden="true"></span>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>
        }

        @if (IsHomeOwnerRoute)
        {
        <section class="management-panel">
            <div class="management-panel-header">
                <h2>Configuration</h2>
                <div class="management-panel-actions">
                    <button class="icon-button" type="button" title="Toggle equipment" @onclick="ToggleItemList">@(itemListExpanded ? "^" : "v")</button>
                </div>
            </div>
            @if (itemListExpanded)
            {
                <div class="management-panel-body">
                    <div class="form-grid">
                        <label class="wide">
                            Filter configured equipment
                            <input class="form-control" @bind="equipmentFilter" @bind:event="oninput" placeholder="Filter by active state, manufacturer, name, category, model, or description" />
                        </label>
                    </div>
                    <div class="management-table-wrap">
                        <table class="management-table">
                            <thead>
                                <tr>
                                    <th><button class="table-sort-button" type="button" @onclick="() => SortEquipment(EquipmentSortColumn.Active)">Active @GetEquipmentSortIndicator(EquipmentSortColumn.Active)</button></th>
                                    <th><button class="table-sort-button" type="button" @onclick="() => SortEquipment(EquipmentSortColumn.Manufacturer)">Manufacturer @GetEquipmentSortIndicator(EquipmentSortColumn.Manufacturer)</button></th>
                                    <th><button class="table-sort-button" type="button" @onclick="() => SortEquipment(EquipmentSortColumn.Name)">Name @GetEquipmentSortIndicator(EquipmentSortColumn.Name)</button></th>
                                    <th><button class="table-sort-button" type="button" @onclick="() => SortEquipment(EquipmentSortColumn.Category)">Category @GetEquipmentSortIndicator(EquipmentSortColumn.Category)</button></th>
                                    <th><button class="table-sort-button" type="button" @onclick="() => SortEquipment(EquipmentSortColumn.ModelNo)">Model No @GetEquipmentSortIndicator(EquipmentSortColumn.ModelNo)</button></th>
                                    <th><button class="table-sort-button" type="button" @onclick="() => SortEquipment(EquipmentSortColumn.Description)">Description @GetEquipmentSortIndicator(EquipmentSortColumn.Description)</button></th>
                                    <th class="actions">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in FilteredEquipmentRows)
                                {
                                    <tr>
                                        <td>
                                            <label class="switch-control" title="Toggle active state">
                                                <input type="checkbox" checked="@row.Item.IsActive" @onchange="args => ToggleItemActiveAsync(row.Item, args)" />
                                                <span></span>
                                            </label>
                                        </td>
                                        <td>@row.Item.Manufacturer</td>
                                        <td>@row.Item.Name</td>
                                        <td>@row.Category.Name</td>
                                        <td>@row.Item.ModelNo</td>
                                        <td>@row.Item.Description</td>
                                        <td class="actions">
                                            <button class="icon-button icon-only" type="button" title="Edit equipment" aria-label="Edit equipment" @onclick="() => EditItem(row.Item)">
                                                <span class="action-icon edit-icon" aria-hidden="true"></span>
                                            </button>
                                            <button class="icon-button icon-only danger" type="button" title="Delete equipment" aria-label="Delete equipment" @onclick="() => DeleteItemAsync(row.Item)">
                                                <span class="action-icon delete-icon" aria-hidden="true"></span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>

        <section class="management-panel">
            <div class="management-panel-header">
                <h2>Add Pool Equipment</h2>
                <div class="management-panel-actions">
                    <button class="button primary" type="button" @onclick="ShowCreateItem">Create</button>
                    <button class="icon-button" type="button" title="Toggle add pool equipment" @onclick="ToggleAddEquipmentPanel">@(addEquipmentExpanded ? "^" : "v")</button>
                </div>
            </div>
            @if (addEquipmentExpanded)
            {
                <div class="management-panel-body">
                    @if (itemEditorExpanded)
                    {
                        @EquipmentEditor()
                    }
                    <div class="form-grid">
                        <label class="wide">
                            Find global equipment
                            <input class="form-control" @bind="globalEquipmentFilter" @bind:event="oninput" placeholder="Filter by manufacturer, name, model, category, or description" />
                        </label>
                    </div>
                    <div class="management-table-wrap">
                        <table class="management-table">
                            <thead>
                                <tr>
                                    <th>Manufacturer</th>
                                    <th>Name</th>
                                    <th>Category</th>
                                    <th>Model No</th>
                                    <th class="actions">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in FilteredGlobalEquipmentRows)
                                {
                                    <tr>
                                        <td>@row.Item.Manufacturer</td>
                                        <td>@row.Item.Name</td>
                                        <td>@row.Category.Name</td>
                                        <td>@row.Item.ModelNo</td>
                                        <td class="actions">
                                            <button class="button" type="button" @onclick="() => AddGlobalEquipmentItemAsync(row.Item.Id)">Choose</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>

            <section class="management-panel">
                <div class="management-panel-header">
                    <h2>Equipment Pictures</h2>
                    <div class="management-panel-actions">
                        <button class="icon-button" type="button" title="Toggle equipment pictures" @onclick="TogglePicturesPanel">@(picturesExpanded ? "^" : "v")</button>
                    </div>
                </div>
                @if (picturesExpanded)
                {
                <div class="management-panel-body">
                    <div class="form-grid">
                        <label class="wide">
                            Upload pictures
                            <InputFile OnChange="UploadHomeOwnerPhotosAsync" accept="image/*" multiple />
                        </label>
                    </div>
                    @if (HomeOwnerPhotos.Count == 0)
                    {
                        <p>No pool equipment pictures uploaded.</p>
                    }
                    else
                    {
                        <div class="data-list">
                            @foreach (var photo in HomeOwnerPhotos)
                            {
                                <article class="row-card">
                                    <div>
                                        <strong>@photo.FileName</strong>
                                        <p>@photo.UploadedUtc.ToLocalTime().ToString("g")</p>
                                        <button class="photo-thumb-button" type="button" @onclick="() => ShowPhoto(photo)" aria-label="Open larger image">
                                            <img src="@photo.DataUrl" alt="@photo.FileName" />
                                        </button>
                                    </div>
                                    <div class="row-actions">
                                        <button class="button" type="button" @onclick="() => DeleteHomeOwnerPhotoAsync(photo.Id)">Delete</button>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </div>
                }
            </section>
        }
        else
        {
        <section class="management-panel">
            <div class="management-panel-header">
                <h2>Equipment</h2>
                <div class="management-panel-actions">
                    <button class="button primary" type="button" @onclick="ShowCreateItem">Create</button>
                    <button class="icon-button" type="button" title="Toggle equipment" @onclick="ToggleItemList">@(itemListExpanded ? "^" : "v")</button>
                </div>
            </div>
            @if (itemListExpanded)
            {
                <div class="management-panel-body">
                    @if (itemEditorExpanded)
                    {
                        @EquipmentEditor()
                    }
                    <div class="form-grid">
                        <label class="wide">
                            Filter equipment
                            <input class="form-control" @bind="equipmentFilter" @bind:event="oninput" placeholder="Filter by active state, manufacturer, name, category, model, or description" />
                        </label>
                    </div>
                    <div class="management-table-wrap">
                        <table class="management-table">
                            <thead>
                                <tr>
                                    <th><button class="table-sort-button" type="button" @onclick="() => SortEquipment(EquipmentSortColumn.Active)">Active @GetEquipmentSortIndicator(EquipmentSortColumn.Active)</button></th>
                                    <th><button class="table-sort-button" type="button" @onclick="() => SortEquipment(EquipmentSortColumn.Manufacturer)">Manufacturer @GetEquipmentSortIndicator(EquipmentSortColumn.Manufacturer)</button></th>
                                    <th><button class="table-sort-button" type="button" @onclick="() => SortEquipment(EquipmentSortColumn.Name)">Name @GetEquipmentSortIndicator(EquipmentSortColumn.Name)</button></th>
                                    <th><button class="table-sort-button" type="button" @onclick="() => SortEquipment(EquipmentSortColumn.Category)">Category @GetEquipmentSortIndicator(EquipmentSortColumn.Category)</button></th>
                                    <th><button class="table-sort-button" type="button" @onclick="() => SortEquipment(EquipmentSortColumn.ModelNo)">Model No @GetEquipmentSortIndicator(EquipmentSortColumn.ModelNo)</button></th>
                                    <th><button class="table-sort-button" type="button" @onclick="() => SortEquipment(EquipmentSortColumn.Description)">Description @GetEquipmentSortIndicator(EquipmentSortColumn.Description)</button></th>
                                    <th class="actions">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in FilteredEquipmentRows)
                                {
                                    <tr>
                                        <td>
                                            <label class="switch-control" title="Toggle active state">
                                                <input type="checkbox" checked="@row.Item.IsActive" @onchange="args => ToggleItemActiveAsync(row.Item, args)" />
                                                <span></span>
                                            </label>
                                        </td>
                                        <td>@row.Item.Manufacturer</td>
                                        <td>@row.Item.Name</td>
                                        <td>@row.Category.Name</td>
                                        <td>@row.Item.ModelNo</td>
                                        <td>@row.Item.Description</td>
                                        <td class="actions">
                                            <button class="icon-button icon-only" type="button" title="Edit equipment" aria-label="Edit equipment" @onclick="() => EditItem(row.Item)">
                                                <span class="action-icon edit-icon" aria-hidden="true"></span>
                                            </button>
                                            @if (row.Category.IsSystemManaged)
                                            {
                                                <button class="icon-button icon-only" type="button" title="Copy equipment" aria-label="Copy equipment" @onclick="() => CopyItemAsync(row.Item)">
                                                    <span class="action-icon copy-icon" aria-hidden="true"></span>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>
        }
    }
}

@if (zoomedPhoto is not null)
{
    <div class="photo-modal-backdrop" @onclick="ClosePhoto">
        <div class="photo-modal" @onclick:stopPropagation="true">
            <div class="photo-modal-header">
                <strong>@zoomedPhoto.FileName</strong>
                <button class="icon-button icon-only" type="button" title="Close image" aria-label="Close image" @onclick="ClosePhoto">x</button>
            </div>
            <img src="@zoomedPhoto.DataUrl" alt="@zoomedPhoto.FileName" />
        </div>
    </div>
}

@code {
    private PoolEquipmentOverview? overview;
    private PoolEquipmentOverview? globalOverview;
    private EquipmentCategoryForm categoryForm = new();
    private EquipmentItemForm itemForm = new();
    private bool categoryListExpanded = true;
    private bool itemListExpanded = true;
    private bool addEquipmentExpanded = true;
    private bool picturesExpanded = true;
    private bool categoryEditorExpanded;
    private bool itemEditorExpanded;
    private IBrowserFile? seedFile;
    private string? seedFileName;
    private string globalEquipmentFilter = "";
    private string categoryFilter = "";
    private string equipmentFilter = "";
    private CategorySortColumn categorySortColumn = CategorySortColumn.Category;
    private EquipmentSortColumn equipmentSortColumn = EquipmentSortColumn.Name;
    private bool categorySortDescending;
    private bool equipmentSortDescending;
    private IndependentHomeOwnerProfile? homeOwnerProfile;
    private HomeOwnerPoolEquipmentPhoto? zoomedPhoto;
    private string? message;
    private string? errorMessage;
    private string companyId = "";
    private ServiceBusiness.Web.ApplicationModeSnapshot appMode = ServiceBusiness.Web.ApplicationModeSnapshot.Pool;
    private bool IsSystemAdminRoute => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("admin/", StringComparison.OrdinalIgnoreCase);
    private bool IsHomeOwnerRoute => string.Equals(Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/'), "poolequipment", StringComparison.OrdinalIgnoreCase);
    private EquipmentScope Scope => IsSystemAdminRoute ? EquipmentScope.Global : IsHomeOwnerRoute ? EquipmentScope.HomeOwner : EquipmentScope.Company;
    private string ScopeOwnerId => Scope switch
    {
        EquipmentScope.Global => "global",
        EquipmentScope.HomeOwner => CurrentUser.UserId,
        _ => companyId
    };
    private string PageScope => Scope switch
    {
        EquipmentScope.Global => "System Administrator",
        EquipmentScope.HomeOwner => "Home Owner",
        _ => "Company Admin"
    };
    private string ScopeLabel => Scope switch
    {
        EquipmentScope.Global => "Global",
        EquipmentScope.HomeOwner => "Home Owner",
        _ => "Company"
    };
    private IReadOnlyList<PoolEquipmentCategory> EquipmentCategories => overview?.CategoryGroups.Select(g => g.Category).ToList() ?? [];
    private IReadOnlyList<PoolEquipmentCategory> GlobalEquipmentCategories => globalOverview?.CategoryGroups.Select(g => g.Category).ToList() ?? [];
    private IReadOnlyList<PoolEquipmentCategory> AvailableEquipmentCategories => IsHomeOwnerRoute
        ? GlobalEquipmentCategories
            .Concat(EquipmentCategories)
            .GroupBy(category => category.Id, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .OrderBy(category => category.Name)
            .ToList()
        : EquipmentCategories;
    private HashSet<string> EquipmentItemIds => (overview?.CategoryGroups ?? [])
        .SelectMany(group => group.Items)
        .Select(item => item.Id)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<EquipmentGridRow> GlobalEquipmentRows => globalOverview?.CategoryGroups
        .SelectMany(group => group.Items.Select(item => new EquipmentGridRow(group.Category, item)))
        .Where(row => !EquipmentItemIds.Contains(row.Item.Id))
        .OrderBy(row => row.Category.Name)
        .ThenBy(row => row.Item.Manufacturer)
        .ThenBy(row => row.Item.Name)
        .ToList() ?? [];
    private IReadOnlyList<EquipmentGridRow> FilteredGlobalEquipmentRows => GlobalEquipmentRows
        .Where(MatchesGlobalEquipmentFilter)
        .Take(50)
        .ToList();
    private IReadOnlyList<HomeOwnerPoolEquipmentPhoto> HomeOwnerPhotos => homeOwnerProfile?.PoolEquipmentPhotos ?? [];
    private IReadOnlyList<PoolEquipmentCategoryGroup> FilteredCategoryGroups => GetFilteredCategoryGroups();
    private IReadOnlyList<EquipmentGridRow> FilteredEquipmentRows => GetFilteredEquipmentRows();

    protected override async Task OnInitializedAsync()
    {
        appMode = await ApplicationMode.GetCurrentAsync();
        if (!appMode.IsPoolMode)
        {
            Navigation.NavigateTo("dashboard", replace: true);
            return;
        }

        if (Scope == EquipmentScope.Global)
        {
            DemoUser.UserId = "sys-admin";
        }
        else if (Scope == EquipmentScope.Company)
        {
            companyId = await CurrentCompany.GetRequiredCompanyIdAsync([CompanyRole.CompanyAdmin]);
        }

        await LoadAsync();
    }

    private RenderFragment EquipmentEditor() =>
        @<EditForm Model="itemForm" OnValidSubmit="SaveItemAsync" FormName="equipment-item-editor">
            <div class="editor-panel">
                <h3>@(itemForm.IsEditing ? "Edit Equipment" : "Create Equipment")</h3>
                <div class="form-grid">
                    <label>
                        Category
                        <InputSelect class="form-control" @bind-Value="itemForm.CategoryId">
                            <option value="">Uncategorized</option>
                            @foreach (var category in AvailableEquipmentCategories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        Manufacturer
                        <InputText class="form-control" @bind-Value="itemForm.Manufacturer" />
                    </label>
                    <label>
                        Name
                        <InputText class="form-control" @bind-Value="itemForm.Name" />
                    </label>
                    <label>
                        Model No
                        <InputText class="form-control" @bind-Value="itemForm.ModelNo" />
                    </label>
                    <label>
                        Image URL
                        <InputText class="form-control" @bind-Value="itemForm.ImageUrl" />
                    </label>
                    <label class="wide">
                        Description
                        <InputTextArea class="form-control" @bind-Value="itemForm.Description" />
                    </label>
                    <label class="switch-control" title="Toggle active state">
                        <input type="checkbox" checked="@itemForm.IsActive" @onchange="args => itemForm.IsActive = GetChecked(args)" />
                        <span></span>
                        <small>Active</small>
                    </label>
                </div>
                <div class="form-actions">
                    <button class="button primary" type="submit">Save Equipment</button>
                    <button class="button" type="button" @onclick="HideItemEditor">Cancel</button>
                </div>
            </div>
        </EditForm>;

    private async Task SaveCategoryAsync()
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.UpsertPoolEquipmentCategoryAsync(new PoolEquipmentCategory(
                GetCategoryRowKey(),
                Scope,
                ScopeOwnerId,
                "",
                categoryForm.Name,
                categoryForm.Description,
                categoryForm.IsSystemManaged,
                categoryForm.IsActive));
            message = $"{categoryForm.Name} category was saved.";
            ResetCategoryForm();
            categoryEditorExpanded = false;
        });
    }

    private async Task SaveItemAsync()
    {
        await RunAsync(async () =>
        {
            if (IsHomeOwnerRoute)
            {
                await EnsureHomeOwnerCategoryAsync(itemForm.CategoryId);
            }

            await CompanyAdminService.UpsertPoolEquipmentItemAsync(new PoolEquipmentItem(
                GetItemRowKey(),
                Scope,
                ScopeOwnerId,
                itemForm.CategoryId,
                itemForm.Name,
                itemForm.Description,
                itemForm.ImageUrl,
                itemForm.IsActive,
                itemForm.ModelNo,
                itemForm.Manufacturer));
            message = $"{itemForm.Name} was saved.";
            ResetItemForm();
            itemEditorExpanded = false;
        });
    }

    private async Task AddGlobalEquipmentItemAsync(string itemId)
    {
        if (string.IsNullOrWhiteSpace(itemId))
        {
            errorMessage = "Choose global equipment before adding it.";
            return;
        }

        await RunAsync(async () =>
        {
            var row = GlobalEquipmentRows.FirstOrDefault(row => row.Item.Id == itemId)
                ?? throw new InvalidOperationException("Global equipment item was not found.");

            await EnsureHomeOwnerCategoryAsync(row.Item.CategoryId);
            await CompanyAdminService.UpsertPoolEquipmentItemAsync(row.Item with
            {
                Scope = EquipmentScope.HomeOwner,
                ScopeOwnerId = ScopeOwnerId,
                IsActive = true
            });

            message = $"{row.Item.Name} was added to your pool equipment.";
            globalEquipmentFilter = "";
        });
    }

    private async Task DeleteItemAsync(PoolEquipmentItem item)
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.DeletePoolEquipmentItemAsync(Scope, ScopeOwnerId, item.Id);
            if (string.Equals(itemForm.Id, item.Id, StringComparison.OrdinalIgnoreCase))
            {
                ResetItemForm();
                itemEditorExpanded = false;
            }

            message = $"{item.Name} was deleted.";
        });
    }

    private void OnSeedFileSelected(InputFileChangeEventArgs args)
    {
        seedFile = args.File;
        seedFileName = seedFile.Name;
        message = null;
        errorMessage = null;
    }

    private async Task SeedEquipmentAsync()
    {
        if (seedFile is null)
        {
            errorMessage = "Choose a CSV file before seeding equipment.";
            return;
        }

        await RunAsync(async () =>
        {
            var rows = await ReadSeedRowsAsync(seedFile);
            var result = await CompanyAdminService.SeedPoolEquipmentAsync(Scope, ScopeOwnerId, rows);
            message = $"Seeded {result.CategoriesSeeded} equipment categories and {result.EquipmentSeeded} equipment items.";
            seedFile = null;
            seedFileName = null;
        });
    }

    private async Task UploadHomeOwnerPhotosAsync(InputFileChangeEventArgs args)
    {
        await RunAsync(async () =>
        {
            var photos = new List<HomeOwnerPoolEquipmentPhoto>();
            foreach (var file in args.GetMultipleFiles())
            {
                await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType;
                photos.Add(new HomeOwnerPoolEquipmentPhoto(
                    Guid.NewGuid().ToString("N"),
                    file.Name,
                    contentType,
                    $"data:{contentType};base64,{Convert.ToBase64String(memory.ToArray())}",
                    DateTimeOffset.UtcNow));
            }

            if (photos.Count == 0)
            {
                throw new InvalidOperationException("Choose at least one image to upload.");
            }

            homeOwnerProfile = await HomeOwnerService.AddPoolEquipmentPhotosAsync(photos);
            message = $"{photos.Count} pool equipment picture{(photos.Count == 1 ? "" : "s")} uploaded.";
        });
    }

    private async Task DeleteHomeOwnerPhotoAsync(string photoId)
    {
        await RunAsync(async () =>
        {
            homeOwnerProfile = await HomeOwnerService.DeletePoolEquipmentPhotoAsync(photoId);
            if (string.Equals(zoomedPhoto?.Id, photoId, StringComparison.OrdinalIgnoreCase))
            {
                zoomedPhoto = null;
            }

            message = "Pool equipment picture was deleted.";
        });
    }

