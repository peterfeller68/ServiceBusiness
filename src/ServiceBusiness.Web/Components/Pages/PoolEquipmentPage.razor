    private async Task RunAsync(Func<Task> action)
    {
        message = null;
        errorMessage = null;

        try
        {
            await action();
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadAsync()
    {
        overview = await CompanyAdminService.GetPoolEquipmentOverviewAsync(Scope, ScopeOwnerId);
        if (IsHomeOwnerRoute)
        {
            globalOverview = await CompanyAdminService.GetPoolEquipmentOverviewAsync(EquipmentScope.Global, "global");
            homeOwnerProfile = await HomeOwnerService.GetProfileAsync();
        }
        else
        {
            globalOverview = null;
        }
    }

    private async Task EnsureHomeOwnerCategoryAsync(string categoryId)
    {
        if (!IsHomeOwnerRoute || string.IsNullOrWhiteSpace(categoryId))
        {
            return;
        }

        if (EquipmentCategories.Any(category => string.Equals(category.Id, categoryId, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        var sourceCategory = GlobalEquipmentCategories.FirstOrDefault(category => string.Equals(category.Id, categoryId, StringComparison.OrdinalIgnoreCase))
            ?? throw new InvalidOperationException("Choose an equipment category from the global catalog.");
        await CompanyAdminService.UpsertPoolEquipmentCategoryAsync(sourceCategory with
        {
            Scope = EquipmentScope.HomeOwner,
            ScopeOwnerId = ScopeOwnerId,
            IsSystemManaged = false,
            IsActive = true
        });
    }

