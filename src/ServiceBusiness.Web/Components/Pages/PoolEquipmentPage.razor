    private static async Task<IReadOnlyList<PoolEquipmentSeedRow>> ReadSeedRowsAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024);
        using var reader = new StreamReader(stream);
        var text = await reader.ReadToEndAsync();
        var records = ParseCsv(text);

        if (records.Count == 0)
        {
            return [];
        }

        var header = records[0];
        if (header.Count < 4 ||
            !string.Equals(header[0], "Manufacturer", StringComparison.OrdinalIgnoreCase) ||
            !string.Equals(header[1], "Category", StringComparison.OrdinalIgnoreCase) ||
            !string.Equals(header[2], "Name", StringComparison.OrdinalIgnoreCase) ||
            !string.Equals(header[3], "Model No", StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException("Seed CSV must include Manufacturer, Category, Name, and Model No columns.");
        }

        return records
            .Skip(1)
            .Where(record => record.Any(value => !string.IsNullOrWhiteSpace(value)))
            .Select(record => new PoolEquipmentSeedRow(
                GetCsvValue(record, 0),
                GetCsvValue(record, 1),
                GetCsvValue(record, 2),
                GetCsvValue(record, 3)))
            .ToList();
    }

    private static string GetCsvValue(IReadOnlyList<string> record, int index) =>
        index < record.Count ? record[index] : "";

    private static IReadOnlyList<IReadOnlyList<string>> ParseCsv(string text)
    {
        var records = new List<IReadOnlyList<string>>();
        var fields = new List<string>();
        var field = new StringBuilder();
        var inQuotes = false;

        for (var i = 0; i < text.Length; i++)
        {
            var ch = text[i];
            if (ch == '"')
            {
                if (inQuotes && i + 1 < text.Length && text[i + 1] == '"')
                {
                    field.Append('"');
                    i++;
                }
                else
                {
                    inQuotes = !inQuotes;
                }
            }
            else if (ch == ',' && !inQuotes)
            {
                fields.Add(field.ToString().Trim());
                field.Clear();
            }
            else if ((ch == '\r' || ch == '\n') && !inQuotes)
            {
                if (ch == '\r' && i + 1 < text.Length && text[i + 1] == '\n')
                {
                    i++;
                }

                fields.Add(field.ToString().Trim());
                field.Clear();
                records.Add(fields.ToList());
                fields.Clear();
            }
            else
            {
                field.Append(ch);
            }
        }

        if (field.Length > 0 || fields.Count > 0)
        {
            fields.Add(field.ToString().Trim());
            records.Add(fields.ToList());
        }

        return records;
    }
}
