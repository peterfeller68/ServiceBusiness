@page "/admin/catalog/poolequipment"
@page "/catalog/poolequipment"
@page "/poolequipment"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using ServiceBusiness.Domain
@inject ServiceBusiness.Application.CompanyAdminService CompanyAdminService
@inject ServiceBusiness.Application.ICurrentUserContext CurrentUser
@inject ServiceBusiness.Web.DemoCurrentUserContext DemoUser
@inject ServiceBusiness.Web.CurrentCompanyContext CurrentCompany
@inject ServiceBusiness.Web.ApplicationModeService ApplicationMode
@inject NavigationManager Navigation

<PageTitle>Pool Equipment</PageTitle>

@if (appMode.IsPoolMode)
{
    <section class="page-header">
        <div>
            <p class="eyebrow">@PageScope</p>
            <h1>Pool Equipment</h1>
            <p class="lede">Create, edit, archive, and reactivate equipment categories and equipment items.</p>
        </div>
        <a class="button" href="settings">Settings</a>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="notice success">@message</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="notice error">@errorMessage</div>
    }

    @if (overview is null)
    {
        <p>Loading pool equipment...</p>
    }
    else
    {
        <section class="management-panel">
            <div class="management-panel-header">
                <h2>Equipment Categories</h2>
                <div class="management-panel-actions">
                    <button class="button primary" type="button" @onclick="ShowCreateCategory">Create</button>
                    <button class="icon-button" type="button" title="Toggle equipment categories" @onclick="ToggleCategoryList">@(categoryListExpanded ? "^" : "v")</button>
                </div>
            </div>
            @if (categoryListExpanded)
            {
                <div class="management-panel-body">
                    @if (categoryEditorExpanded)
                    {
                        <EditForm Model="categoryForm" OnValidSubmit="SaveCategoryAsync" FormName="equipment-category-editor">
                            <div class="editor-panel">
                                <h3>@(categoryForm.IsEditing ? "Edit Category" : "Create Category")</h3>
                    <div class="form-grid">
                        <label>
                            Category ID
                            <InputText class="form-control" @bind-Value="categoryForm.Id" disabled="@categoryForm.IsEditing" />
                        </label>
                        <label>
                            Manufacturer
                            <InputText class="form-control" @bind-Value="categoryForm.Manufacturer" />
                        </label>
                        <label>
                            Name
                            <InputText class="form-control" @bind-Value="categoryForm.Name" />
                        </label>
                        <label>
                            Scope
                            <input class="form-control" value="@ScopeLabel" disabled />
                        </label>
                        <label class="wide">
                            Description
                            <InputTextArea class="form-control" @bind-Value="categoryForm.Description" />
                        </label>
                        <label class="check-row">
                            <InputCheckbox @bind-Value="categoryForm.IsActive" />
                            <span>Active</span>
                        </label>
                    </div>
                    <div class="form-actions">
                        <button class="button primary" type="submit">Save Category</button>
                                        <button class="button" type="button" @onclick="HideCategoryEditor">Cancel</button>
                    </div>
                            </div>
                        </EditForm>
                    }
                    <div class="management-table-wrap">
                        <table class="management-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Active</th>
                                    <th>Manufacturer</th>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th class="actions">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in overview.CategoryGroups)
                                {
                                    <tr>
                                        <td>@group.Category.Id</td>
                                        <td>@(group.Category.IsActive ? "Yes" : "No")</td>
                                        <td>@group.Category.Manufacturer</td>
                                        <td>@group.Category.Name</td>
                                        <td>@group.Category.Description</td>
                                        <td class="actions">
                                            <button class="icon-button" type="button" title="Edit category" @onclick="() => EditCategory(group.Category)">Edit</button>
                                            @if (group.Category.IsSystemManaged)
                                            {
                                                <button class="icon-button" type="button" title="Copy category" @onclick="() => CopyCategoryAsync(group.Category)">Copy</button>
                                            }
                                            @if (group.Category.IsActive)
                                            {
                                                <button class="icon-button danger" type="button" title="Archive category" @onclick="() => SetCategoryActiveAsync(group.Category, false)">Del</button>
                                            }
                                            else
                                            {
                                                <button class="icon-button" type="button" title="Reactivate category" @onclick="() => SetCategoryActiveAsync(group.Category, true)">On</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>

        <section class="management-panel">
            <div class="management-panel-header">
                <h2>Equipment</h2>
                <div class="management-panel-actions">
                    <button class="button primary" type="button" @onclick="ShowCreateItem">Create</button>
                    <button class="icon-button" type="button" title="Toggle equipment" @onclick="ToggleItemList">@(itemListExpanded ? "^" : "v")</button>
                </div>
            </div>
            @if (itemListExpanded)
            {
                <div class="management-panel-body">
                    @if (itemEditorExpanded)
                    {
                        <EditForm Model="itemForm" OnValidSubmit="SaveItemAsync" FormName="equipment-item-editor">
                            <div class="editor-panel">
                                <h3>@(itemForm.IsEditing ? "Edit Equipment" : "Create Equipment")</h3>
                    <div class="form-grid">
                        <label>
                            Equipment ID
                            <InputText class="form-control" @bind-Value="itemForm.Id" disabled="@itemForm.IsEditing" />
                        </label>
                        <label>
                            Category
                            <InputSelect class="form-control" @bind-Value="itemForm.CategoryId">
                                <option value="">Choose category</option>
                                @foreach (var category in EquipmentCategories)
                                {
                                    <option value="@category.Id">@category.Manufacturer - @category.Name</option>
                                }
                            </InputSelect>
                        </label>
                        <label>
                            Name
                            <InputText class="form-control" @bind-Value="itemForm.Name" />
                        </label>
                        <label>
                            Image URL
                            <InputText class="form-control" @bind-Value="itemForm.ImageUrl" />
                        </label>
                        <label class="wide">
                            Description
                            <InputTextArea class="form-control" @bind-Value="itemForm.Description" />
                        </label>
                        <label class="check-row">
                            <InputCheckbox @bind-Value="itemForm.IsActive" />
                            <span>Active</span>
                        </label>
                    </div>
                    <div class="form-actions">
                        <button class="button primary" type="submit">Save Equipment</button>
                                        <button class="button" type="button" @onclick="HideItemEditor">Cancel</button>
                    </div>
                            </div>
                        </EditForm>
                    }
                    <div class="management-table-wrap">
                        <table class="management-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Active</th>
                                    <th>Name</th>
                                    <th>Category</th>
                                    <th>Description</th>
                                    <th class="actions">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in overview.CategoryGroups)
                                {
                                    @foreach (var item in group.Items)
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>@(item.IsActive ? "Yes" : "No")</td>
                                            <td>@item.Name</td>
                                            <td>@group.Category.Name</td>
                                            <td>@item.Description</td>
                                            <td class="actions">
                                                <button class="icon-button" type="button" title="Edit equipment" @onclick="() => EditItem(item)">Edit</button>
                                                @if (group.Category.IsSystemManaged)
                                                {
                                                    <button class="icon-button" type="button" title="Copy equipment" @onclick="() => CopyItemAsync(item)">Copy</button>
                                                }
                                                @if (item.IsActive)
                                                {
                                                    <button class="icon-button danger" type="button" title="Archive equipment" @onclick="() => SetItemActiveAsync(item, false)">Del</button>
                                                }
                                                else
                                                {
                                                    <button class="icon-button" type="button" title="Reactivate equipment" @onclick="() => SetItemActiveAsync(item, true)">On</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>
    }
}

@code {
    private PoolEquipmentOverview? overview;
    private EquipmentCategoryForm categoryForm = new();
    private EquipmentItemForm itemForm = new();
    private bool categoryListExpanded = true;
    private bool itemListExpanded = true;
    private bool categoryEditorExpanded;
    private bool itemEditorExpanded;
    private string? message;
    private string? errorMessage;
    private string companyId = "";
    private ServiceBusiness.Web.ApplicationModeSnapshot appMode = ServiceBusiness.Web.ApplicationModeSnapshot.Pool;
    private bool IsSystemAdminRoute => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("admin/", StringComparison.OrdinalIgnoreCase);
    private bool IsHomeOwnerRoute => string.Equals(Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/'), "poolequipment", StringComparison.OrdinalIgnoreCase);
    private EquipmentScope Scope => IsSystemAdminRoute ? EquipmentScope.Global : IsHomeOwnerRoute ? EquipmentScope.HomeOwner : EquipmentScope.Company;
    private string ScopeOwnerId => Scope switch
    {
        EquipmentScope.Global => "global",
        EquipmentScope.HomeOwner => CurrentUser.UserId,
        _ => companyId
    };
    private string PageScope => Scope switch
    {
        EquipmentScope.Global => "System Administrator",
        EquipmentScope.HomeOwner => "Home Owner",
        _ => "Company Admin"
    };
    private string ScopeLabel => Scope switch
    {
        EquipmentScope.Global => "Global",
        EquipmentScope.HomeOwner => "Home Owner",
        _ => "Company"
    };
    private IReadOnlyList<PoolEquipmentCategory> EquipmentCategories => overview?.CategoryGroups.Select(g => g.Category).ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        appMode = await ApplicationMode.GetCurrentAsync();
        if (!appMode.IsPoolMode)
        {
            Navigation.NavigateTo("dashboard", replace: true);
            return;
        }

        if (Scope == EquipmentScope.Global)
        {
            DemoUser.UserId = "sys-admin";
        }
        else if (Scope == EquipmentScope.Company)
        {
            companyId = await CurrentCompany.GetRequiredCompanyIdAsync([CompanyRole.CompanyAdmin]);
        }

        await LoadAsync();
    }

    private async Task SaveCategoryAsync()
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.UpsertPoolEquipmentCategoryAsync(new PoolEquipmentCategory(
                categoryForm.Id,
                Scope,
                ScopeOwnerId,
                categoryForm.Manufacturer,
                categoryForm.Name,
                categoryForm.Description,
                categoryForm.IsSystemManaged,
                categoryForm.IsActive));
            message = $"{categoryForm.Name} category was saved.";
            ResetCategoryForm();
            categoryEditorExpanded = false;
        });
    }

    private async Task SaveItemAsync()
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.UpsertPoolEquipmentItemAsync(new PoolEquipmentItem(
                itemForm.Id,
                Scope,
                ScopeOwnerId,
                itemForm.CategoryId,
                itemForm.Name,
                itemForm.Description,
                itemForm.ImageUrl,
                itemForm.IsActive));
            message = $"{itemForm.Name} was saved.";
            ResetItemForm();
            itemEditorExpanded = false;
        });
    }

    private async Task SetCategoryActiveAsync(PoolEquipmentCategory category, bool isActive)
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.SetPoolEquipmentCategoryActiveAsync(Scope, ScopeOwnerId, category.Id, isActive);
            message = $"{category.Name} was {(isActive ? "reactivated" : "archived")}.";
        });
    }

    private async Task CopyCategoryAsync(PoolEquipmentCategory category)
    {
        await RunAsync(async () =>
        {
            var copy = await CompanyAdminService.CopyPoolEquipmentCategoryAsync(Scope, ScopeOwnerId, category.Id);
            message = $"{category.Name} was copied to {copy.Name}.";
        });
    }

    private async Task SetItemActiveAsync(PoolEquipmentItem item, bool isActive)
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.SetPoolEquipmentItemActiveAsync(Scope, ScopeOwnerId, item.Id, isActive);
            message = $"{item.Name} was {(isActive ? "reactivated" : "archived")}.";
        });
    }

    private async Task CopyItemAsync(PoolEquipmentItem item)
    {
        await RunAsync(async () =>
        {
            var copy = await CompanyAdminService.CopyPoolEquipmentItemAsync(Scope, ScopeOwnerId, item.Id);
            message = $"{item.Name} was copied to {copy.Name}.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        message = null;
        errorMessage = null;

        try
        {
            await action();
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadAsync()
    {
        overview = await CompanyAdminService.GetPoolEquipmentOverviewAsync(Scope, ScopeOwnerId);
    }

    private void EditCategory(PoolEquipmentCategory category)
    {
        categoryForm = EquipmentCategoryForm.FromCategory(category);
        categoryEditorExpanded = true;
        categoryListExpanded = true;
    }

    private void EditItem(PoolEquipmentItem item)
    {
        itemForm = EquipmentItemForm.FromItem(item);
        itemEditorExpanded = true;
        itemListExpanded = true;
    }

    private void ResetCategoryForm() => categoryForm = new();

    private void ResetItemForm() => itemForm = new();

    private void ShowCreateCategory()
    {
        ResetCategoryForm();
        categoryEditorExpanded = true;
        categoryListExpanded = true;
    }

    private void ShowCreateItem()
    {
        ResetItemForm();
        itemEditorExpanded = true;
        itemListExpanded = true;
    }

    private void HideCategoryEditor()
    {
        ResetCategoryForm();
        categoryEditorExpanded = false;
    }

    private void HideItemEditor()
    {
        ResetItemForm();
        itemEditorExpanded = false;
    }

    private void ToggleCategoryList() => categoryListExpanded = !categoryListExpanded;

    private void ToggleItemList() => itemListExpanded = !itemListExpanded;

    private sealed class EquipmentCategoryForm
    {
        public string Id { get; set; } = "";
        public string Manufacturer { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsSystemManaged { get; set; }
        public bool IsActive { get; set; } = true;
        public bool IsEditing { get; set; }

        public static EquipmentCategoryForm FromCategory(PoolEquipmentCategory category) => new()
        {
            Id = category.Id,
            Manufacturer = category.Manufacturer,
            Name = category.Name,
            Description = category.Description,
            IsSystemManaged = category.IsSystemManaged,
            IsActive = category.IsActive,
            IsEditing = true
        };
    }

    private sealed class EquipmentItemForm
    {
        public string Id { get; set; } = "";
        public string CategoryId { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string? ImageUrl { get; set; }
        public bool IsActive { get; set; } = true;
        public bool IsEditing { get; set; }

        public static EquipmentItemForm FromItem(PoolEquipmentItem item) => new()
        {
            Id = item.Id,
            CategoryId = item.CategoryId,
            Name = item.Name,
            Description = item.Description,
            ImageUrl = item.ImageUrl,
            IsActive = item.IsActive,
            IsEditing = true
        };
    }
}
