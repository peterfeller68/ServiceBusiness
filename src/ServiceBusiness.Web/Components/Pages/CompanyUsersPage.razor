@page "/company/users"
@rendermode InteractiveServer
@using ServiceBusiness.Application
@using ServiceBusiness.Domain
@inject CompanyAdminService CompanyAdminService
@inject ServiceBusiness.Web.CurrentCompanyContext CurrentCompany

<PageTitle>Users</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Company Admin</p>
        <h1>Users</h1>
        <p class="lede">Review access requests, manage company access, and update company-scoped roles.</p>
    </div>
    <a class="button" href="company">Company Dashboard</a>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice error">@errorMessage</div>
}

@if (overview is null)
{
    <p>Loading company users...</p>
}
else
{
    <div class="metric-grid">
        <div class="metric">
            <span>Company</span>
            <strong>@overview.Company.Name</strong>
        </div>
        <div class="metric">
            <span>Active Users</span>
            <strong>@overview.ActiveUsers</strong>
        </div>
        <div class="metric">
            <span>Pending Access</span>
            <strong>@overview.PendingRequests</strong>
        </div>
    </div>

    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Pending Access</h2>
            <button class="icon-button" type="button" title="Toggle pending access" @onclick="TogglePendingAccess">@(pendingAccessExpanded ? "^" : "v")</button>
        </div>
        @if (pendingAccessExpanded)
        {
            <div class="management-panel-body">
                @if (overview.PendingAccessRequests.Count == 0)
                {
                    <div class="callout">
                        <strong>No pending requests</strong>
                        <p>New business user and business client registrations will appear here for owner review.</p>
                    </div>
                }
                else
                {
                    <div class="management-table-wrap">
                        <table class="management-table">
                            <thead>
                                <tr>
                                    <th>User ID</th>
                                    <th>Status</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Requested</th>
                                    <th class="actions">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in overview.PendingAccessRequests)
                                {
                                    <tr>
                                        <td>@request.User.Id</td>
                                        <td>@request.Membership.Status</td>
                                        <td>@request.User.DisplayName</td>
                                        <td>@request.User.Email</td>
                                        <td>@request.Role.DisplayName</td>
                                        <td>@request.Membership.RequestedUtc.LocalDateTime.ToString("g")</td>
                                        <td class="actions">
                                            <button class="icon-button" type="button" title="Approve request" @onclick="() => DecideAsync(request, MembershipStatus.Active)">Ok</button>
                                            <button class="icon-button danger" type="button" title="Reject request" @onclick="() => DecideAsync(request, MembershipStatus.Rejected)">Del</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </section>

    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Company Access</h2>
            <button class="icon-button" type="button" title="Toggle company access" @onclick="ToggleCompanyAccess">@(companyAccessExpanded ? "^" : "v")</button>
        </div>
        @if (companyAccessExpanded)
        {
            <div class="management-panel-body">
                <div class="management-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th>User ID</th>
                                <th>Status</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th class="actions">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in overview.Users)
                            {
                                var key = RoleEditKey(row);
                                <tr>
                                    <td>@row.User.Id</td>
                                    <td>@row.Membership.Status</td>
                                    <td>@row.User.DisplayName</td>
                                    <td>@row.User.Email</td>
                                    <td>
                                        <select class="form-control compact-select" @bind="roleEdits[key]">
                                            @foreach (var role in overview.Roles)
                                            {
                                                <option value="@role.Role">@role.DisplayName</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="actions">
                                        <button class="icon-button" type="button" title="Update role" @onclick="() => UpdateRoleAsync(row)">Save</button>
                                        @if (row.Membership.Status == MembershipStatus.Active)
                                        {
                                            <button class="icon-button danger" type="button" title="Deactivate access" @onclick="() => SetAccessStatusAsync(row, MembershipStatus.Inactive)">Del</button>
                                        }
                                        else
                                        {
                                            <button class="icon-button" type="button" title="Reactivate access" @onclick="() => SetAccessStatusAsync(row, MembershipStatus.Active)">On</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
}

@code {
    private string companyId = "";
    private CompanyUserManagementOverview? overview;
    private readonly Dictionary<string, CompanyRole> roleEdits = [];
    private bool pendingAccessExpanded = true;
    private bool companyAccessExpanded = true;
    private string? message;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        companyId = await CurrentCompany.GetRequiredCompanyIdAsync([CompanyRole.CompanyAdmin]);
        await LoadAsync();
    }

    private async Task DecideAsync(AccessRequest request, MembershipStatus decision)
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.DecideAccessRequestAsync(
                request.Company.Id,
                request.User.Id,
                request.Membership.Role,
                decision);

            message = $"{request.User.DisplayName} was {decision.ToString().ToLowerInvariant()} for {request.Company.Name}.";
        });
    }

    private async Task SetAccessStatusAsync(CompanyUserManagementRow row, MembershipStatus status)
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.SetCompanyUserAccessStatusAsync(
                row.Membership.CompanyId,
                row.User.Id,
                row.Membership.Role,
                status);
            message = $"{row.User.DisplayName} access is now {status.ToString().ToLowerInvariant()}.";
        });
    }

    private async Task UpdateRoleAsync(CompanyUserManagementRow row)
    {
        await RunAsync(async () =>
        {
            var newRole = roleEdits[RoleEditKey(row)];
            await CompanyAdminService.UpdateCompanyUserRoleAsync(
                row.Membership.CompanyId,
                row.User.Id,
                row.Membership.Role,
                newRole);
            message = $"{row.User.DisplayName} role was updated to {newRole}.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        message = null;
        errorMessage = null;

        try
        {
            await action();
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadAsync()
    {
        overview = await CompanyAdminService.GetCompanyUserManagementOverviewAsync(companyId);
        roleEdits.Clear();
        foreach (var row in overview.Users)
        {
            roleEdits[RoleEditKey(row)] = row.Membership.Role;
        }
    }

    private static string RoleEditKey(CompanyUserManagementRow row) => $"{row.User.Id}|{row.Membership.Role}";

    private void TogglePendingAccess() => pendingAccessExpanded = !pendingAccessExpanded;

    private void ToggleCompanyAccess() => companyAccessExpanded = !companyAccessExpanded;
}
