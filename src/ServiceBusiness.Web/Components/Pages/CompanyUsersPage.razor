@page "/company/users"
@page "/settings/users"
@rendermode InteractiveServer
@using ServiceBusiness.Application
@using ServiceBusiness.Domain
@inject ICurrentUserContext CurrentUser
@inject CompanyAdminService CompanyAdminService
@inject ServiceBusiness.Web.CurrentCompanyContext CurrentCompany

<PageTitle>Users</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Company Admin</p>
        <h1>Users</h1>
        <p class="lede">Review access requests, manage company access, and update company-scoped roles.</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice error">@errorMessage</div>
}

@if (overview is null)
{
    <p>Loading company users...</p>
}
else
{
    <div class="metric-grid">
        <div class="metric">
            <span>Company</span>
            <strong>@overview.Company.Name</strong>
        </div>
        <div class="metric">
            <span>Active Users</span>
            <strong>@overview.ActiveUsers</strong>
        </div>
        <div class="metric">
            <span>Pending Access</span>
            <strong>@overview.PendingRequests</strong>
        </div>
    </div>

    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Users</h2>
            <button class="icon-button" type="button" title="Toggle company access" @onclick="ToggleCompanyAccess">@(companyAccessExpanded ? "^" : "v")</button>
        </div>
        @if (companyAccessExpanded)
        {
            <div class="management-panel-body">
                <div class="management-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Flags</th>
                                <th>User Type</th>
                                <th>Approved</th>
                                <th class="actions">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in overview.Users)
                            {
                                var key = RoleEditKey(row);
                                var isCurrentUser = IsCurrentUser(row.User);
                                <tr>
                                    <td>
                                        <label class="switch-control" title="Toggle active state">
                                            <input type="checkbox" checked="@(row.Membership.Status == MembershipStatus.Active)" disabled="@(isCurrentUser || row.Membership.Status == MembershipStatus.Pending)" @onchange="args => SetAccessStatusAsync(row, GetChecked(args) ? MembershipStatus.Active : MembershipStatus.Inactive)" />
                                            <span></span>
                                        </label>
                                    </td>
                                    <td>@row.User.DisplayName</td>
                                    <td>@row.User.Email</td>
                                    <td>@GetUserFlags(row)</td>
                                    <td>
                                        <select class="form-control compact-select" @bind="roleEdits[key]" disabled="@isCurrentUser">
                                            @foreach (var role in overview.Roles)
                                            {
                                                <option value="@role.Role">@role.DisplayName</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <label class="switch-control" title="Toggle approval state">
                                            <input type="checkbox" checked="@(row.Membership.Status == MembershipStatus.Active)" disabled="@isCurrentUser" @onchange="args => SetApprovalAsync(row, GetChecked(args))" />
                                            <span></span>
                                        </label>
                                    </td>
                                    <td class="actions">
                                        <button class="icon-button icon-only" type="button" title="Edit user role" aria-label="Edit user role" disabled="@isCurrentUser" @onclick="() => UpdateRoleAsync(row)">
                                            <span class="action-icon edit-icon" aria-hidden="true"></span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
}

@code {
    private string companyId = "";
    private CompanyUserManagementOverview? overview;
    private readonly Dictionary<string, CompanyRole> roleEdits = [];
    private bool companyAccessExpanded = true;
    private string currentUserId = "";
    private string? message;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        currentUserId = CurrentUser.UserId;
        companyId = await CurrentCompany.GetRequiredCompanyIdAsync([CompanyRole.CompanyAdmin]);
        await LoadAsync();
    }

    private async Task DecideAsync(AccessRequest request, MembershipStatus decision)
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.DecideAccessRequestAsync(
                request.Company.Id,
                request.User.Id,
                request.Membership.Role,
                decision);

            message = $"{request.User.DisplayName} was {decision.ToString().ToLowerInvariant()} for {request.Company.Name}.";
        });
    }

    private async Task SetAccessStatusAsync(CompanyUserManagementRow row, MembershipStatus status)
    {
        await RunAsync(async () =>
        {
            await CompanyAdminService.SetCompanyUserAccessStatusAsync(
                row.Membership.CompanyId,
                row.User.Id,
                row.Membership.Role,
                status);
            message = $"{row.User.DisplayName} access is now {status.ToString().ToLowerInvariant()}.";
        });
    }

    private async Task SetApprovalAsync(CompanyUserManagementRow row, bool isApproved)
    {
        if (row.Membership.Status == MembershipStatus.Pending)
        {
            await DecideAsync(
                new AccessRequest(row.Membership, row.User, overview!.Company, row.Role),
                isApproved ? MembershipStatus.Active : MembershipStatus.Rejected);
            return;
        }

        await SetAccessStatusAsync(row, isApproved ? MembershipStatus.Active : MembershipStatus.Inactive);
    }

    private async Task UpdateRoleAsync(CompanyUserManagementRow row)
    {
        await RunAsync(async () =>
        {
            var newRole = roleEdits[RoleEditKey(row)];
            await CompanyAdminService.UpdateCompanyUserRoleAsync(
                row.Membership.CompanyId,
                row.User.Id,
                row.Membership.Role,
                newRole);
            message = $"{row.User.DisplayName} role was updated to {newRole}.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        message = null;
        errorMessage = null;

        try
        {
            await action();
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadAsync()
    {
        overview = await CompanyAdminService.GetCompanyUserManagementOverviewAsync(companyId);
        roleEdits.Clear();
        foreach (var row in overview.Users)
        {
            roleEdits[RoleEditKey(row)] = row.Membership.Role;
        }
    }

    private static string RoleEditKey(CompanyUserManagementRow row) => $"{row.User.Id}|{row.Membership.Role}";

    private void ToggleCompanyAccess() => companyAccessExpanded = !companyAccessExpanded;

    private static bool GetChecked(ChangeEventArgs args) => args.Value is bool value && value;

    private bool IsCurrentUser(AppUser user) =>
        string.Equals(user.Id, currentUserId, StringComparison.OrdinalIgnoreCase);

    private static string GetUserFlags(CompanyUserManagementRow row)
    {
        var flags = new List<string> { row.Role.DisplayName };
        if (row.User.IsTestUser)
        {
            flags.Add("Test User");
        }

        if (row.Membership.Status == MembershipStatus.Pending)
        {
            flags.Add("Pending");
        }

        return string.Join(", ", flags);
    }
}
