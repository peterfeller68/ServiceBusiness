    private string GetServiceHistoryName(IndependentHomeOwnerServiceHistoryItem item)
    {
        if (!string.IsNullOrWhiteSpace(item.ServiceName))
        {
            return item.ServiceName;
        }

        return HomeOwnerServices.FirstOrDefault(service => string.Equals(service.Id, item.ServiceId, StringComparison.OrdinalIgnoreCase))?.Name
            ?? "Service";
    }

    private string GetBusinessClientPackageServiceName(string serviceId) =>
        BusinessClientAvailableServices.FirstOrDefault(service => string.Equals(service.Id, serviceId, StringComparison.OrdinalIgnoreCase))?.Name
        ?? serviceId;

    private IReadOnlyList<ServiceVisit> BusinessClientUpcomingVisits => businessClientVisits
        .Where(visit => visit.Status != VisitStatus.Completed && visit.Status != VisitStatus.Closed && visit.Status != VisitStatus.Canceled && visit.Status != VisitStatus.Skipped)
        .OrderBy(visit => visit.ScheduledDate == default ? DateOnly.MaxValue : visit.ScheduledDate)
        .ThenBy(visit => visit.ServiceWindowStart)
        .ToList();

    private IReadOnlyList<ServiceVisit> BusinessClientCompletedVisits => businessClientVisits
        .Where(visit => visit.Status is VisitStatus.Completed or VisitStatus.Closed)
        .OrderByDescending(visit => visit.CompletedUtc ?? new DateTimeOffset(visit.ScheduledDate == default ? DateTime.MinValue : visit.ScheduledDate.ToDateTime(TimeOnly.MinValue)))
        .ToList();

    private string GetBusinessClientVisitNote(ServiceVisit visit) =>
        businessClientVisitNotes.TryGetValue(visit.Id, out var note) ? note : visit.NotesToServiceClient;

    private void SetBusinessClientVisitNote(string visitId, string notes) =>
        businessClientVisitNotes[visitId] = notes;

    private string GetBusinessOwnerVisitAssignee(ServiceVisit visit) =>
        businessOwnerVisitAssignees.TryGetValue(visit.Id, out var assignee) ? assignee : visit.AssignedUserId ?? string.Empty;

    private void SetBusinessOwnerVisitAssignee(string visitId, string assignee) =>
        businessOwnerVisitAssignees[visitId] = assignee;

    private string GetBusinessOwnerClientName(ServiceVisit visit) =>
        businessOwnerClients.FirstOrDefault(client => string.Equals(client.Id, visit.CompanyClientId, StringComparison.OrdinalIgnoreCase))?.DisplayName
        ?? visit.CompanyClientId;

    private string GetDashboardVisitClientName(ServiceVisit visit) =>
        businessOwnerClients.FirstOrDefault(client => string.Equals(client.Id, visit.CompanyClientId, StringComparison.OrdinalIgnoreCase))?.DisplayName
        ?? businessClient?.DisplayName
        ?? businessEmployeeTodayVisits.Concat(businessEmployeeUpcomingVisits).Concat(businessEmployeeCompletedVisits)
            .FirstOrDefault(item => string.Equals(item.Visit.Id, visit.Id, StringComparison.OrdinalIgnoreCase))?.Client.DisplayName
        ?? visit.CompanyClientId;

    private ServiceOffering? GetDashboardService(string serviceId) =>
        businessEmployeeServices
            .Concat(BusinessClientAvailableServices)
            .FirstOrDefault(service => string.Equals(service.Id, serviceId, StringComparison.OrdinalIgnoreCase));

    private string GetDashboardServiceName(string serviceId) =>
        GetDashboardService(serviceId)?.Name ?? serviceId;

    private string GetDashboardServiceNames(IReadOnlyList<string> serviceIds)
    {
        var names = serviceIds
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Select(GetDashboardServiceName)
            .ToList();
        return names.Count == 0 ? "-" : string.Join(", ", names);
    }

    private static string GetMaterialUsageText(IReadOnlyList<MaterialUsage> materials)
    {
        if (materials.Count == 0)
        {
            return "-";
        }

        return string.Join(", ", materials.Select(material => $"{material.MaterialId} ({material.Quantity})"));
    }

    private static string DisplayVisitName(ServiceVisit visit) =>
        string.IsNullOrWhiteSpace(visit.VisitName) ? "Service Visit" : visit.VisitName;

    private static string DisplayVisitDate(ServiceVisit visit) =>
        visit.ScheduledDate == default ? "Unscheduled" : visit.ScheduledDate.ToString("d");

    private static string DisplayVisitType(VisitType visitType) => visitType switch
    {
        VisitType.AdHocVisit => "Ad-Hoc Visit",
        _ => "Service Package Visit"
    };

    private static string DisplayVisitStatus(VisitStatus status) => status switch
    {
        VisitStatus.Assigned => "Assigned to Employee",
        VisitStatus.InProgress => "In Progress",
        VisitStatus.Completed => "Complete",
        VisitStatus.Unscheduled or VisitStatus.Scheduled => "New",
        _ => status.ToString()
    };

    private bool UserMatchesMode(UserManagementRow row)
    {
        if (row.User.IsSystemAdmin || row.CompanyAccess.Count == 0)
        {
            return true;
        }

        return row.CompanyAccess.Any(access => access.Status != MembershipStatus.Removed && CompanyMatchesMode(access.Company));
    }

    private bool CompanyMatchesMode(Company company)
    {
        var type = companyTypes?.FirstOrDefault(t => string.Equals(t.Id, company.CompanyTypeId, StringComparison.OrdinalIgnoreCase));
        var searchable = type is null
            ? company.CompanyTypeId
            : $"{company.CompanyTypeId} {type.Name} {type.Description}";
        return appMode.IsPoolMode
            ? searchable.Contains("pool", StringComparison.OrdinalIgnoreCase)
            : ContainsAny(searchable, "landscape", "landscaping", "lawn", "yard", "tree");
    }

    private static bool ContainsAny(string value, params string[] terms) =>
        terms.Any(term => value.Contains(term, StringComparison.OrdinalIgnoreCase));

    private static bool IsChecked(ChangeEventArgs args) => args.Value is bool value && value;

    private static string GetRoleDescription(CompanyRole role) => role switch
    {
        CompanyRole.CompanyAdmin => "Business owner or office admin",
        CompanyRole.CompanyUser => "Business user field workspace",
        CompanyRole.CompanyClientUser => "Business client service portal",
        _ => role.ToString()
    };

    private IReadOnlyList<FeatureLink> GetFeatureLinks(CompanyRole role) => role switch
    {
        CompanyRole.CompanyAdmin =>
        [
            new("Company Dashboard", "company"),
            new("Clients", "clients"),
            new("Schedule", "schedule")
        ],
        CompanyRole.CompanyUser =>
        [
            new("Field Today", "field")
        ],
        CompanyRole.CompanyClientUser => GetClientUserFeatureLinks(),
        _ => []
    };

    private IReadOnlyList<FeatureLink> GetClientUserFeatureLinks()
    {
        var links = new List<FeatureLink>();
        if (appMode.IsPoolMode)
        {
            links.Add(new("Pool Equipment", "poolequipment"));
        }

        links.Add(new("General Info", "profile"));
        links.Add(new("Service History", "client-portal"));
        return links;
    }

    private sealed record FeatureLink(string Label, string Href);

    private sealed record DashboardApprovalRow(
        AppUser User,
        Company Company,
        CompanyRole Role);

    private sealed class BusinessEmployeeVisitForm
    {
        public ServiceVisit Visit { get; set; } = null!;
        public string NotesToBusinessClient { get; set; } = "";
        public string NotesToServiceClient { get; set; } = "";
        public string InternalNotes { get; set; } = "";
        public IReadOnlyList<string> CompletedServiceIds { get; set; } = [];
        public IReadOnlyList<string> OutOfScopeServiceIds { get; set; } = [];
        public string ServiceFilter { get; set; } = "";

        public static BusinessEmployeeVisitForm FromVisit(ServiceVisit visit) => new()
        {
            Visit = visit,
            NotesToBusinessClient = visit.NotesToBusinessClient,
            NotesToServiceClient = visit.NotesToServiceClient,
            InternalNotes = visit.InternalNotes,
            CompletedServiceIds = visit.CompletedServiceIds ?? [],
            OutOfScopeServiceIds = visit.OutOfScopeServiceIds ?? []
        };
    }

    private sealed class ServiceHistoryForm
    {
        public string Id { get; set; } = "";
        public string ServiceId { get; set; } = "";
        public DateTime ServiceDate { get; set; } = DateTime.Today;
        public string Notes { get; set; } = "";
        public bool IsEditing { get; set; }

        public static ServiceHistoryForm FromItem(IndependentHomeOwnerServiceHistoryItem item) => new()
        {
            Id = item.Id,
            ServiceId = item.ServiceId ?? "",
            ServiceDate = item.ServiceDateTime.LocalDateTime.Date,
            Notes = item.Notes,
            IsEditing = true
        };
    }
}
