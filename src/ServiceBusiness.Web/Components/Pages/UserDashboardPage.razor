                            <th>Assigned To</th>
                            <th>Status</th>
                            <th class="actions">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var visit in BusinessOwnerPendingVisits)
                        {
                            <tr>
                                <td>@DisplayVisitType(visit.VisitType)</td>
                                <td>@DisplayVisitDate(visit)</td>
                                <td>@DisplayVisitName(visit)</td>
                                <td>@GetBusinessOwnerClientName(visit)</td>
                                <td>
                                    <select class="form-control compact-control" value="@GetBusinessOwnerVisitAssignee(visit)" @onchange="args => SetBusinessOwnerVisitAssignee(visit.Id, args.Value?.ToString() ?? string.Empty)">
                                        <option value="">Unassigned</option>
                                        @foreach (var employee in businessOwnerEmployees)
                                        {
                                            <option value="@employee.User.Id">@employee.User.DisplayName</option>
                                        }
                                    </select>
                                </td>
                                <td>@DisplayVisitStatus(visit.Status)</td>
                                <td class="actions">
                                    <button class="icon-button icon-only" type="button" title="Assign visit" aria-label="Assign visit" disabled="@string.IsNullOrWhiteSpace(GetBusinessOwnerVisitAssignee(visit))" @onclick="() => AssignBusinessOwnerVisitAsync(visit)">
                                        <span class="action-icon check-icon" aria-hidden="true"></span>
                                    </button>
                                    <a class="icon-button icon-only" href="visits" title="Edit visit" aria-label="Edit visit">
                                        <span class="action-icon edit-icon" aria-hidden="true"></span>
                                    </a>
                                    <button class="icon-button icon-only" type="button" title="Show visit info" aria-label="Show visit info" @onclick="() => ShowVisitInfo(visit)">
                                        <span class="action-icon info-icon" aria-hidden="true"></span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>;

    private RenderFragment BusinessEmployeeVisitsTable(IReadOnlyList<ServiceHistoryItem> rows, bool allowComplete, bool allowReopen, bool allowEdit, string emptyText) => @<div>
        @if (rows.Count == 0)
        {
            <p>@emptyText</p>
        }
        else
        {
            <div class="management-table-wrap">
                <table class="management-table">
                    <thead>
                        <tr>
                            <th>Visit Date</th>
                            <th>Visit Name</th>
                            <th>Business Client</th>
                            <th>Status</th>
                            <th>Notes</th>
                            <th class="actions">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in rows)
                        {
                            <tr>
                                <td>@DisplayVisitDate(item.Visit)</td>
                                <td>@DisplayVisitName(item.Visit)</td>
                                <td>@item.Client.DisplayName</td>
                                <td>@DisplayVisitStatus(item.Visit.Status)</td>
                                <td>@item.Visit.NotesToBusinessClient</td>
                                <td class="actions">
                                    @if (allowComplete)
                                    {
                                        <button class="icon-button icon-only" type="button" title="Complete visit" aria-label="Complete visit" @onclick="() => CompleteBusinessEmployeeVisitAsync(item.Visit)">
                                            <span class="action-icon check-icon" aria-hidden="true"></span>
                                        </button>
                                    }
                                    @if (allowReopen)
                                    {
                                        <button class="icon-button icon-only" type="button" title="Mark in progress" aria-label="Mark in progress" @onclick="() => ReopenBusinessEmployeeVisitAsync(item.Visit)">
                                            <span class="action-icon edit-icon" aria-hidden="true"></span>
                                        </button>
                                    }
                                    @if (allowEdit)
                                    {
                                        <button class="icon-button icon-only" type="button" title="Edit visit" aria-label="Edit visit" @onclick="() => EditBusinessEmployeeVisit(item.Visit)">
                                            <span class="action-icon edit-icon" aria-hidden="true"></span>
                                        </button>
                                    }
                                    <button class="icon-button icon-only" type="button" title="Show visit info" aria-label="Show visit info" @onclick="() => ShowVisitInfo(item.Visit)">
                                        <span class="action-icon info-icon" aria-hidden="true"></span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>;

    private async Task SaveHomeOwnerServiceItemAsync()
    {
        await RunHomeOwnerActionAsync(async () =>
        {
            var item = serviceHistoryForm.IsEditing
                ? await HomeOwnerService.UpdateServiceHistoryItemAsync(
                    serviceHistoryForm.Id,
                    serviceHistoryForm.ServiceId,
                    DateOnly.FromDateTime(serviceHistoryForm.ServiceDate),
                    serviceHistoryForm.Notes)
                : await HomeOwnerService.AddServiceHistoryItemAsync(
                    serviceHistoryForm.ServiceId,
                    DateOnly.FromDateTime(serviceHistoryForm.ServiceDate),
                    serviceHistoryForm.Notes);

            ResetServiceHistoryForm();
            serviceHistoryEditorExpanded = false;
            message = $"{item.ServiceName} service item was saved for {item.ServiceDateTime.ToLocalTime():d}.";
        });
    }

    private async Task DeleteHomeOwnerServiceItemAsync(IndependentHomeOwnerServiceHistoryItem item)
    {
        await RunHomeOwnerActionAsync(async () =>
        {
            await HomeOwnerService.DeleteServiceHistoryItemAsync(item.Id);
            if (string.Equals(serviceHistoryForm.Id, item.Id, StringComparison.OrdinalIgnoreCase))
            {
                ResetServiceHistoryForm();
                serviceHistoryEditorExpanded = false;
            }

            message = $"{GetServiceHistoryName(item)} service item was deleted.";
        });
    }

    private async Task RunHomeOwnerActionAsync(Func<Task> action)
    {
        message = null;
        errorMessage = null;

        try
        {
            await action();
            homeOwnerDashboard = await HomeOwnerService.GetDashboardAsync();
            homeOwnerCatalog = await CompanyAdminService.GetCatalogOverviewAsync(CurrentUser.UserId);
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadBusinessClientDashboardAsync()
    {
        businessClientPoolEquipment = appMode.IsPoolMode
            ? await ClientPortalService.GetCurrentUserPoolEquipmentOverviewAsync()
            : new PoolEquipmentOverview([]);
        businessClientVisits = await ClientPortalService.GetCurrentUserVisitsAsync();
        businessClientVisitNotes = businessClientVisits.ToDictionary(visit => visit.Id, visit => visit.NotesToServiceClient, StringComparer.OrdinalIgnoreCase);
        businessClientServices = await ClientPortalService.GetCurrentUserServicesAsync();
        businessClient = await ClientPortalService.GetCurrentUserClientAsync();
        businessClientGlobalCatalog = await CompanyAdminService.GetCatalogOverviewAsync(appMode.GlobalCatalogCompanyId);
        businessClientServicePackage = await ClientPortalService.GetCurrentUserServicePackageAsync(appMode.GlobalCatalogCompanyId);
    }

    private async Task LoadBusinessOwnerDashboardAsync()
    {
        var companyId = BusinessOwnerAccess?.Company.Id ?? "";
        if (string.IsNullOrWhiteSpace(companyId))
        {
            return;
        }

        companyDashboard = await CompanyAdminService.GetDashboardAsync(companyId, DateOnly.FromDateTime(DateTime.Today));
        businessOwnerServicePackages = await CompanyAdminService.GetServicePackagesAsync(companyId);
        businessOwnerVisits = await CompanyAdminService.GetVisitsAsync(companyId);
        businessOwnerClients = (await CompanyAdminService.GetClientsAsync(companyId))
            .Where(client => client.IsActive)
            .OrderBy(client => client.DisplayName)
            .ToList();
        businessOwnerEmployees = (await CompanyAdminService.GetCompanyUserManagementOverviewAsync(companyId)).Users
            .Where(row => row.Membership.Role == CompanyRole.CompanyUser && row.Membership.Status == MembershipStatus.Active)
            .OrderBy(row => row.User.DisplayName)
            .ToList();
        businessOwnerVisitAssignees = businessOwnerVisits.ToDictionary(
            visit => visit.Id,
            visit => visit.AssignedUserId ?? string.Empty,
            StringComparer.OrdinalIgnoreCase);
    }

    private async Task LoadBusinessEmployeeDashboardAsync()
    {
        businessEmployeeCompanyId = BusinessEmployeeAccess?.Company.Id ?? "";
        if (string.IsNullOrWhiteSpace(businessEmployeeCompanyId))
        {
            businessEmployeeTodayVisits = [];
            businessEmployeeUpcomingVisits = [];
            businessEmployeeCompletedVisits = [];
            businessEmployeeServices = [];
            return;
        }

        businessEmployeeTodayVisits = await FieldWorkService.GetTodayAssignedVisitsAsync(businessEmployeeCompanyId);
        businessEmployeeUpcomingVisits = await FieldWorkService.GetUpcomingAssignedVisitsAsync(businessEmployeeCompanyId);
        businessEmployeeCompletedVisits = await FieldWorkService.GetRecentlyCompletedAssignedVisitsAsync(businessEmployeeCompanyId);
        var companyServices = await CompanyAdminService.GetServicesAsync(businessEmployeeCompanyId);
        var globalCatalog = await CompanyAdminService.GetCatalogOverviewAsync(appMode.GlobalCatalogCompanyId);
        businessEmployeeServices = companyServices
            .Concat(globalCatalog.ServiceGroups.SelectMany(group => group.Services))
            .Where(service => service.IsActive)
            .GroupBy(service => service.Id, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .OrderBy(service => service.Name)
            .ToList();
    }

    private async Task RunBusinessClientActionAsync(Func<Task> action)
    {
        message = null;
        errorMessage = null;

        try
        {
            await action();
            await LoadBusinessClientDashboardAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task SaveBusinessClientVisitNotesAsync(ServiceVisit visit)
    {
        await RunBusinessClientActionAsync(async () =>
        {
            await ClientPortalService.UpdateCurrentUserVisitServiceProviderNotesAsync(
                visit.Id,
                GetBusinessClientVisitNote(visit));
            message = "Visit notes were saved.";
        });
    }

    private async Task CompleteBusinessEmployeeVisitAsync(ServiceVisit visit)
    {
        message = null;
        errorMessage = null;
        try
        {
            await FieldWorkService.CompleteVisitAsync(
                businessEmployeeCompanyId,
                visit.Id,
                visit.PlannedServiceIds,
                [],
                visit.NotesToBusinessClient,
                visit.InternalNotes);
            message = "Visit was marked complete.";
            await LoadBusinessEmployeeDashboardAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task ReopenBusinessEmployeeVisitAsync(ServiceVisit visit)
    {
        message = null;
        errorMessage = null;
