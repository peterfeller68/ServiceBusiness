    private void EditBusinessEmployeeVisit(ServiceVisit visit)
    {
        businessEmployeeVisitForm = BusinessEmployeeVisitForm.FromVisit(visit);
    }

    private void CancelBusinessEmployeeVisitEdit()
    {
        businessEmployeeVisitForm = null;
    }

    private async Task SaveBusinessEmployeeVisitEditAsync()
    {
        if (businessEmployeeVisitForm is null)
        {
            return;
        }

        message = null;
        errorMessage = null;
        try
        {
            await FieldWorkService.UpdateAssignedVisitDetailsAsync(
                businessEmployeeCompanyId,
                businessEmployeeVisitForm.Visit.Id,
                businessEmployeeVisitForm.NotesToBusinessClient,
                businessEmployeeVisitForm.NotesToServiceClient,
                businessEmployeeVisitForm.InternalNotes,
                businessEmployeeVisitForm.CompletedServiceIds,
                businessEmployeeVisitForm.OutOfScopeServiceIds);
            businessEmployeeVisitForm = null;
            message = "Visit details were saved.";
            await LoadBusinessEmployeeDashboardAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void SetBusinessEmployeeCompletedService(string serviceId, bool isComplete)
    {
        if (businessEmployeeVisitForm is null)
        {
            return;
        }

        var ids = businessEmployeeVisitForm.CompletedServiceIds.ToList();
        ids.RemoveAll(id => string.Equals(id, serviceId, StringComparison.OrdinalIgnoreCase));
        if (isComplete)
        {
            ids.Add(serviceId);
        }

        businessEmployeeVisitForm.CompletedServiceIds = ids;
    }

    private void ChooseBusinessEmployeeOutOfScopeService(string serviceId)
    {
        if (businessEmployeeVisitForm is null)
        {
            return;
        }

        var ids = businessEmployeeVisitForm.OutOfScopeServiceIds.ToList();
        if (!ids.Contains(serviceId, StringComparer.OrdinalIgnoreCase))
        {
            ids.Add(serviceId);
        }

        businessEmployeeVisitForm.OutOfScopeServiceIds = ids;
    }

    private void RemoveBusinessEmployeeOutOfScopeService(string serviceId)
    {
        if (businessEmployeeVisitForm is null)
        {
            return;
        }

        var ids = businessEmployeeVisitForm.OutOfScopeServiceIds.ToList();
        ids.RemoveAll(id => string.Equals(id, serviceId, StringComparison.OrdinalIgnoreCase));
        businessEmployeeVisitForm.OutOfScopeServiceIds = ids;
    }

    private async Task AssignBusinessOwnerVisitAsync(ServiceVisit visit)
    {
        message = null;
        errorMessage = null;
        try
        {
            var assignee = GetBusinessOwnerVisitAssignee(visit);
            await CompanyAdminService.AssignVisitAsync(visit.CompanyId, visit.Id, assignee);
            message = "Visit was assigned.";
            await LoadBusinessOwnerDashboardAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task ApproveSystemRequestAsync(DashboardApprovalRow request, bool isApproved)
    {
        if (!isApproved)
        {
            return;
        }

        await PlatformAdminService.SetCompanyMembershipApprovalAsync(request.Company.Id, request.User.Id, request.Role, true);
        userOverview = await PlatformAdminService.GetUserManagementOverviewAsync();
    }

    private async Task ApproveAllSystemRequestsAsync()
    {
        foreach (var request in SystemPendingRequests.ToList())
        {
            await PlatformAdminService.SetCompanyMembershipApprovalAsync(request.Company.Id, request.User.Id, request.Role, true);
        }

        userOverview = await PlatformAdminService.GetUserManagementOverviewAsync();
        message = "All pending system approvals were approved.";
    }

    private async Task ApproveBusinessRequestAsync(AccessRequest request, bool isApproved)
    {
        if (!isApproved)
        {
            return;
        }

        await CompanyAdminService.DecideAccessRequestAsync(request.Company.Id, request.User.Id, request.Membership.Role, MembershipStatus.Active);
        companyDashboard = await CompanyAdminService.GetDashboardAsync(request.Company.Id, DateOnly.FromDateTime(DateTime.Today));
    }

    private async Task ApproveAllBusinessRequestsAsync()
    {
        if (companyDashboard is null)
        {
            return;
        }

        foreach (var request in companyDashboard.PendingAccessRequests.ToList())
        {
            await CompanyAdminService.DecideAccessRequestAsync(request.Company.Id, request.User.Id, request.Membership.Role, MembershipStatus.Active);
        }

        companyDashboard = await CompanyAdminService.GetDashboardAsync(companyDashboard.Company.Id, DateOnly.FromDateTime(DateTime.Today));
        message = "All pending business approvals were approved.";
    }

