@page "/dashboard"
@rendermode InteractiveServer
@using ServiceBusiness.Application
@using ServiceBusiness.Domain
@inject OnboardingService OnboardingService
@inject IndependentHomeOwnerService HomeOwnerService
@inject PlatformAdminService PlatformAdminService
@inject CompanyAdminService CompanyAdminService
@inject ClientPortalService ClientPortalService
@inject FieldWorkService FieldWorkService
@inject ICurrentUserContext CurrentUser
@inject ServiceBusiness.Web.ApplicationModeService ApplicationMode

<PageTitle>Dashboard</PageTitle>

@if (overview is null)
{
    <p>Loading account...</p>
}
else if (IsIndependentHomeOwner)
{
    <section class="dashboard-hero" style="background-image: linear-gradient(90deg, rgba(13, 30, 26, .68), rgba(13, 30, 26, .22)), url('@appMode.HeroImageUrl');">
        <div>
            <p class="eyebrow">Pool Service Operations</p>
            <h1>PoolShark</h1>
        </div>
    </section>

    <section class="page-header">
        <div>
            <p class="eyebrow">Dashboard</p>
            <p class="lede">@homeOwnerDashboard?.Profile.HomeAddress</p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="notice success">@message</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="notice error">@errorMessage</div>
    }

    @if (homeOwnerDashboard is null)
    {
        <p>Loading homeowner dashboard...</p>
    }
    else
    {
        <section class="management-panel">
            <div class="management-panel-header">
                <h2>Pool Equipment</h2>
                <div class="management-panel-actions">
                    <button class="icon-button" type="button" title="Toggle pool equipment" @onclick="TogglePoolEquipmentPanel">@(poolEquipmentExpanded ? "^" : "v")</button>
                </div>
            </div>
            @if (poolEquipmentExpanded)
            {
                <div class="management-panel-body">
                    <div class="management-table-wrap">
                        <table class="management-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Manufacturer</th>
                                    <th>Equipment</th>
                                    <th>Comment</th>
                                    <th class="actions">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in homeOwnerDashboard.PoolEquipment.CategoryGroups)
                                {
                                    @foreach (var item in group.Items)
                                    {
                                        <tr>
                                            <td>@group.Category.Name</td>
                                            <td>@item.Manufacturer</td>
                                            <td>@item.Name</td>
                                            <td>@item.Comment</td>
                                            <td class="actions">
                                                <button class="icon-button icon-only" type="button" title="Show equipment info" aria-label="Show equipment info" @onclick="() => ShowEquipmentInfo(item)">
                                                    <span class="action-icon info-icon" aria-hidden="true"></span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>

        <section class="management-panel">
            <div class="management-panel-header">
                <h2>Service History</h2>
                <div class="management-panel-actions">
                    <button class="button primary" type="button" @onclick="ShowCreateHomeOwnerServiceItem">Add Service Item</button>
                    <button class="icon-button" type="button" title="Toggle service history" @onclick="ToggleServiceHistoryPanel">@(serviceHistoryExpanded ? "^" : "v")</button>
                </div>
            </div>
            @if (serviceHistoryExpanded)
            {
                <div class="management-panel-body">
                    @if (serviceHistoryEditorExpanded)
                    {
                        <EditForm Model="serviceHistoryForm" OnValidSubmit="SaveHomeOwnerServiceItemAsync" FormName="homeowner-service-history-editor">
                            <div class="editor-panel">
                                <h3>@(serviceHistoryForm.IsEditing ? "Edit Service Item" : "Add Service Item")</h3>
                                <div class="form-grid">
                                    <label>
                                        Service
                                        <InputSelect class="form-control" @bind-Value="serviceHistoryForm.ServiceId">
                                            <option value="">Choose service</option>
                                            @foreach (var service in HomeOwnerServices)
                                            {
                                                <option value="@service.Id">@service.Name</option>
                                            }
                                        </InputSelect>
                                    </label>
                                    <label>
                                        Date
                                        <InputDate class="form-control" @bind-Value="serviceHistoryForm.ServiceDate" />
                                    </label>
                                    <label class="wide">
                                        Notes
                                        <InputTextArea class="form-control" @bind-Value="serviceHistoryForm.Notes" />
                                    </label>
                                </div>
                                <div class="form-actions">
                                    <button class="button primary" type="submit" disabled="@(HomeOwnerServices.Count == 0)">Save Service Item</button>
                                    <button class="button" type="button" @onclick="HideHomeOwnerServiceItemEditor">Cancel</button>
                                </div>
                                @if (HomeOwnerServices.Count == 0)
                                {
                                    <p class="form-note">Define services under Settings before adding service history.</p>
                                }
                            </div>
                        </EditForm>
                    }
                    @if (homeOwnerDashboard.ServiceHistory.Count == 0)
                    {
                        <p>No service history items yet.</p>
                    }
                    else
                    {
                        <div class="management-table-wrap">
                            <table class="management-table">
                                <thead>
                                    <tr>
                                        <th>Date/Time</th>
                                        <th>Service</th>
                                        <th>Notes</th>
                                        <th class="actions">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in homeOwnerDashboard.ServiceHistory)
                                    {
                                        <tr>
                                            <td>@item.ServiceDateTime.ToLocalTime().ToString("g")</td>
                                            <td>@GetServiceHistoryName(item)</td>
                                            <td>@item.Notes</td>
                                            <td class="actions">
                                                <button class="icon-button icon-only" type="button" title="Edit service item" aria-label="Edit service item" @onclick="() => EditHomeOwnerServiceItem(item)">
                                                    <span class="action-icon edit-icon" aria-hidden="true"></span>
                                                </button>
                                                <button class="icon-button icon-only danger" type="button" title="Delete service item" aria-label="Delete service item" @onclick="() => DeleteHomeOwnerServiceItemAsync(item)">
                                                    <span class="action-icon delete-icon" aria-hidden="true"></span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        </section>
    }
}
else if (IsPendingApprovalOnly)
{
    <section class="dashboard-hero" style="background-image: linear-gradient(90deg, rgba(13, 30, 26, .68), rgba(13, 30, 26, .22)), url('@appMode.HeroImageUrl');">
        <div>
            <p class="eyebrow">@appMode.ProductCategory</p>
            <h1>Pending Approval</h1>
        </div>
    </section>

    <section class="page-header">
        <div>
            <p class="eyebrow">Dashboard</p>
            <h1>Waiting for business owner approval</h1>
            <p class="lede">Your access request has been submitted. Features unlock after the business owner approves your account.</p>
        </div>
    </section>

    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Pending Access</h2>
        </div>
        <div class="management-panel-body">
            <div class="data-list">
                @foreach (var access in PendingApprovalAccess)
                {
                    <article class="row-card">
                        <div>
                            <strong>@access.Company.Name</strong>
                            <p>@GetRoleDescription(access.Role)</p>
                            <small>Access is pending; a business owner must approve it before features unlock.</small>
                        </div>
                        <div class="row-actions">
                            <span class="status-pill">@access.Status</span>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}
else if (IsSystemAdmin)
{
    <section class="dashboard-hero" style="background-image: linear-gradient(90deg, rgba(13, 30, 26, .68), rgba(13, 30, 26, .22)), url('@appMode.HeroImageUrl');">
        <div>
            <p class="eyebrow">System Administrator</p>
            <h1>@appMode.ProductName Platform</h1>
        </div>
    </section>

    <section class="page-header">
        <div>
            <p class="eyebrow">System Dashboard</p>
            <h1>@overview.User.DisplayName</h1>
            <p class="lede">Platform health, tenant setup, users, access requests, and catalog controls.</p>
        </div>
    </section>

    @if (companyTypes is null || companies is null || emailLogs is null || userOverview is null)
    {
        <p>Loading system dashboard...</p>
    }
    else
    {
        <section class="section">
            <h2>System Health</h2>
            <div class="metric-grid">
                <a class="metric metric-button" href="admin/service-clients">
                    <span>Service Clients</span>
                    <strong>@FilteredCompanies.Count</strong>
                </a>
                <a class="metric metric-button" href="admin/clients">
                    <span>Business Clients</span>
                    <strong>@SystemBusinessClientCount</strong>
                </a>
                <a class="metric metric-button" href="admin/users">
                    <span>Users</span>
                    <strong>@FilteredSystemUsers.Count</strong>
                </a>
                @if (appMode.IsPoolMode)
                {
                    <a class="metric metric-button" href="admin/catalog/poolequipment">
                        <span>Pool Equipment</span>
                        <strong>@SystemPoolEquipmentCount</strong>
                    </a>
                    <a class="metric metric-button" href="poolequipment">
                        <span>Pool Configurations</span>
                        <strong>@SystemPoolConfigurationCount</strong>
                    </a>
                }
                <a class="metric metric-button" href="admin/catalog/materials">
                    <span>Materials</span>
                    <strong>@SystemMaterialCount</strong>
                </a>
                <a class="metric metric-button" href="admin/catalog/services">
                    <span>Services</span>
                    <strong>@SystemServiceCount</strong>
                </a>
                <a class="metric metric-button" href="admin/catalog/servicepackages">
                    <span>Service Packages</span>
                    <strong>@SystemServicePackageCount</strong>
                </a>
            </div>
        </section>

        <section class="management-panel">
            <div class="management-panel-header">
                <h2>Approvals</h2>
                <div class="management-panel-actions">
                    <button class="button primary" type="button" @onclick="ApproveAllSystemRequestsAsync" disabled="@(SystemPendingRequests.Count == 0)">Approve All</button>
                    <button class="icon-button" type="button" title="Toggle approvals" @onclick="ToggleApprovalsPanel">@(approvalsExpanded ? "^" : "v")</button>
                </div>
            </div>
            @if (approvalsExpanded)
            {
                <div class="management-panel-body">
                    @SystemApprovalsTable()
                </div>
            }
        </section>

        <section class="section">
            <h2>System Workspaces</h2>
            <div class="quick-link-grid">
                <a class="row-card quick-link" href="admin/service-clients">
                    <strong>Service Clients</strong>
                    <p>Registered service clients and setup state.</p>
                </a>
                <a class="row-card quick-link" href="admin/clients">
                    <strong>Business Clients</strong>
                    <p>Homeowner and customer records across service clients.</p>
                </a>
                <a class="row-card quick-link" href="admin/users">
                    <strong>Users</strong>
                    <p>User status, system-admin access, and pending memberships.</p>
                </a>
                @if (appMode.IsPoolMode)
                {
                    <a class="row-card quick-link" href="admin/catalog/poolequipment">
                        <strong>Pool Equipment</strong>
                        <p>Global equipment categories and equipment models.</p>
                    </a>
                    <a class="row-card quick-link" href="poolequipment">
                        <strong>Pool Configurations</strong>
                        <p>Choose a client and manage configured pool equipment.</p>
                    </a>
                }
                <a class="row-card quick-link" href="admin/catalog/materials">
                    <strong>Materials</strong>
                    <p>Global material categories and material catalog items.</p>
                </a>
                <a class="row-card quick-link" href="admin/catalog/services">
                    <strong>Services</strong>
                    <p>Global service categories and service catalog items.</p>
                </a>
                <a class="row-card quick-link" href="admin/catalog/servicepackages">
                    <strong>Service Packages</strong>
                    <p>Global service packages for the current service type.</p>
                </a>
            </div>
        </section>
    }
}
else if (IsBusinessOwner)
{
    <section class="dashboard-hero" style="background-image: linear-gradient(90deg, rgba(13, 30, 26, .68), rgba(13, 30, 26, .22)), url('@appMode.HeroImageUrl');">
        <div>
            <p class="eyebrow">Business Owner</p>
            <h1>@BusinessOwnerAccess?.Company.Name</h1>
        </div>
    </section>

    <section class="page-header">
        <div>
            <p class="eyebrow">Business Dashboard</p>
            <h1>@BusinessOwnerAccess?.Company.Name</h1>
            <p class="lede">Customers, staff, schedule, catalog, and pending access requests.</p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="notice success">@message</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="notice error">@errorMessage</div>
    }

    @if (companyDashboard is null)
    {
        <p>Loading business dashboard...</p>
    }
    else
    {
        <section class="section">
            <h2>System Health</h2>
            <div class="metric-grid">
                <a class="metric metric-button" href="clients">
                    <span>Business Clients</span>
                    <strong>@companyDashboard.CustomerCount</strong>
                </a>
                <a class="metric metric-button" href="company/users">
                    <span>Users</span>
                    <strong>@companyDashboard.EmployeeCount</strong>
                </a>
                @if (appMode.IsPoolMode)
                {
                    <a class="metric metric-button" href="poolequipment">
                        <span>Pool Configurations</span>
                        <strong>@companyDashboard.CustomerCount</strong>
                    </a>
                }
                <a class="metric metric-button" href="catalog/materials">
                    <span>Materials</span>
                    <strong>@companyDashboard.MaterialCount</strong>
                </a>
                <a class="metric metric-button" href="catalog/services">
                    <span>Services</span>
                    <strong>@companyDashboard.ServiceCount</strong>
                </a>
                <a class="metric metric-button" href="catalog/servicepackages">
                    <span>Service Packages</span>
                    <strong>@BusinessOwnerServicePackageCount</strong>
                </a>
            </div>
        </section>

        <section class="management-panel">
            <div class="management-panel-header">
                <h2>Approvals</h2>
                <div class="management-panel-actions">
                    <button class="button primary" type="button" @onclick="ApproveAllBusinessRequestsAsync" disabled="@(companyDashboard.PendingAccessRequests.Count == 0)">Approve All</button>
                    <button class="icon-button" type="button" title="Toggle approvals" @onclick="ToggleApprovalsPanel">@(approvalsExpanded ? "^" : "v")</button>
                </div>
            </div>
            @if (approvalsExpanded)
            {
                <div class="management-panel-body">
                    @BusinessApprovalsTable()
                </div>
            }
        </section>

        <section class="management-panel">
            <div class="management-panel-header">
                <h2>Unscheduled and Scheduled Visits</h2>
                <div class="management-panel-actions">
                    <button class="icon-button" type="button" title="Toggle visits" @onclick="ToggleBusinessOwnerVisitsPanel">@(businessOwnerVisitsExpanded ? "^" : "v")</button>
                </div>
            </div>
            @if (businessOwnerVisitsExpanded)
            {
                <div class="management-panel-body">
                    @BusinessOwnerPendingVisitsTable()
                </div>
            }
        </section>

        <section class="section">
            <h2>System Workspaces</h2>
            <div class="quick-link-grid">
                <a class="row-card quick-link" href="clients">
                    <strong>Business Clients</strong>
                    <p>Create and manage customer records.</p>
                </a>
                <a class="row-card quick-link" href="company/users">
                    <strong>Users</strong>
                    <p>Approve access and maintain team roles.</p>
                </a>
                <a class="row-card quick-link" href="catalog/materials">
                    <strong>Materials</strong>
                    <p>Manage material categories and items.</p>
                </a>
                <a class="row-card quick-link" href="catalog/services">
                    <strong>Services</strong>
                    <p>Manage service categories and offerings.</p>
                </a>
                <a class="row-card quick-link" href="catalog/servicepackages">
                    <strong>Service Packages</strong>
                    <p>Manage service packages and included services.</p>
                </a>
            </div>
        </section>
    }
}
else if (IsBusinessClient)
{
    <section class="dashboard-hero" style="background-image: linear-gradient(90deg, rgba(13, 30, 26, .68), rgba(13, 30, 26, .22)), url('@appMode.HeroImageUrl');">
        <div>
            <p class="eyebrow">Business Client</p>
            <h1>@BusinessClientAccess?.Company.Name</h1>
        </div>
    </section>

    <section class="page-header">
        <div>
            <p class="eyebrow">Client Dashboard</p>
            <h1>@overview.User.DisplayName</h1>
            <p class="lede">Your pool equipment, account information, and visits.</p>
        </div>
    </section>

    @BusinessClientDashboardContent()
}
else if (IsBusinessEmployee)
{
    <section class="dashboard-hero" style="background-image: linear-gradient(90deg, rgba(13, 30, 26, .68), rgba(13, 30, 26, .22)), url('@appMode.HeroImageUrl');">
        <div>
            <p class="eyebrow">Business Employee</p>
            <h1>Assigned Visits</h1>
        </div>
    </section>

    <section class="page-header">
        <div>
            <p class="eyebrow">Dashboard</p>
            <p class="lede">Today, upcoming work, and recently completed visits.</p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="notice success">@message</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="notice error">@errorMessage</div>
    }

    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Assigned Visits Today</h2>
            <div class="management-panel-actions">
                <button class="icon-button" type="button" title="Toggle assigned visits today" @onclick="ToggleBusinessEmployeeTodayPanel">@(businessEmployeeTodayExpanded ? "^" : "v")</button>
            </div>
        </div>
        @if (businessEmployeeTodayExpanded)
        {
            <div class="management-panel-body">
                @BusinessEmployeeVisitsTable(businessEmployeeTodayVisits, true, false, true, "No assigned visits for today.")
            </div>
        }
    </section>

    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Upcoming Visits</h2>
            <div class="management-panel-actions">
                <button class="icon-button" type="button" title="Toggle upcoming visits" @onclick="ToggleBusinessEmployeeUpcomingPanel">@(businessEmployeeUpcomingExpanded ? "^" : "v")</button>
            </div>
        </div>
        @if (businessEmployeeUpcomingExpanded)
        {
            <div class="management-panel-body">
                @BusinessEmployeeVisitsTable(businessEmployeeUpcomingVisits, false, false, false, "No upcoming assigned visits.")
            </div>
        }
    </section>

    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Recently Completed Visits</h2>
            <div class="management-panel-actions">
                <button class="icon-button" type="button" title="Toggle recently completed visits" @onclick="ToggleBusinessEmployeeCompletedPanel">@(businessEmployeeCompletedExpanded ? "^" : "v")</button>
            </div>
        </div>
        @if (businessEmployeeCompletedExpanded)
        {
            <div class="management-panel-body">
                @BusinessEmployeeVisitsTable(businessEmployeeCompletedVisits, false, true, true, "No recently completed visits.")
            </div>
        }
    </section>
}
else
{
    <section class="dashboard-hero" style="background-image: linear-gradient(90deg, rgba(13, 30, 26, .68), rgba(13, 30, 26, .22)), url('@appMode.HeroImageUrl');">
        <div>
            <p class="eyebrow">@appMode.ProductCategory</p>
            <h1>@appMode.ProductName Dashboard</h1>
        </div>
    </section>

    <section class="page-header">
        <div>
            <p class="eyebrow">Account Dashboard</p>
            <h1>@overview.User.DisplayName</h1>
            <p class="lede">@overview.User.Email</p>
            @if (overview.AuthenticationSkipped)
            {
                <p class="form-note">Test user authentication skipped.</p>
            }
        </div>
    </section>

    <div class="metric-grid">
        <div class="metric">
            <span>Companies</span>
            <strong>@overview.Companies.Count</strong>
        </div>
        <div class="metric">
            <span>Active access</span>
            <strong>@overview.Companies.Count(c => c.Status == MembershipStatus.Active)</strong>
        </div>
        <div class="metric">
            <span>Pending approval</span>
            <strong>@overview.Companies.Count(c => c.Status == MembershipStatus.Pending)</strong>
        </div>
    </div>

    <section class="section split">
        <div>
            <h2>Workspace access</h2>
            @if (overview.Companies.Count == 0)
            {
                <article class="row-card">
                    <div>
                        <strong>Independent homeowner workspace</strong>
                        <p>@(appMode.IsPoolMode ? "Manage your own pool equipment records without joining a service business." : "Manage your independent homeowner workspace without joining a service business.")</p>
                        @if (homeOwnerProfile is not null)
                        {
                            <small>@homeOwnerProfile.HomeAddress</small>
                        }
                    </div>
                    <div class="row-actions">
                        <span class="status-pill">Active</span>
                        @if (appMode.IsPoolMode)
                        {
                            <a class="button primary" href="poolequipment">Pool Equipment</a>
                        }
                    </div>
                </article>
            }
            else
            {
                <div class="data-list">
                    @foreach (var access in overview.Companies)
                    {
                        <article class="row-card">
                            <div>
                                <strong>@access.Company.Name</strong>
                                <p>@GetRoleDescription(access.Role)</p>
                                @if (access.Status != MembershipStatus.Active)
                                {
                                    <small>Access is @access.Status.ToString().ToLowerInvariant(); a business owner must approve it before features unlock.</small>
                                }
                            </div>
                            <div class="row-actions">
                                <span class="status-pill">@access.Status</span>
                                @if (access.Status == MembershipStatus.Active)
                                {
                                    @foreach (var link in GetFeatureLinks(access.Role))
                                    {
                                        <a class="button" href="@link.Href">@link.Label</a>
                                    }
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <aside class="callout">
            <strong>Account settings</strong>
            <p>Role, approval status, and test-user sign-in behavior are stored with the account model for this onboarding slice.</p>
        </aside>
    </section>
}

@if (dashboardEquipmentInfo is not null)
{
    <div class="photo-modal-backdrop" @onclick="CloseEquipmentInfo">
        <div class="photo-modal" @onclick:stopPropagation="true">
            <div class="photo-modal-header">
                <strong>@dashboardEquipmentInfo.Name</strong>
                <button class="icon-button icon-only" type="button" title="Close equipment info" aria-label="Close equipment info" @onclick="CloseEquipmentInfo">x</button>
            </div>
            <div class="data-list">
                <article class="row-card"><strong>Manufacturer</strong><p>@dashboardEquipmentInfo.Manufacturer</p></article>
                <article class="row-card"><strong>Model No</strong><p>@dashboardEquipmentInfo.ModelNo</p></article>
                <article class="row-card"><strong>Description</strong><p>@(string.IsNullOrWhiteSpace(dashboardEquipmentInfo.Description) ? "No description available." : dashboardEquipmentInfo.Description)</p></article>
                <article class="row-card"><strong>Comment</strong><p>@dashboardEquipmentInfo.Comment</p></article>
            </div>
        </div>
    </div>
}

@if (dashboardVisitInfo is not null)
{
    <div class="photo-modal-backdrop" @onclick="CloseVisitInfo">
        <div class="photo-modal" @onclick:stopPropagation="true">
            <div class="photo-modal-header">
                <strong>@DisplayVisitName(dashboardVisitInfo)</strong>
                <button class="icon-button icon-only" type="button" title="Close visit info" aria-label="Close visit info" @onclick="CloseVisitInfo">x</button>
            </div>
            <div class="data-list">
                <article class="row-card"><strong>ID</strong><p>@dashboardVisitInfo.Id</p></article>
                <article class="row-card"><strong>Service Client</strong><p>@dashboardVisitInfo.CompanyId</p></article>
                <article class="row-card"><strong>Business Client</strong><p>@GetDashboardVisitClientName(dashboardVisitInfo)</p></article>
