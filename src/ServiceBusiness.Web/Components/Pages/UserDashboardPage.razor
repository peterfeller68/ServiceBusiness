                <article class="row-card"><strong>Window</strong><p>@dashboardVisitInfo.ServiceWindowStart.ToString("t") - @dashboardVisitInfo.ServiceWindowEnd.ToString("t")</p></article>
                <article class="row-card"><strong>Status</strong><p>@DisplayVisitStatus(dashboardVisitInfo.Status)</p></article>
                <article class="row-card"><strong>Route Order</strong><p>@dashboardVisitInfo.RouteOrder</p></article>
                <article class="row-card"><strong>Planned Services</strong><p>@GetDashboardServiceNames(dashboardVisitInfo.PlannedServiceIds)</p></article>
                <article class="row-card"><strong>Completed Services</strong><p>@GetDashboardServiceNames(dashboardVisitInfo.CompletedServiceIds ?? [])</p></article>
                <article class="row-card"><strong>Out-of-Scope Services</strong><p>@GetDashboardServiceNames(dashboardVisitInfo.OutOfScopeServiceIds ?? [])</p></article>
                <article class="row-card"><strong>Out-of-Scope Materials</strong><p>@GetMaterialUsageText(dashboardVisitInfo.OutOfScopeMaterials ?? [])</p></article>
                <article class="row-card"><strong>Materials Used</strong><p>@GetMaterialUsageText(dashboardVisitInfo.MaterialsUsed ?? [])</p></article>
                <article class="row-card"><strong>Started</strong><p>@(dashboardVisitInfo.StartedUtc?.ToLocalTime().ToString("g") ?? "-")</p></article>
                <article class="row-card"><strong>Completed</strong><p>@(dashboardVisitInfo.CompletedUtc?.ToLocalTime().ToString("g") ?? "-")</p></article>
                <article class="row-card"><strong>Completed By</strong><p>@(string.IsNullOrWhiteSpace(dashboardVisitInfo.CompletedByUserId) ? "-" : dashboardVisitInfo.CompletedByUserId)</p></article>
                <article class="row-card"><strong>Notes</strong><p>@(string.IsNullOrWhiteSpace(dashboardVisitInfo.Notes) ? "-" : dashboardVisitInfo.Notes)</p></article>
                <article class="row-card"><strong>Notes To Business Client</strong><p>@(string.IsNullOrWhiteSpace(dashboardVisitInfo.NotesToBusinessClient) ? "-" : dashboardVisitInfo.NotesToBusinessClient)</p></article>
                <article class="row-card"><strong>Notes To Service Client</strong><p>@(string.IsNullOrWhiteSpace(dashboardVisitInfo.NotesToServiceClient) ? "-" : dashboardVisitInfo.NotesToServiceClient)</p></article>
                <article class="row-card"><strong>Internal Notes</strong><p>@(string.IsNullOrWhiteSpace(dashboardVisitInfo.InternalNotes) ? "-" : dashboardVisitInfo.InternalNotes)</p></article>
                <article class="row-card"><strong>Invoice</strong><p>@(string.IsNullOrWhiteSpace(dashboardVisitInfo.InvoiceId) ? "-" : dashboardVisitInfo.InvoiceId)</p></article>
            </div>
        </div>
    </div>
}

@if (businessEmployeeVisitForm is not null)
{
    <div class="photo-modal-backdrop" @onclick="CancelBusinessEmployeeVisitEdit">
        <div class="photo-modal" @onclick:stopPropagation="true">
            <div class="photo-modal-header">
                <strong>Edit @DisplayVisitName(businessEmployeeVisitForm.Visit)</strong>
                <button class="icon-button icon-only" type="button" title="Close visit editor" aria-label="Close visit editor" @onclick="CancelBusinessEmployeeVisitEdit">x</button>
            </div>
            <EditForm Model="businessEmployeeVisitForm" OnValidSubmit="SaveBusinessEmployeeVisitEditAsync" FormName="business-employee-visit-editor">
                <div class="form-grid">
                    <label class="wide">
                        Notes To Business Client
                        <InputTextArea class="form-control" @bind-Value="businessEmployeeVisitForm.NotesToBusinessClient" />
                    </label>
                    <label class="wide">
                        Notes To Service Client
                        <InputTextArea class="form-control" @bind-Value="businessEmployeeVisitForm.NotesToServiceClient" />
                    </label>
                    <label class="wide">
                        Internal Notes
                        <InputTextArea class="form-control" @bind-Value="businessEmployeeVisitForm.InternalNotes" />
                    </label>
                </div>

                <h3>Planned Services</h3>
                <div class="management-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th>Complete</th>
                                <th>Service</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var serviceId in businessEmployeeVisitForm.Visit.PlannedServiceIds)
                            {
                                <tr>
                                    <td>
                                        <label class="switch-control" title="Toggle completed service">
                                            <input type="checkbox" checked="@businessEmployeeVisitForm.CompletedServiceIds.Contains(serviceId, StringComparer.OrdinalIgnoreCase)" @onchange="args => SetBusinessEmployeeCompletedService(serviceId, IsChecked(args))" />
                                            <span></span>
                                        </label>
                                    </td>
                                    <td>@GetDashboardServiceName(serviceId)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <h3>Other Services Done</h3>
                @if (businessEmployeeVisitForm.OutOfScopeServiceIds.Count == 0)
                {
                    <p>No other services chosen for this visit.</p>
                }
                else
                {
                    <div class="management-table-wrap">
                        <table class="management-table">
                            <thead>
                                <tr>
                                    <th>Service</th>
                                    <th>Description</th>
                                    <th class="actions">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var serviceId in businessEmployeeVisitForm.OutOfScopeServiceIds)
                                {
                                    var service = GetDashboardService(serviceId);
                                    <tr>
                                        <td>@(service?.Name ?? serviceId)</td>
                                        <td>@(service?.Description ?? "")</td>
                                        <td class="actions">
                                            <button class="icon-button icon-only danger" type="button" title="Remove service" aria-label="Remove service" @onclick="() => RemoveBusinessEmployeeOutOfScopeService(serviceId)">
                                                <span class="action-icon delete-icon" aria-hidden="true"></span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="form-actions">
                    <button class="button primary" type="submit">Save Visit</button>
                    <button class="button" type="button" @onclick="CancelBusinessEmployeeVisitEdit">Cancel</button>
                </div>

                <h3>Choose Services</h3>
                <label class="wide">
                    Filter services
                    <input class="form-control" @bind="businessEmployeeVisitForm.ServiceFilter" @bind:event="oninput" />
                </label>
                <div class="management-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th>Service</th>
                                <th>Description</th>
                                <th class="actions">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var service in BusinessEmployeeFilteredOutOfScopeServices)
                            {
                                <tr>
                                    <td>@service.Name</td>
                                    <td>@service.Description</td>
                                    <td class="actions">
                                        <button class="icon-button icon-only" type="button" title="Choose service" aria-label="Choose service" @onclick="() => ChooseBusinessEmployeeOutOfScopeService(service.Id)">
                                            <span class="action-icon choose-icon" aria-hidden="true"></span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private UserAccessOverview? overview;
    private IndependentHomeOwnerDashboard? homeOwnerDashboard;
    private IndependentHomeOwnerProfile? homeOwnerProfile;
    private CatalogOverview? homeOwnerCatalog;
    private ServiceHistoryForm serviceHistoryForm = new();
    private IReadOnlyList<CompanyType>? companyTypes;
    private IReadOnlyList<Company>? companies;
    private IReadOnlyList<EmailLogEntry>? emailLogs;
    private PlatformUserManagementOverview? userOverview;
    private CompanyDashboard? companyDashboard;
    private IReadOnlyList<BusinessClientManagementRow> systemBusinessClients = [];
    private PoolEquipmentOverview? systemPoolEquipment;
    private IReadOnlyList<PoolConfigurationClientRow> systemPoolConfigurationClients = [];
    private CatalogOverview? systemCatalog;
    private CatalogOverview? businessClientGlobalCatalog;
    private IReadOnlyList<ServicePackage> systemServicePackages = [];
    private IReadOnlyList<ServicePackage> businessOwnerServicePackages = [];
    private IReadOnlyList<ServiceVisit> businessOwnerVisits = [];
    private IReadOnlyList<CompanyUserManagementRow> businessOwnerEmployees = [];
    private IReadOnlyList<CompanyClient> businessOwnerClients = [];
    private Dictionary<string, string> businessOwnerVisitAssignees = new(StringComparer.OrdinalIgnoreCase);
    private ServicePackage? businessClientServicePackage;
    private PoolEquipmentOverview? businessClientPoolEquipment;
    private IReadOnlyList<ServiceVisit> businessClientVisits = [];
    private Dictionary<string, string> businessClientVisitNotes = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<ServiceHistoryItem> businessEmployeeTodayVisits = [];
    private IReadOnlyList<ServiceHistoryItem> businessEmployeeUpcomingVisits = [];
    private IReadOnlyList<ServiceHistoryItem> businessEmployeeCompletedVisits = [];
    private IReadOnlyList<ServiceOffering> businessEmployeeServices = [];
    private string businessEmployeeCompanyId = "";
    private IReadOnlyList<ServiceOffering> businessClientServices = [];
    private CompanyClient? businessClient;
    private PoolEquipmentItem? dashboardEquipmentInfo;
    private ServiceVisit? dashboardVisitInfo;
    private BusinessEmployeeVisitForm? businessEmployeeVisitForm;
    private ServiceBusiness.Web.ApplicationModeSnapshot appMode = ServiceBusiness.Web.ApplicationModeSnapshot.Pool;
    private bool poolEquipmentExpanded = true;
    private bool servicePackageExpanded = true;
    private bool serviceHistoryExpanded = true;
    private bool approvalsExpanded = true;
    private bool businessOwnerVisitsExpanded = true;
    private bool businessClientUpcomingExpanded = true;
    private bool businessClientServicePackageExpanded;
    private bool businessClientPoolConfigurationExpanded;
    private bool businessClientCompletedExpanded;
    private bool businessEmployeeTodayExpanded = true;
    private bool businessEmployeeUpcomingExpanded = true;
    private bool businessEmployeeCompletedExpanded;
    private bool serviceHistoryEditorExpanded;
    private string? message;
    private string? errorMessage;
    private bool IsSystemAdmin => overview?.User.IsSystemAdmin == true;
    private bool IsIndependentHomeOwner => overview is not null && !IsSystemAdmin && overview.Companies.Count == 0;
    private CompanyAccess? BusinessOwnerAccess => overview?.Companies.FirstOrDefault(c => c.Status == MembershipStatus.Active && c.Role == CompanyRole.CompanyAdmin);
    private CompanyAccess? BusinessClientAccess => overview?.Companies.FirstOrDefault(c => c.Status == MembershipStatus.Active && c.Role == CompanyRole.CompanyClientUser);
    private CompanyAccess? BusinessEmployeeAccess => overview?.Companies.FirstOrDefault(c => c.Status == MembershipStatus.Active && c.Role == CompanyRole.CompanyUser);
    private bool IsBusinessOwner => BusinessOwnerAccess is not null;
    private bool IsBusinessClient => BusinessClientAccess is not null;
    private bool IsBusinessEmployee => BusinessEmployeeAccess is not null;
    private IReadOnlyList<CompanyAccess> PendingApprovalAccess => overview?.Companies
        .Where(access => access.Status == MembershipStatus.Pending)
        .ToList() ?? [];
    private bool IsPendingApprovalOnly => overview is not null &&
        !IsSystemAdmin &&
        !IsIndependentHomeOwner &&
        !overview.Companies.Any(access => access.Status == MembershipStatus.Active) &&
        PendingApprovalAccess.Count > 0;
    private IReadOnlyList<ServiceOffering> HomeOwnerServices => homeOwnerCatalog?.ServiceGroups
        .SelectMany(group => group.Services)
        .Where(service => service.IsActive)
        .OrderBy(service => service.Name)
        .ToList() ?? [];
    private IReadOnlyList<Company> FilteredCompanies => companies?.Where(CompanyMatchesMode).OrderBy(company => company.Name).ToList() ?? [];
    private IReadOnlyList<UserManagementRow> FilteredSystemUsers => userOverview?.Users.Where(UserMatchesMode).ToList() ?? [];
    private IReadOnlyList<DashboardApprovalRow> SystemPendingRequests => FilteredSystemUsers
        .SelectMany(row => row.CompanyAccess
            .Where(access => access.Status == MembershipStatus.Pending && CompanyMatchesMode(access.Company))
            .Select(access => new DashboardApprovalRow(row.User, access.Company, access.Role)))
        .OrderBy(row => row.User.DisplayName)
        .ToList();
    private int SystemBusinessClientCount => systemBusinessClients.Count(row => CompanyMatchesMode(row.Company));
    private int SystemPoolEquipmentCount => systemPoolEquipment?.CategoryGroups.SelectMany(group => group.Items).Count(item => item.IsActive) ?? 0;
    private int SystemPoolConfigurationCount => systemPoolConfigurationClients.Count;
    private int SystemMaterialCount => systemCatalog?.MaterialGroups.SelectMany(group => group.Materials).Count(material => material.IsActive) ?? 0;
    private int SystemServiceCount => systemCatalog?.ServiceGroups.SelectMany(group => group.Services).Count(service => service.IsActive) ?? 0;
    private int SystemServicePackageCount => systemServicePackages.Count(package => package.IsActive);
    private int BusinessOwnerServicePackageCount => businessOwnerServicePackages.Count(package => package.IsActive);
    private IReadOnlyList<ServiceVisit> BusinessOwnerPendingVisits => businessOwnerVisits
        .Where(visit => visit.Status is VisitStatus.New or VisitStatus.Unscheduled or VisitStatus.Scheduled)
        .OrderBy(visit => visit.ScheduledDate == default ? DateOnly.MaxValue : visit.ScheduledDate)
        .ThenBy(visit => visit.ServiceWindowStart)
        .ThenBy(visit => visit.VisitName)
        .ToList();
    private IReadOnlyList<ServiceOffering> BusinessClientServices => businessClientServices
        .Where(service => service.IsActive)
        .OrderBy(service => service.Name)
        .ToList();
    private IReadOnlyList<ServiceOffering> BusinessClientAvailableServices => BusinessClientServices
        .Concat(businessClientGlobalCatalog?.ServiceGroups.SelectMany(group => group.Services).Where(service => service.IsActive) ?? [])
        .GroupBy(service => service.Id, StringComparer.OrdinalIgnoreCase)
        .Select(group => group.First())
        .ToList();
    private IReadOnlyList<ServiceOffering> BusinessEmployeeFilteredOutOfScopeServices
    {
        get
        {
            if (businessEmployeeVisitForm is null)
            {
                return [];
            }

            var plannedIds = businessEmployeeVisitForm.Visit.PlannedServiceIds.ToHashSet(StringComparer.OrdinalIgnoreCase);
            var chosenIds = businessEmployeeVisitForm.OutOfScopeServiceIds.ToHashSet(StringComparer.OrdinalIgnoreCase);
            var services = businessEmployeeServices.Where(service => !plannedIds.Contains(service.Id) && !chosenIds.Contains(service.Id));
            if (!string.IsNullOrWhiteSpace(businessEmployeeVisitForm.ServiceFilter))
            {
                services = services.Where(service =>
                    service.Name.Contains(businessEmployeeVisitForm.ServiceFilter, StringComparison.OrdinalIgnoreCase) ||
                    service.Description.Contains(businessEmployeeVisitForm.ServiceFilter, StringComparison.OrdinalIgnoreCase));
            }

            return services.OrderBy(service => service.Name).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        appMode = await ApplicationMode.GetCurrentAsync();
        overview = await OnboardingService.GetAccessOverviewAsync(CurrentUser.UserId);
        if (IsSystemAdmin)
        {
            companyTypes = await PlatformAdminService.GetCompanyTypesAsync();
            companies = await PlatformAdminService.GetCompaniesAsync();
            emailLogs = await PlatformAdminService.GetEmailLogsAsync();
            userOverview = await PlatformAdminService.GetUserManagementOverviewAsync();
            systemBusinessClients = await PlatformAdminService.GetBusinessClientManagementRowsAsync();
            systemPoolEquipment = appMode.IsPoolMode
                ? await CompanyAdminService.GetPoolEquipmentOverviewAsync(EquipmentScope.Global, "global")
                : null;
            systemPoolConfigurationClients = appMode.IsPoolMode
                ? await PlatformAdminService.GetPoolConfigurationClientsAsync()
                : [];
            systemCatalog = await CompanyAdminService.GetCatalogOverviewAsync(appMode.GlobalCatalogCompanyId);
            systemServicePackages = await CompanyAdminService.GetServicePackagesAsync(appMode.GlobalCatalogCompanyId);
        }
        else if (IsIndependentHomeOwner)
        {
            homeOwnerProfile = await OnboardingService.GetIndependentHomeOwnerProfileAsync(CurrentUser.UserId);
            homeOwnerDashboard = await HomeOwnerService.GetDashboardAsync();
            homeOwnerCatalog = await CompanyAdminService.GetCatalogOverviewAsync(CurrentUser.UserId);
        }
        else if (BusinessOwnerAccess is not null)
        {
            await LoadBusinessOwnerDashboardAsync();
        }
        else if (IsBusinessEmployee)
        {
            await LoadBusinessEmployeeDashboardAsync();
        }
        else if (IsBusinessClient)
        {
            await LoadBusinessClientDashboardAsync();
        }
    }

