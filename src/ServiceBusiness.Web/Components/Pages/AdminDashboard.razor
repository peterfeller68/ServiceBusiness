@page "/admin"
@rendermode InteractiveServer
@using ServiceBusiness.Domain
@inject ServiceBusiness.Application.PlatformAdminService PlatformAdminService
@inject ServiceBusiness.Web.DemoCurrentUserContext DemoUser
@inject ServiceBusiness.Web.ApplicationModeService ApplicationMode

<PageTitle>@appMode.ProductName System Admin</PageTitle>

<section class="dashboard-hero" style="background-image: linear-gradient(90deg, rgba(13, 30, 26, .68), rgba(13, 30, 26, .22)), url('@appMode.HeroImageUrl');">
    <div>
        <p class="eyebrow">@appMode.ProductCategory</p>
        <h1>@appMode.ProductName Platform</h1>
    </div>
</section>

<section class="page-header">
    <div>
        <p class="eyebrow">System Administrator</p>
        <h1>Platform dashboard</h1>
        <p class="lede">Review platform summary metrics and open focused management pages.</p>
    </div>
</section>

@if (companyTypes is null || companies is null || emailLogs is null || userOverview is null)
{
    <p>Loading platform data...</p>
}
else
{
    <div class="metric-grid">
        <div class="metric">
            <span>Service Clients</span>
            <strong>@FilteredCompanies.Count</strong>
        </div>
        <div class="metric">
            <span>Users</span>
            <strong>@FilteredUserRows.Count</strong>
        </div>
        <div class="metric">
            <span>System Admins</span>
            <strong>@FilteredUserRows.Count(row => row.User.IsSystemAdmin)</strong>
        </div>
        <div class="metric">
            <span>Pending Access</span>
            <strong>@FilteredUserRows.Sum(row => row.PendingMembershipCount)</strong>
        </div>
        <div class="metric">
            <span>Disabled Users</span>
            <strong>@FilteredUserRows.Count(row => row.User.Status == UserStatus.Disabled)</strong>
        </div>
        <div class="metric">
            <span>Email Logs</span>
            <strong>@emailLogs.Count</strong>
        </div>
    </div>

    <section class="section">
        <h2>Management Pages</h2>
        <div class="quick-link-grid">
            <a class="row-card quick-link" href="admin/service-clients">
                <strong>Service Clients</strong>
                <p>Manage registered business customers for the current service type.</p>
            </a>
            <a class="row-card quick-link" href="admin/clients">
                <strong>Business Clients</strong>
                <p>Manage homeowner and customer records across service clients.</p>
            </a>
            <a class="row-card quick-link" href="admin/users">
                <strong>Users</strong>
                <p>Manage registered users, status, and system-admin access.</p>
            </a>
            <a class="row-card quick-link" href="admin/roles">
                <strong>User Roles</strong>
                <p>Edit built-in role metadata and permissions.</p>
            </a>
            <a class="row-card quick-link" href="admin/catalog/materials">
                <strong>Materials</strong>
                <p>Review material categories and material items.</p>
            </a>
            <a class="row-card quick-link" href="admin/catalog/services">
                <strong>Services</strong>
                <p>Review service categories and service items.</p>
            </a>
            <a class="row-card quick-link" href="admin/email-log">
                <strong>Email Log</strong>
                <p>Review email attempts, reroutes, failures, and suppression.</p>
            </a>
        </div>
    </section>
}

@code {
    private IReadOnlyList<CompanyType>? companyTypes;
    private IReadOnlyList<Company>? companies;
    private IReadOnlyList<EmailLogEntry>? emailLogs;
    private PlatformUserManagementOverview? userOverview;
    private ServiceBusiness.Web.ApplicationModeSnapshot appMode = ServiceBusiness.Web.ApplicationModeSnapshot.Pool;
    private IReadOnlyList<Company> FilteredCompanies => companies?.Where(CompanyMatchesMode).OrderBy(company => company.Name).ToList() ?? [];
    private IReadOnlyList<UserManagementRow> FilteredUserRows => userOverview?.Users.Where(UserMatchesMode).ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        DemoUser.UserId = "sys-admin";
        appMode = await ApplicationMode.GetCurrentAsync();
        companyTypes = await PlatformAdminService.GetCompanyTypesAsync();
        companies = await PlatformAdminService.GetCompaniesAsync();
        emailLogs = await PlatformAdminService.GetEmailLogsAsync();
        userOverview = await PlatformAdminService.GetUserManagementOverviewAsync();
    }

    private bool UserMatchesMode(UserManagementRow row)
    {
        if (row.User.IsSystemAdmin || row.CompanyAccess.Count == 0)
        {
            return true;
        }

        return row.CompanyAccess.Any(access => CompanyMatchesMode(access.Company));
    }

    private bool CompanyMatchesMode(Company company)
    {
        var type = companyTypes?.FirstOrDefault(t => string.Equals(t.Id, company.CompanyTypeId, StringComparison.OrdinalIgnoreCase));
        if (type is null)
        {
            return true;
        }

        var searchable = $"{type.Id} {type.Name} {type.Description}";
        return appMode.IsPoolMode
            ? ContainsAny(searchable, "pool", "clean")
            : ContainsAny(searchable, "landscape", "lawn", "yard", "tree");
    }

    private static bool ContainsAny(string value, params string[] terms) =>
        terms.Any(term => value.Contains(term, StringComparison.OrdinalIgnoreCase));
}
