@page "/admin/companies"
@rendermode InteractiveServer
@using ServiceBusiness.Domain
@inject ServiceBusiness.Application.PlatformAdminService PlatformAdminService
@inject ServiceBusiness.Web.DemoCurrentUserContext DemoUser

<PageTitle>Companies</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">System Administrator</p>
        <h1>Companies</h1>
        <p class="lede">Manage SaaS tenant companies and platform company types.</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice error">@errorMessage</div>
}

@if (companyTypes is null || companies is null)
{
    <p>Loading companies...</p>
}
else
{
    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Company Types</h2>
            <button class="icon-button" type="button" title="Toggle company types" @onclick="ToggleCompanyTypes">@(companyTypesExpanded ? "^" : "v")</button>
        </div>
        @if (companyTypesExpanded)
        {
            <div class="management-panel-body">
                <div class="management-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Active</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th class="actions">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var type in companyTypes)
                            {
                                <tr>
                                    <td>@type.Id</td>
                                    <td>@(type.IsActive ? "Yes" : "No")</td>
                                    <td>@type.Name</td>
                                    <td>@type.Description</td>
                                    <td class="actions"><span class="status-pill">Read Only</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>

    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Companies</h2>
            <div class="management-panel-actions">
                <button class="button primary" type="button" @onclick="ShowCreateCompany">Create</button>
                <button class="icon-button" type="button" title="Toggle companies" @onclick="ToggleCompanies">@(companiesExpanded ? "^" : "v")</button>
            </div>
        </div>
        @if (companiesExpanded)
        {
            <div class="management-panel-body">
                @if (companyEditorExpanded)
                {
                    <EditForm Model="companyForm" OnValidSubmit="SaveCompanyAsync" FormName="company-editor">
                        <div class="editor-panel">
                            <h3>@(companyForm.IsEditing ? "Edit Company" : "Create Company")</h3>
                <div class="form-grid">
                    <label>
                        Company ID
                        <InputText class="form-control" @bind-Value="companyForm.Id" disabled="@companyForm.IsEditing" />
                    </label>
                    <label>
                        Company type
                        <InputSelect class="form-control" @bind-Value="companyForm.CompanyTypeId">
                            @foreach (var type in companyTypes.Where(t => t.IsActive))
                            {
                                <option value="@type.Id">@type.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        Name
                        <InputText class="form-control" @bind-Value="companyForm.Name" />
                    </label>
                    <label>
                        Business email
                        <InputText class="form-control" @bind-Value="companyForm.BusinessEmail" />
                    </label>
                    <label>
                        Business phone
                        <InputText class="form-control" @bind-Value="companyForm.BusinessPhone" />
                    </label>
                    <label>
                        Time zone
                        <InputText class="form-control" @bind-Value="companyForm.TimeZone" />
                    </label>
                    <label>
                        Status
                        <InputSelect class="form-control" @bind-Value="companyForm.Status">
                            @foreach (var status in Enum.GetValues<CompanyStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </InputSelect>
                    </label>
                </div>
                <div class="form-actions">
                    <button class="button primary" type="submit">Save Company</button>
                                    <button class="button" type="button" @onclick="HideCompanyEditor">Cancel</button>
                </div>
                        </div>
                    </EditForm>
                }
                <div class="management-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Status</th>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th class="actions">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var company in companies)
                            {
                                <tr>
                                    <td>@company.Id</td>
                                    <td>@company.Status</td>
                                    <td>@company.Name</td>
                                    <td>@company.CompanyTypeId</td>
                                    <td>@company.BusinessEmail</td>
                                    <td>@company.BusinessPhone</td>
                                    <td class="actions">
                                        <button class="icon-button" type="button" title="Edit company" @onclick="() => EditCompany(company)">Edit</button>
                            @if (company.Status == CompanyStatus.Active)
                            {
                                            <button class="icon-button" type="button" title="Suspend company" @onclick="() => SetCompanyStatusAsync(company, CompanyStatus.Suspended)">Sus</button>
                                            <button class="icon-button danger" type="button" title="Archive company" @onclick="() => SetCompanyStatusAsync(company, CompanyStatus.Inactive)">Del</button>
                            }
                            else
                            {
                                            <button class="icon-button" type="button" title="Reactivate company" @onclick="() => SetCompanyStatusAsync(company, CompanyStatus.Active)">On</button>
                            }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
}

@code {
    private IReadOnlyList<CompanyType>? companyTypes;
    private IReadOnlyList<Company>? companies;
    private CompanyForm companyForm = new();
    private bool companyTypesExpanded = true;
    private bool companiesExpanded = true;
    private bool companyEditorExpanded;
    private string? message;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        DemoUser.UserId = "sys-admin";
        await LoadAsync();
        ResetCompanyForm();
    }

    private async Task SaveCompanyAsync()
    {
        await RunAsync(async () =>
        {
            await PlatformAdminService.UpsertCompanyAsync(new Company(
                companyForm.Id,
                companyForm.CompanyTypeId,
                companyForm.Name,
                companyForm.BusinessEmail,
                companyForm.BusinessPhone,
                companyForm.TimeZone,
                companyForm.Status));
            message = $"{companyForm.Name} was saved.";
        });
    }

    private async Task SetCompanyStatusAsync(Company company, CompanyStatus status)
    {
        await RunAsync(async () =>
        {
            await PlatformAdminService.SetCompanyStatusAsync(company.Id, status);
            message = $"{company.Name} is now {status.ToString().ToLowerInvariant()}.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        message = null;
        errorMessage = null;

        try
        {
            await action();
            await LoadAsync();
            ResetCompanyForm();
            companyEditorExpanded = false;
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadAsync()
    {
        companyTypes = await PlatformAdminService.GetCompanyTypesAsync();
        companies = await PlatformAdminService.GetCompaniesAsync();
    }

    private void EditCompany(Company company)
    {
        companyForm = CompanyForm.FromCompany(company);
        companyEditorExpanded = true;
        companiesExpanded = true;
    }

    private void ResetCompanyForm()
    {
        companyForm = new CompanyForm
        {
            CompanyTypeId = companyTypes?.FirstOrDefault(t => t.IsActive)?.Id ?? "",
            TimeZone = "America/Los_Angeles"
        };
    }

    private void ShowCreateCompany()
    {
        ResetCompanyForm();
        companyEditorExpanded = true;
        companiesExpanded = true;
    }

    private void HideCompanyEditor()
    {
        ResetCompanyForm();
        companyEditorExpanded = false;
    }

    private void ToggleCompanyTypes() => companyTypesExpanded = !companyTypesExpanded;

    private void ToggleCompanies() => companiesExpanded = !companiesExpanded;

    private sealed class CompanyForm
    {
        public string Id { get; set; } = "";
        public string CompanyTypeId { get; set; } = "";
        public string Name { get; set; } = "";
        public string BusinessEmail { get; set; } = "";
        public string BusinessPhone { get; set; } = "";
        public string TimeZone { get; set; } = "America/Los_Angeles";
        public CompanyStatus Status { get; set; } = CompanyStatus.Active;
        public bool IsEditing { get; set; }

        public static CompanyForm FromCompany(Company company) => new()
        {
            Id = company.Id,
            CompanyTypeId = company.CompanyTypeId,
            Name = company.Name,
            BusinessEmail = company.BusinessEmail,
            BusinessPhone = company.BusinessPhone,
            TimeZone = company.TimeZone,
            Status = company.Status,
            IsEditing = true
        };
    }
}
