@page "/admin/companies"
@page "/admin/service-clients"
@rendermode InteractiveServer
@using ServiceBusiness.Domain
@inject ServiceBusiness.Application.PlatformAdminService PlatformAdminService
@inject ServiceBusiness.Application.CompanyAdminService CompanyAdminService
@inject ServiceBusiness.Web.DemoCurrentUserContext DemoUser
@inject ServiceBusiness.Web.ApplicationModeService ApplicationMode

<PageTitle>Service Clients</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">System Administrator</p>
        <h1>Service Clients</h1>
        <p class="lede">Manage registered service clients for the current service type.</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice error">@errorMessage</div>
}

@if (companyTypes is null || companies is null)
{
    <p>Loading service clients...</p>
}
else
{
    <section class="management-panel">
        <div class="management-panel-header">
            <h2>Service Clients</h2>
            <div class="management-panel-actions">
                <button class="icon-button" type="button" title="Toggle service clients" @onclick="ToggleCompanies">@(companiesExpanded ? "^" : "v")</button>
            </div>
        </div>
        @if (companiesExpanded)
        {
            <div class="management-panel-body">
                @if (companyEditorExpanded)
                {
                    <EditForm Model="companyForm" OnValidSubmit="SaveCompanyAsync" FormName="company-editor">
                        <div class="editor-panel">
                            <h3>Edit Service Client</h3>
                <div class="form-grid">
                    <label>
                        Service client type
                        <InputSelect class="form-control" @bind-Value="companyForm.CompanyTypeId">
                            @foreach (var type in AvailableCompanyTypes)
                            {
                                <option value="@type.Id">@type.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        Name
                        <InputText class="form-control" @bind-Value="companyForm.Name" />
                    </label>
                    <label>
                        Business email
                        <InputText class="form-control" @bind-Value="companyForm.BusinessEmail" />
                    </label>
                    <label>
                        Business phone
                        <InputText class="form-control" @bind-Value="companyForm.BusinessPhone" />
                    </label>
                    <label>
                        Service package
                        <InputSelect class="form-control" @bind-Value="companyForm.ServicePackageId">
                            <option value="">No package assigned</option>
                            @foreach (var servicePackage in AvailableServicePackages)
                            {
                                <option value="@servicePackage.Id">@servicePackage.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        Time zone
                        <InputText class="form-control" @bind-Value="companyForm.TimeZone" />
                    </label>
                    <label class="switch-control" title="Toggle active state">
                        <input type="checkbox" checked="@(companyForm.Status == CompanyStatus.Active)" @onchange="args => companyForm.Status = GetChecked(args) ? CompanyStatus.Active : CompanyStatus.Inactive" />
                        <span></span>
                        <small>Active</small>
                    </label>
                </div>
                <div class="form-actions">
                    <button class="button primary" type="submit">Save Service Client</button>
                                    <button class="button" type="button" @onclick="HideCompanyEditor">Cancel</button>
                </div>
                        </div>
                    </EditForm>
                }
                <div class="management-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Service Package</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th class="actions">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var company in FilteredCompanies)
                            {
                                <tr>
                                    <td>
                                        <label class="switch-control" title="Toggle active state">
                                            <input type="checkbox" checked="@(company.Status == CompanyStatus.Active)" @onchange="args => SetCompanyStatusAsync(company, GetChecked(args) ? CompanyStatus.Active : CompanyStatus.Inactive)" />
                                            <span></span>
                                        </label>
                                    </td>
                                    <td>@company.Name</td>
                                    <td>@GetCompanyTypeName(company.CompanyTypeId)</td>
                                    <td>@GetServicePackageName(company.ServicePackageId)</td>
                                    <td>@company.BusinessEmail</td>
                                    <td>@company.BusinessPhone</td>
                                    <td class="actions">
                                        <button class="icon-button icon-only" type="button" title="Edit service client" aria-label="Edit service client" @onclick="() => EditCompany(company)">
                                            <span class="action-icon edit-icon" aria-hidden="true"></span>
                                        </button>
                                        <button class="icon-button icon-only danger" type="button" title="Delete service client" aria-label="Delete service client" @onclick="() => SetCompanyStatusAsync(company, CompanyStatus.Inactive)">
                                            <span class="action-icon delete-icon" aria-hidden="true"></span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
}

@code {
    private IReadOnlyList<CompanyType>? companyTypes;
    private IReadOnlyList<Company>? companies;
    private IReadOnlyList<ServicePackage> servicePackages = [];
    private CompanyForm companyForm = new();
    private bool companiesExpanded = true;
    private bool companyEditorExpanded;
    private string? message;
    private string? errorMessage;
    private ServiceBusiness.Web.ApplicationModeSnapshot appMode = ServiceBusiness.Web.ApplicationModeSnapshot.Pool;
    private IReadOnlyList<CompanyType> AvailableCompanyTypes => companyTypes?.Where(t => t.IsActive && TypeMatchesMode(t)).OrderBy(t => t.Name).ToList() ?? [];
    private IReadOnlyList<Company> FilteredCompanies => companies?.Where(CompanyMatchesMode).OrderBy(company => company.Name).ToList() ?? [];
    private IReadOnlyList<ServicePackage> AvailableServicePackages => servicePackages
        .Where(servicePackage => servicePackage.IsActive)
        .OrderBy(servicePackage => servicePackage.Name)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        DemoUser.UserId = "sys-admin";
        appMode = await ApplicationMode.GetCurrentAsync();
        await LoadAsync();
        ResetCompanyForm();
    }

    private async Task SaveCompanyAsync()
    {
        await RunAsync(async () =>
        {
            await PlatformAdminService.UpsertCompanyAsync(new Company(
                companyForm.Id,
                companyForm.CompanyTypeId,
                companyForm.Name,
                companyForm.BusinessEmail,
                companyForm.BusinessPhone,
                companyForm.TimeZone,
                companyForm.Status,
                companyForm.ServicePackageId));
            message = $"{companyForm.Name} was saved.";
        });
    }

    private async Task SetCompanyStatusAsync(Company company, CompanyStatus status)
    {
        await RunAsync(async () =>
        {
            await PlatformAdminService.SetCompanyStatusAsync(company.Id, status);
            message = $"{company.Name} is now {status.ToString().ToLowerInvariant()}.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        message = null;
        errorMessage = null;

        try
        {
            await action();
            await LoadAsync();
            ResetCompanyForm();
            companyEditorExpanded = false;
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadAsync()
    {
        companyTypes = await PlatformAdminService.GetCompanyTypesAsync();
        companies = await PlatformAdminService.GetCompaniesAsync();
        servicePackages = await CompanyAdminService.GetServicePackagesAsync(appMode.GlobalCatalogCompanyId);
    }

    private void EditCompany(Company company)
    {
        companyForm = CompanyForm.FromCompany(company);
        companyEditorExpanded = true;
        companiesExpanded = true;
    }

    private void ResetCompanyForm()
    {
        companyForm = new CompanyForm
        {
            CompanyTypeId = AvailableCompanyTypes.FirstOrDefault()?.Id ?? "",
            TimeZone = "America/Los_Angeles"
        };
    }

    private void HideCompanyEditor()
    {
        ResetCompanyForm();
        companyEditorExpanded = false;
    }

    private void ToggleCompanies() => companiesExpanded = !companiesExpanded;

    private static bool GetChecked(ChangeEventArgs args) => args.Value is bool value && value;

    private string GetCompanyTypeName(string companyTypeId) =>
        companyTypes?.FirstOrDefault(type => string.Equals(type.Id, companyTypeId, StringComparison.OrdinalIgnoreCase))?.Name
        ?? companyTypeId;

    private string GetServicePackageName(string? servicePackageId) =>
        string.IsNullOrWhiteSpace(servicePackageId)
            ? "-"
            : servicePackages.FirstOrDefault(package => string.Equals(package.Id, servicePackageId, StringComparison.OrdinalIgnoreCase))?.Name
                ?? servicePackageId;

    private bool CompanyMatchesMode(Company company) =>
        TypeMatchesMode(companyTypes?.FirstOrDefault(type => string.Equals(type.Id, company.CompanyTypeId, StringComparison.OrdinalIgnoreCase)));

    private bool TypeMatchesMode(CompanyType? type)
    {
        if (type is null)
        {
            return false;
        }

        var searchable = $"{type.Id} {type.Name} {type.Description}";
        return appMode.IsPoolMode
            ? searchable.Contains("pool", StringComparison.OrdinalIgnoreCase)
            : ContainsAny(searchable, "landscape", "lawn", "yard", "tree");
    }

    private static bool ContainsAny(string value, params string[] terms) =>
        terms.Any(term => value.Contains(term, StringComparison.OrdinalIgnoreCase));

    private sealed class CompanyForm
    {
        public string Id { get; set; } = "";
        public string CompanyTypeId { get; set; } = "";
        public string Name { get; set; } = "";
        public string BusinessEmail { get; set; } = "";
        public string BusinessPhone { get; set; } = "";
        public string? ServicePackageId { get; set; }
        public string TimeZone { get; set; } = "America/Los_Angeles";
        public CompanyStatus Status { get; set; } = CompanyStatus.Active;
        public bool IsEditing { get; set; }

        public static CompanyForm FromCompany(Company company) => new()
        {
            Id = company.Id,
            CompanyTypeId = company.CompanyTypeId,
            Name = company.Name,
            BusinessEmail = company.BusinessEmail,
            BusinessPhone = company.BusinessPhone,
            ServicePackageId = company.ServicePackageId,
            TimeZone = company.TimeZone,
            Status = company.Status,
            IsEditing = true
        };
    }
}
